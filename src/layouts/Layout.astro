---
import "../styles/global.css";
import GridBackGround from "../components/layout/GridBackGround.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { ClientRouter } from "astro:transitions";

const mainFade = {
	forwards: {
		old: {
			name: "astroFadeOut",
			duration: "300ms",
			easing: "cubic-bezier(0.16, 1, 0.3, 1)",
			fillMode: "both",
		},
		new: {
			name: "astroFadeIn",
			duration: "900ms",
			delay: "600ms",
			easing: "cubic-bezier(0.16, 1, 0.3, 1)",
			fillMode: "both",
		},
	},
	backwards: {
		old: {
			name: "astroFadeOut",
			duration: "300ms",
			easing: "cubic-bezier(0.16, 1, 0.3, 1)",
			fillMode: "both",
		},
		new: {
			name: "astroFadeIn",
			duration: "900ms",
			delay: "600ms",
			easing: "cubic-bezier(0.16, 1, 0.3, 1)",
			fillMode: "both",
		},
	},
};

const pageTransitionName = `page-content-${Astro.url.pathname
	.replace(/\/+$/, "")
	.replace(/^\//, "")
	.replaceAll("/", "-") || "home"}`;
---


<!doctype html>
<html lang="en" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href="https://takanari-kondo.com/">
		<meta name="generator" content={Astro.generator} />
		<title>Takanari Kondo | Frontend Developer & UI/UX Designer</title>
		<meta name= "description" content="Portfolio of Takanari Kondo, a frontend developer and UI/UX designer focused on building fast, accessible, and visually refined web experiences." />
		<meta name="author" content="Takanari Kondo" />


		<!-- Open Graph / Social -->
		<meta property="og:title" content="Takanari Kondo | Frontend Developer & UI/UX Designer" />
		<meta property="og:description" content="Explore projects, web development work and UI/UX case studies by Takanari Kondo." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://takanari-kondo.com/" />
		<!-- 画像未設定 -->
		<meta property="og:image" content="/og-image.png" />
		<script is:inline>
			(() => {
				if (window.__astroTransitionAbortGuardReady) return;

				window.addEventListener("unhandledrejection", (event) => {
					const reason = event.reason;
					const isAbortedViewTransition =
						reason instanceof DOMException &&
						reason.name === "InvalidStateError" &&
						reason.message.includes("Transition was aborted");

					if (isAbortedViewTransition) {
						event.preventDefault();
					}
				});

				window.__astroTransitionAbortGuardReady = true;
			})();
		</script>
	</head>
	<body class="min-h-dvh">
		<ClientRouter />
		<GridBackGround transition:persist />
		<SiteHeader transition:persist />
		<div transition:name={pageTransitionName} transition:animate={mainFade}>
			<slot />
		</div>
		<SiteFooter transition:persist />
	</body>
</html>

