---
import type { ImageMetadata } from "astro";
import Arrow from "../../assets/images/icons/card-arrow.svg";
import GlassPill from "./GlassPill.astro"

type Props = {
    href: string
    cover: ImageMetadata
    title: string
    description: string
    tag: string
}

const {href, cover, title, description, tag } = Astro.props as Props
---
<a href={href} class="grid grid-rows-subgrid row-span-4 h-full">
    
    <article class="grid grid-rows-subgrid row-span-4 gap-0 h-full bg-card-gradient backdrop-blur-lg rounded-lg border border-white/20 shadow-lg ">
            <figure class="relative ">
                <img src={cover.src}
                alt={title}
                width={cover.width}
                height={cover.height}
                class='rounded-t-lg w-full '/>
                <div class='absolute top-4 left-4'>
                <GlassPill class="text-white"
                >{tag}</GlassPill>
                </div>
            </figure>
            <h3 class='text-heading-default text-2xl p-4 '>{title}</h3>
            <p class='text-body-default font-g-sans px-4 '>{description}</p>
            <div class="flex justify-end px-6 pb-6 self-end">
                <Arrow class="text-foreground w-12 " />
            </div>
     </article>
</a>
