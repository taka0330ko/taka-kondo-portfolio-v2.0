---
import type { ImageMetadata } from "astro";
import Arrow from "../../assets/images/icons/card-arrow.svg";
import GlassPill from "./GlassPill.astro"

type Props = {
    href: string
    cover: ImageMetadata
    title: string
    description: string
    tag: string
}

const {href, cover, title, description, tag } = Astro.props as Props
---
<a href={href}>
    
    <article class="grid grid-rows-subgrid row-span-3 bg-card-gradient backdrop-blur-lg rounded-lg border border-white/20 shadow-lg">
            <figure class="relative row-start-1">
                <img src={cover.src}
                alt={title}
                width={cover.width}
                height={cover.height}
                class='rounded-t-lg w-full '/>
                <div class='absolute top-4 left-4'>
                <GlassPill class="text-white"
                >{tag}</GlassPill>
                </div>
            </figure>
            <div class="flex flex-col gap-3 p-6 row-start-2">
                <h3 class='text-heading-default text-2xl'>{title}</h3>
                <p class='text-body-default font-g-sans'>{description}</p>
                    <div class="flex justify-end">
                        <Arrow class="text-foreground w-12 " />
                    </div>
            </div>
     </article>
</a>
