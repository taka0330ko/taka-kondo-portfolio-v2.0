---
import type { ImageMetadata } from "astro";
import Arrow from "../../assets/images/icons/card-arrow.svg";
import GlassPill from "./GlassPill.astro"
import { Image } from "astro:assets";

type Props = {
    href: string
    cover: ImageMetadata
    title: string
    description: string
    tag: string
}

const {href, cover, title, description, tag } = Astro.props as Props
---
<a href={href} class="grid grid-rows-subgrid row-span-4 h-full group">
    
    <article class="grid grid-rows-subgrid row-span-4 gap-0 h-full bg-card-gradient backdrop-blur-lg 
                    rounded-lg border border-white/20 shadow-lg mouse-track-card content transition duration-300 group-hover:scale-101">
        <div class="glow-effect"></div>
            <figure class="relative ">
                <Image src={cover}
                alt={title}
                width={cover.width}
                height={cover.height}
                class='rounded-t-lg w-full '/>
                <div class='absolute top-4 left-4'>
                <GlassPill class="text-white"
                >{tag}</GlassPill>
                </div>
            </figure>
            <h3 class='p-4'>{title}</h3>
            <p class='px-4'>{description}</p>
            <div class="flex justify-end px-6 pb-6 transition-all duration-300 self-end opacity-0 group-hover:translate-x-1 group-hover:opacity-100">
                <Arrow class="text-foreground w-16" />
            </div>
     </article>
</a>

<style>
  .mouse-track-card {
    position: relative;
    overflow: hidden;
  }

  .glow-effect {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle 250px at var(--x, 0px) var(--y, 0px),
      var(--accent-bg-lines),
      transparent 80%
    );
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .mouse-track-card:hover .glow-effect {
    opacity: 1;
  }

  .content { position: relative; z-index: 10; }
</style>

<script>
    function trackingHover(){
  const cards = document.querySelectorAll<HTMLElement>('.mouse-track-card');
  
  cards.forEach((card) => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      // Update CSS Variables
      card.style.setProperty('--x', `${x}px`);
      card.style.setProperty('--y', `${y}px`);
    });
  });}
document.addEventListener("astro:page-load", trackingHover);
trackingHover();

</script>
