---
import Calligraphy from "../../assets/images/about/calligraphy.jpg";
import FanLandscapeInkPainting from "../../assets/images/about/fan-landscape-ink-painting.jpg";
import PaintingLake from "../../assets/images/about/painting-lake.jpg";
import PaintingMarket from "../../assets/images/about/painting-market.jpg";
import PaintingToronto from "../../assets/images/about/painting-toronto.jpg";
import Bike from "../../assets/images/about/bike-drawing.png";
import { Image } from "astro:assets";

const galleryItems = [
  {
    src: PaintingToronto,
    alt: "Toronto cityscape painting",
    className: "gallery-card-tall",
    id: "painting-toronto"
  },
  {
    src: Calligraphy,
    alt: "Calligraphy artwork",
    className: "gallery-card-top-small",
    id: "calligraphy"
  },
  {
    src: PaintingLake,
    alt: "Lake painting",
    className: "gallery-card-middle-small",
    id: "painting-lake"
  },
  {
    src: FanLandscapeInkPainting,
    alt: "Fan landscape ink painting",
    className: "gallery-card-left-bottom",
    id: "fan-painting"
  },
  {
    src: PaintingMarket,
    alt: "Market painting",
    className: "gallery-card-right-bottom",
    id:"market"
  },
  {
    src: Bike,
    alt: "A motorcycle drawn with a mechanical pencil",
    className: "gallery-card-bottom-tall",
    id: "bike"
  },
];
---
<section class="gallery-wrap max-w-150">
  <div 
       class="gallery-viewport  overflow-hidden h-100" 
       data-gallery-viewport>
    <div 
         class="gallery-track flex flex-col gap-4 will-change-transform" 
         data-gallery-track>
      <div 
          class="gallery-grid" 
          data-gallery-set>
        {galleryItems.map((item) => (
          <div
            class={`gallery-card ${item.className}`}
            data-gallery-item={item.id}
          >
            <Image src={item.src} alt={item.alt} />
          </div>
        ))}
      </div>

      <div class="gallery-grid gallery-grid-clone" aria-hidden="true">
        {galleryItems.map((item) => (
          <div
            class={`gallery-card ${item.className}`}
            data-gallery-item={item.id}
          >
            <Image src={item.src} alt="" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: 15rem 7.5rem 7.5rem 7.5rem;
    gap: 1rem;
    flex: 0 0 auto;
  }

  .gallery-card {
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .gallery-card-tall {
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .gallery-card-top-small {
    grid-column: 2;
    grid-row: 1;
  }

  .gallery-card-middle-small {
    grid-column: 2;
    grid-row: 2;
  }

  .gallery-card-left-bottom {
    grid-column: 1;
    grid-row: 3;
  }

  .gallery-card-right-bottom {
    grid-column: 1;
    grid-row: 4;
  }

  .gallery-card-bottom-tall {
    grid-column: 2;
    grid-row: 3 / span 2;
  }

  .gallery-card :global(img),
  .gallery-card picture {
    display: block;
    width: 100%;
    height: 100%;
    &:hover{
      opacity: 0.5;
    }
  }

  .gallery-card :global(img) {
    object-fit: cover;
  }

  .gallery-viewport {
    touch-action: none;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      black 20%,
      black 80%,
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 20%,
      black 80%,
      transparent
    );
  }
</style>

<script>

function scrollGallery(){
  const viewport = document.querySelector<HTMLElement>("[data-gallery-viewport]");
  const track = document.querySelector<HTMLElement>("[data-gallery-track]");
  const firstSet = document.querySelector<HTMLElement>("[data-gallery-set]");
  
  if (viewport && track && firstSet) {
    if (viewport.dataset.galleryInitialized === "true") return;
    viewport.dataset.galleryInitialized = "true";

    let currentY = 0;
    let targetY = 0;
    let setHeight = 0;
    let gap = 12;
    let rafId = 0;
    let lastTouchY = 0;
    let isTouching = false;
  
    const normalize = (value: number, size: number): number => {
      if (size <= 0) return 0;
      return ((value % size) + size) % size;
    };
  
    const measure = () => {
      const styles = window.getComputedStyle(track);
      gap = parseFloat(styles.rowGap || styles.gap || "0") || 0;
      setHeight = firstSet.offsetHeight + gap;
    };
  
    const render = () => {
      if (!setHeight) return;
  
      currentY += (targetY - currentY) * 0.08;
  
      const loopedY = normalize(currentY, setHeight);
      track.style.transform = `translate3d(0, ${-loopedY}px, 0)`;
      rafId = window.requestAnimationFrame(render);
    };
  
    const start = () => {
      if (rafId) window.cancelAnimationFrame(rafId);
      measure();
      render();
    };
  
    start();
  
    viewport.addEventListener("wheel", (event) => {
      event.preventDefault();
      targetY += event.deltaY;
    }, { passive: false });

    viewport.addEventListener("touchstart", (event) => {
      if (event.touches.length !== 1) return;
      isTouching = true;
      lastTouchY = event.touches[0].clientY;
    }, { passive: true });

    viewport.addEventListener("touchmove", (event) => {
      if (!isTouching || event.touches.length !== 1) return;
      const touchY = event.touches[0].clientY;
      const deltaY = lastTouchY - touchY;

      lastTouchY = touchY;
      targetY += deltaY;
      event.preventDefault();
    }, { passive: false });

    const endTouch = () => {
      isTouching = false;
    };

    viewport.addEventListener("touchend", endTouch);
    viewport.addEventListener("touchcancel", endTouch);
  
    window.addEventListener("resize", measure);
  }
}

function modalOpen() {
  const track = document.querySelector<HTMLElement>("[data-gallery-track]");
  const shell = document.querySelector<HTMLElement>("[data-gallery-shell]");
  const modal = shell?.querySelector<HTMLElement>("[data-gallery-modal]");
  const modalImage = shell?.querySelector<HTMLImageElement>("[data-gallery-modal-image]");
  const closeButton = shell?.querySelector<HTMLElement>("[data-gallery-modal-close]");

  if (!track || track.dataset.modalInitialized === "true") return;

  track.dataset.modalInitialized = "true";

  const openModal = (image: HTMLImageElement, fallbackAlt: string) => {
    if (!modal || !modalImage) return;

    modalImage.src = image.currentSrc || image.src;
    modalImage.alt = image.alt || fallbackAlt;
    modal.hidden = false;

    window.requestAnimationFrame(() => {
      modal.classList.add("is-visible");
    });
  };

  const closeModal = () => {
    if (!modal || !modalImage) return;

    modal.classList.remove("is-visible");

    window.setTimeout(() => {
      modal.hidden = true;
      modalImage.removeAttribute("src");
      modalImage.alt = "";
    }, 220);
  };

  track.addEventListener("click", (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>("[data-gallery-item]");
    const image = card?.querySelector<HTMLImageElement>("img");
    if (!card || !image || !modal || !modalImage) return;

    openModal(image, card.dataset.galleryItem || "");
  });

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  closeButton?.addEventListener("click", () => {
    closeModal();
  });
}

    document.addEventListener("astro:page-load",()=> {scrollGallery() , modalOpen()});
    scrollGallery();
    modalOpen();
</script>
