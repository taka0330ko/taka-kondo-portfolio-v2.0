---
import Calligraphy from "../../assets/images/about/calligraphy.jpg";
import FanLandscapeInkPainting from "../../assets/images/about/fan-landscape-ink-painting.jpg";
import PaintingLake from "../../assets/images/about/painting-lake.jpg";
import PaintingMarket from "../../assets/images/about/painting-market.jpg";
import PaintingToronto from "../../assets/images/about/painting-toronto.jpg";
import Bike from "../../assets/images/about/bike-drawing.png";
import { Image } from "astro:assets";

const galleryItems = [
  {
    src: PaintingToronto,
    alt: "Toronto cityscape painting",
    className: "gallery-card-tall",
  },
  {
    src: Calligraphy,
    alt: "Calligraphy artwork",
    className: "gallery-card-top-small",
  },
  {
    src: PaintingLake,
    alt: "Lake painting",
    className: "gallery-card-middle-small",
  },
  {
    src: FanLandscapeInkPainting,
    alt: "Fan landscape ink painting",
    className: "gallery-card-left-bottom",
  },
  {
    src: PaintingMarket,
    alt: "Market painting",
    className: "gallery-card-right-bottom",
  },
  {
    src: Bike,
    alt: "A motorcycle drawn with a mechanical pencil",
    className: "gallery-card-bottom-tall",
  },
];
---

<section class="gallery-wrap max-w-150">
  <div 
       class="gallery-viewport overflow-hidden h-100" 
       data-gallery-viewport>
    <div 
         class="gallery-track flex flex-col gap-4 will-change-transform" 
         data-gallery-track>
      <div 
          class="gallery-grid" 
          data-gallery-set>
        {galleryItems.map((item) => (
          <div class={`gallery-card ${item.className}`}>
            <Image src={item.src} alt={item.alt} />
          </div>
        ))}
      </div>

      <div class="gallery-grid gallery-grid-clone" aria-hidden="true">
        {galleryItems.map((item) => (
          <div class={`gallery-card ${item.className}`}>
            <Image src={item.src} alt="" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: 15rem 7.5rem 7.5rem 7.5rem;
    gap: 1rem;
    flex: 0 0 auto;
  }

  .gallery-card {
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .gallery-card-tall {
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .gallery-card-top-small {
    grid-column: 2;
    grid-row: 1;
  }

  .gallery-card-middle-small {
    grid-column: 2;
    grid-row: 2;
  }

  .gallery-card-left-bottom {
    grid-column: 1;
    grid-row: 3;
  }

  .gallery-card-right-bottom {
    grid-column: 1;
    grid-row: 4;
  }

  .gallery-card-bottom-tall {
    grid-column: 2;
    grid-row: 3 / span 2;
  }

  .gallery-card :global(img),
  .gallery-card picture {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .gallery-card :global(img) {
    object-fit: cover;
  }

  .gallery-viewport {
  -webkit-mask-image: linear-gradient(
    to bottom,
    transparent,
    black 20%,
    black 80%,
    transparent
  );
  mask-image: linear-gradient(
    to bottom,
    transparent,
    black 20%,
    black 80%,
    transparent
  );
}
</style>

<script>

function scrollGallery(){

  
  const viewport = document.querySelector<HTMLElement>("[data-gallery-viewport]");
  const track = document.querySelector<HTMLElement>("[data-gallery-track]");
  const firstSet = document.querySelector<HTMLElement>("[data-gallery-set]");
  
  if (viewport && track && firstSet) {
    let currentY = 0;
    let targetY = 0;
    let setHeight = 0;
    let gap = 12;
    let rafId = 0;
  
    const normalize = (value: number, size: number): number => {
      if (size <= 0) return 0;
      return ((value % size) + size) % size;
    };
  
    const measure = () => {
      const styles = window.getComputedStyle(track);
      gap = parseFloat(styles.rowGap || styles.gap || "0") || 0;
      setHeight = firstSet.offsetHeight + gap;
    };
  
    const render = () => {
      if (!setHeight) return;
  
      currentY += (targetY - currentY) * 0.08;
  
      const loopedY = normalize(currentY, setHeight);
      track.style.transform = `translate3d(0, ${-loopedY}px, 0)`;
      rafId = window.requestAnimationFrame(render);
    };
  
    const start = () => {
      if (rafId) window.cancelAnimationFrame(rafId);
      measure();
      render();
    };
  
    start();
  
    viewport.addEventListener("wheel", (event) => {
      event.preventDefault();
      targetY += event.deltaY;
    }, { passive: false });
  
    window.addEventListener("resize", measure);
  }
}

    document.addEventListener("astro:page-load", scrollGallery);
    scrollGallery();

</script>
