---
import DarkIcon from "../../assets/images/icons/dark.svg";
import LightIcon from "../../assets/images/icons/light.svg";
---

<div class="stage is-syncing" data-theme-toggle>
    <input
        class="switch-input sr-only"
        id="theme-switch"
        type="checkbox"
        aria-label="Toggle color theme"
    />
    <label class="switch" for="theme-switch">
        <span class="track" aria-hidden="true">
            <span class="icon icon-dark"><DarkIcon /></span>
            <span class="icon icon-light"><LightIcon /></span>
            <span class="knob"></span>
        </span>
    </label>
</div>



<script is:inline>
    function initThemeToggle() {
        const input = document.getElementById("theme-switch");
        const stage = input?.closest("[data-theme-toggle]");

        if (!input) return;
        function releaseSyncing() {
            if (!stage) return;

            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    stage.classList.remove("is-syncing");
                });
            });
        }

        function applyTheme(theme, options = {}) {
            const shouldSync = options.sync === true;
            const isLight = theme === "light";

            if (shouldSync) {
                stage?.classList.add("is-syncing");
            }

            document.documentElement.classList.toggle("light", isLight);
            localStorage.setItem("theme", theme);
            input.checked = isLight;

            if (shouldSync) {
                releaseSyncing();
            }
        }

        const savedTheme = localStorage.getItem("theme");
        const initialTheme = savedTheme === "dark" ? "dark" : "light";
        applyTheme(initialTheme, { sync: true });

        if (input.dataset.bound === "true") return;

        input.addEventListener("change", () => {
            const nextTheme = input.checked ? "light" : "dark";
            applyTheme(nextTheme);
        });
        input.dataset.bound = "true";
    }

    if (!window.__themeToggleReady) {
        document.addEventListener("astro:page-load", initThemeToggle);
        window.__themeToggleReady = true;
    }

    initThemeToggle();
</script>

<style>
    /* Theme switch */
    .stage {
        --theme-toggle-track: color-mix(in oklab, var(--color-acc) 80%, var(--color-acc));
        --theme-toggle-track-active: color-mix(in oklab, var(--brand-white) 88%, var(--brand-blue-100));
        --theme-toggle-border: color-mix(in oklab, var(--brand-white) 18%, transparent);
        --theme-toggle-knob: var(--brand-gray-50);
        --theme-toggle-knob-border: color-mix(in oklab, var(--brand-black) 8%, transparent);
        --theme-toggle-shadow: 0 0.5rem 1.25rem color-mix(in oklab, var(--brand-black) 22%, transparent);
        display: inline-flex;
    }

    .stage.is-syncing .track,
    .stage.is-syncing .knob,
    .stage.is-syncing .icon {
        transition: none;
    }

    .switch {
        display: inline-flex;
        cursor: pointer;
        border-radius: 9999px;
    }

    .track {
        position: relative;
        display: block;
        width: 4rem;
        height: 2rem;
        padding: 0.2rem;
        overflow: hidden;
        border: 1px solid var(--theme-toggle-border);
        border-radius: 9999px;
        background: var(--theme-toggle-track);
        box-shadow: inset 0 0.125rem 0.5rem color-mix(in oklab, var(--brand-black) 22%, transparent);
        transition:
            background-color 800ms var(--spring-default),
            border-color 800ms var(--spring-default),
            box-shadow 800ms var(--spring-default);
    }

    .knob {
        position: relative;
        z-index: 1;
        display: block;
        width: 1.5rem;
        height: 1.5rem;
        border: 1px solid var(--theme-toggle-knob-border);
        border-radius: 9999px;
        background: var(--theme-toggle-knob);
        box-shadow: var(--theme-toggle-shadow);
        transform: translateX(0);
        transition:
            transform 800ms var(--spring-default),
            background-color 800ms var(--spring-default),
            border-color 800ms var(--spring-default);
    }

    .icon {
        position: absolute;
        top: 50%;
        display: grid;
        width: 1.5rem;
        height: 1.5rem;
        place-items: center;
        transform: translateY(-50%);
        opacity: 0.72;
        transition:
            opacity 300ms ease,
            transform 800ms var(--spring-default);
    }

    .icon :global(svg) {
        width: 1rem;
        height: 1rem;
    }

    .icon-dark {
        right: 0.35rem;
    }

    .icon-light {
        left: 0.35rem;
        opacity: 0.35;
    }

    .stage:has(.switch-input:focus-visible) .switch {
        outline: 2px solid var(--text-accent);
        outline-offset: 0.25rem;
    }

    .stage:has(.switch-input:checked) .switch .track {
        border-color: color-mix(in oklab, var(--brand-black) 10%, transparent);
        background: var(--theme-toggle-track-active);
        box-shadow: inset 0 0.125rem 0.5rem color-mix(in oklab, var(--brand-blue-900) 8%, transparent);
    }

    .stage:has(.switch-input:checked) .switch .knob {
        transform: translateX(2rem);
    }

    .stage:has(.switch-input:checked) .icon-dark {
        opacity: 0.35;
    }

    .stage:has(.switch-input:checked) .icon-light {
        opacity: 0.82;
    }
</style>
