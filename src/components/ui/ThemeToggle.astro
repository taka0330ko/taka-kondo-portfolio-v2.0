    /* Theme switch */
    .stage {
        --theme-toggle-track: color-mix(in oklab, var(--color-acc) 80%, var(--color-acc));
        --theme-toggle-track-active: color-mix(in oklab, var(--brand-white) 88%, var(--brand-blue-100));
        --theme-toggle-border: color-mix(in oklab, var(--brand-white) 18%, transparent);
        --theme-toggle-knob: var(--brand-gray-50);
        --theme-toggle-knob-border: color-mix(in oklab, var(--brand-black) 8%, transparent);
        --theme-toggle-shadow: 0 0.5rem 1.25rem color-mix(in oklab, var(--brand-black) 22%, transparent);
        display: inline-flex;
    }

    .stage.is-syncing .track,
    .stage.is-syncing .knob,
    .stage.is-syncing .icon {
        transition: none;
    }

    .switch {
        display: inline-flex;
        cursor: pointer;
        border-radius: 9999px;
    }

    .track {
        position: relative;
        display: block;
        width: 4.875rem;
        height: 2.75rem;
        padding: 0.25rem;
        overflow: hidden;
        border: 1px solid var(--theme-toggle-border);
        border-radius: 9999px;
        background: var(--theme-toggle-track);
        box-shadow: inset 0 0.125rem 0.5rem color-mix(in oklab, var(--brand-black) 22%, transparent);
        transition:
            background-color 800ms var(--theme-toggle-spring),
            border-color 800ms var(--theme-toggle-spring),
            box-shadow 800ms var(--theme-toggle-spring);
    }

    .knob {
        position: relative;
        z-index: 1;
        display: block;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--theme-toggle-knob-border);
        border-radius: 9999px;
        background: var(--theme-toggle-knob);
        box-shadow: var(--theme-toggle-shadow);
        transform: translateX(0);
        transition:
            transform 800ms var(--theme-toggle-spring),
            background-color 800ms var(--theme-toggle-spring),
            border-color 800ms var(--theme-toggle-spring);
    }

    .icon {
        position: absolute;
        top: 50%;
        display: grid;
        width: 1.5rem;
        height: 1.5rem;
        place-items: center;
        transform: translateY(-50%);
        opacity: 0.72;
        transition:
            opacity 300ms ease,
            transform 800ms var(--theme-toggle-spring);
    }

    .icon :global(svg) {
        width: 1rem;
        height: 1rem;
    }

    .icon-dark {
        right: 0.625rem;
    }

    .icon-light {
        left: 0.625rem;
        opacity: 0.35;
    }

    .stage:has(.switch-input:focus-visible) .switch {
        outline: 2px solid var(--text-accent);
        outline-offset: 0.25rem;
    }

    .stage:has(.switch-input:checked) .switch .track {
        border-color: color-mix(in oklab, var(--brand-black) 10%, transparent);
        background: var(--theme-toggle-track-active);
        box-shadow: inset 0 0.125rem 0.5rem color-mix(in oklab, var(--brand-blue-900) 8%, transparent);
    }

    .stage:has(.switch-input:checked) .switch .knob {
        transform: translateX(2rem);
    }

    .stage:has(.switch-input:checked) .icon-dark {
        opacity: 0.35;
    }

    .stage:has(.switch-input:checked) .icon-light {
        opacity: 0.82;
    }
</style>
