---
import type { HTMLAttributes } from "astro/types";

//"extends HTMLAttributes<"a">"はaタグが持っているHTML属性をすべて使えるようにする
interface Props extends HTMLAttributes<"a"> {
    href?: string;
    className?: string;
}

//内部で class を操作する仕組みなので、propsで受け取る名前は className にする必要がある。
const {href, className, ...rest} = Astro.props;

const Tag =href? 'a' : 'span';


---

<Tag
href={href}
{...rest}
class:list={[
    "inline-flex text-body items-center gap-1 bg-linear-to-br from-white/30 to-white/0 backdrop-blur-lg rounded-full px-4 py-1 border border-white/20 shadow-lg text-foreground transition-colors",
    href ? "hover:text-accent cursor-pointer" : "cursor-default",
    className
]}
>
<slot name="before"/><span><slot /></span><slot name="after" />
</Tag>
