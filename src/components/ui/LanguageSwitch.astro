---
import MyArrowDown from "../../assets/images/icons/CaretDown.svg";
import { Globe } from "@lucide/astro";

const pathname = Astro.url.pathname;
const isJapanese = pathname === "/jp" || pathname.startsWith("/jp/");
const currentLanguage = isJapanese ? "JP" : "EN";
const anotherLanguage = isJapanese ? "EN" : "JP";
const anotherLanguagePath = isJapanese
    ? pathname.replace(/^\/jp(?=\/|$)/, "") || "/"
    : `/jp${pathname === "/" ? "" : pathname}`;
---

<div id="language-dropdown" class="relative">
    <button
        id="language-switch"
        type="button"
        class="flex cursor-pointer text-foreground transition-colors items-center gap-2 hover:text-accent"
        aria-expanded="false"
        aria-controls="another-lang"
    >
        <Globe class="h-5 w-5 shrink-0" stroke-width={1} aria-hidden="true" />
        <span class="font-heading underline underline-offset-4 w-[2ch]">{currentLanguage}</span><span class="language-arrow"><MyArrowDown /></span>
    </button>

    <div
        id="another-lang"
        class="absolute left-7 top-full z-10 pt-1.5"
        hidden
    >

<!-- 
    クリック領域の拡大
    p-3：クリック領域を四方向に12px拡大
    -m-3：余白を相殺し、文字の表示位置を維持 
-->
        <a
            href={anotherLanguagePath}
            class="-m-3 block whitespace-nowrap p-3 font-heading text-foreground transition-colors hover:text-accent hover:underline"
        >
            {anotherLanguage}
        </a>
    </div>
</div>

<style>
    .language-arrow {
        transition: transform 200ms ease;
    }

    #language-switch[aria-expanded="true"] .language-arrow {
        transform: rotate(180deg);
    }

    @media (prefers-reduced-motion: reduce) {
        .language-arrow {
            transition: none;
        }
    }
</style>

<script>
    let languageDropdownController: AbortController | undefined;

    function initLanguageDropdown() {
        languageDropdownController?.abort();
        languageDropdownController = new AbortController();
        const { signal } = languageDropdownController;

        const dropdown = document.getElementById("language-dropdown");
        const anotherLang = document.getElementById("another-lang");
        const langSwitch = document.getElementById("language-switch");

        if (!dropdown || !anotherLang || !langSwitch) return;

        const closeDropdown = () => {
            anotherLang.hidden = true;
            langSwitch.setAttribute("aria-expanded", "false");
        };

        langSwitch.addEventListener("click", () => {
            const willOpen = anotherLang.hidden;
            anotherLang.hidden = !willOpen;
            langSwitch.setAttribute("aria-expanded", String(willOpen));
        }, { signal });

        document.addEventListener("click", (event) => {
            if (!dropdown.contains(event.target as Node)) closeDropdown();
        }, { signal });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                closeDropdown();
                langSwitch.focus();
            }
        }, { signal });
    }

    document.addEventListener("astro:page-load", initLanguageDropdown);
    initLanguageDropdown();
</script>
