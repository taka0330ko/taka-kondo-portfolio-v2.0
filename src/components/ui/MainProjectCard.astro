---
import type { ImageMetadata } from "astro";
import Arrow from "../../assets/images/icons/card-arrow.svg";
import GlassPill from "./GlassPill.astro";
import { Image } from "astro:assets";
import { Check } from "@lucide/astro";

type Props = {
    href: string;
    cover: ImageMetadata;
    coverVideo?: string;
    title: string;
    description: string;
    summaryList: string[];
    tag: string;
};

const { href, cover, coverVideo, title, description,summaryList, tag } =
    Astro.props as Props;
---

<a
    href={href}
    class="project-card grid h-full group"
>
    <article
        class="gap-0 h-full rounded-sm mouse-track-card content transition duration-300 relative"
    >
        <div class="glow-effect"></div>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
            <figure class="relative overflow-hidden md:col-span-3">
                <Image
                    src={cover}
                    alt={title}
                    width={cover.width}
                    height={cover.height}
                    class="project-cover-image w-full h-full object-cover rounded-sm"
                />
                {
                    coverVideo && (
                        <video
                            src={coverVideo}
                            class="project-cover-video absolute rounded-sm inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100 group-focus-visible:opacity-100"
                            muted
                            loop
                            playsinline
                            preload="auto"
                            aria-label={`${title} preview`}
                        />
                        <div class="project-progress-track rounded-b-sm absolute left-0 right-0 bottom-0 h-1.5 bg-gray-400/30 overflow-hidden z-30 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
                            <div class="project-progress-bar h-full bg-accent w-full" />
                        </div>
                    )
                }
                <div class="absolute top-4 left-4 z-20">
                    <GlassPill class="text-white">{tag}</GlassPill>
                    </div>
  
            </figure>
            <div class="flex flex-col justify-between my-auto md:col-start-4 md:col-span-2">
                <h2 class="p-4">{title}</h2>
                <div class="flex flex-col">
                    <p class="px-4">{description}</p>
                    <ul class="px-4">
                        {summaryList?.map((list)=>(
                            <div class="flex gap-2 my-4"><Check class="text-accent"/><li>{list}</li></div>
                        ))}
                    </ul>
                </div>
                <div
                    class="flex justify-end items-end gap-4 mt-16 md:mt-32 px-6 pb-6 transition-all duration-300 self-end group-hover:translate-x-1 group-hover:opacity-100"
                >
                    <p>Click To Read More</p><Arrow class="text-foreground w-16 mb-2" />
                </div>
            </div>
        </div>
    </article>
</a>
<style>
    .mouse-track-card {
        position: relative;
        overflow: hidden;
    }

    .glow-effect {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            circle 250px at var(--x, 0px) var(--y, 0px),
            var(--five-lines),
            transparent 80%
        );
        opacity: 0;
        transition: opacity 0.3s;
        pointer-events: none;
    }

    .mouse-track-card:hover .glow-effect {
        opacity: 1;
    }

    .content {
        position: relative;
        z-index: 10;
    }

    .project-cover-image,
    .project-cover-video {
        aspect-ratio: 16 / 10;
        display: block;
    }

    .project-progress-bar {
        transform-origin: left center;
        transform: scaleX(0);
        will-change: transform;
    }

    .project-card:focus-within .project-progress-track {
        opacity: 1;
    }

    .project-card.is-video-active .project-cover-video,
    .project-card.is-video-active .project-progress-track {
        opacity: 1;
    }
</style>

<script>
    function trackingHover() {
        const cards =
            document.querySelectorAll<HTMLElement>(".mouse-track-card");

        cards.forEach((card) => {
            if (card.dataset.mouseTrackReady === "true") return;

            card.addEventListener("mousemove", (e: MouseEvent) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                // Update CSS Variables
                card.style.setProperty("--x", `${x}px`);
                card.style.setProperty("--y", `${y}px`);
            });
            card.dataset.mouseTrackReady = "true";
        });
    }

    const projectCoverVideoCleanups: Array<() => void> = [];
    let projectCoverVideoResizeTimer: number | null = null;
    let projectCoverVideoResizeReady = false;

    function cleanupProjectCoverVideos() {
        while (projectCoverVideoCleanups.length > 0) {
            projectCoverVideoCleanups.pop()?.();
        }
    }

    function setupProjectCoverVideosByViewport() {
        cleanupProjectCoverVideos();

        const cards =
            document.querySelectorAll<HTMLAnchorElement>(".project-card");

        const isMobile = window.matchMedia("(max-width: 767px)").matches;

        cards.forEach((card) => {
            const video = card.querySelector<HTMLVideoElement>(
                ".project-cover-video",
            );
            if (!video) return;

            const progressBar = card.querySelector<HTMLDivElement>(
                ".project-progress-bar",
            );

            let progressAnimationId: number | null = null;

            const updateProgressBar = () => {
                if (progressBar && video.duration && !isNaN(video.duration)) {
                    const progress = video.currentTime / video.duration;
                    progressBar.style.transform = `scaleX(${progress})`;
                }

                if (!video.paused && !video.ended) {
                    progressAnimationId =
                        requestAnimationFrame(updateProgressBar);
                }
            };

            const playVideo = () => {
                video.play().catch(() => {});

                if (progressAnimationId === null) {
                    progressAnimationId =
                        requestAnimationFrame(updateProgressBar);
                }
            };

            const resetVideo = () => {
                video.pause();
                video.currentTime = 0;

                if (progressAnimationId !== null) {
                    cancelAnimationFrame(progressAnimationId);
                    progressAnimationId = null;
                }

                if (progressBar) {
                    progressBar.style.transform = "scaleX(0)";
                }
            };

            const cleanupCard = () => {
                resetVideo();
                card.classList.remove("is-video-active");
                video.removeEventListener("ended", resetVideo);
            };

            video.addEventListener("ended", resetVideo);

            if (isMobile) {
                const observer = new IntersectionObserver(
                    ([entry]) => {
                        if (entry.isIntersecting) {
                            playVideo();
                            card.classList.add("is-video-active");
                        } else {
                            resetVideo();
                            card.classList.remove("is-video-active");
                        }
                    },
                    {
                        threshold: 0.5,
                    },
                );

                observer.observe(card);

                projectCoverVideoCleanups.push(() => {
                    observer.disconnect();
                    cleanupCard();
                });
            } else {
                card.addEventListener("mouseenter", playVideo);
                card.addEventListener("focusin", playVideo);
                card.addEventListener("mouseleave", resetVideo);
                card.addEventListener("focusout", resetVideo);

                projectCoverVideoCleanups.push(() => {
                    card.removeEventListener("mouseenter", playVideo);
                    card.removeEventListener("focusin", playVideo);
                    card.removeEventListener("mouseleave", resetVideo);
                    card.removeEventListener("focusout", resetVideo);
                    cleanupCard();
                });
            }
        });
    }

    function setupProjectCoverVideos() {
        setupProjectCoverVideosByViewport();

        if (projectCoverVideoResizeReady) return;

        window.addEventListener("resize", () => {
            if (projectCoverVideoResizeTimer !== null) {
                window.clearTimeout(projectCoverVideoResizeTimer);
            }

            projectCoverVideoResizeTimer = window.setTimeout(() => {
                setupProjectCoverVideosByViewport();
                projectCoverVideoResizeTimer = null;
            }, 150);
        });

        projectCoverVideoResizeReady = true;
    }

    document.addEventListener("astro:page-load", trackingHover);
    document.addEventListener("astro:page-load", setupProjectCoverVideos);
    trackingHover();
    setupProjectCoverVideos();
</script>
