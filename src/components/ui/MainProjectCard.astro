---
import type { ImageMetadata } from "astro";
import Arrow from "../../assets/images/icons/card-arrow.svg";
import GlassPill from "./GlassPill.astro";
import { Image } from "astro:assets";

type Props = {
    href: string;
    cover: ImageMetadata;
    coverVideo?: string;
    title: string;
    description: string;
    tag: string;
};

const { href, cover, coverVideo, title, description, tag } =
    Astro.props as Props;
---

<a
    href={href}
    class="project-card grid grid-rows-subgrid row-span-4 h-full group"
>
    <article
        class="gap-0 h-full bg-card-gradient backdrop-blur-lg
                    rounded-lg border border-white/20 shadow-lg mouse-track-card content transition duration-300 relative"
    >
        <div class="glow-effect"></div>
        <div class="grid grid-cols-1 md:grid-cols-2">
            <figure class="relative overflow-hidden rounded-l-lg">
                <Image
                    src={cover}
                    alt={title}
                    width={cover.width}
                    height={cover.height}
                    class="project-cover-image w-full h-full object-cover"
                />
                {
                    coverVideo && (
                        <video
                            src={coverVideo}
                            class="project-cover-video absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100 group-focus-visible:opacity-100"
                            muted
                            loop
                            playsinline
                            preload="auto"
                            aria-label={`${title} preview`}
                        />
                    )
                }
                <div class="absolute top-4 left-4 z-20">
                    <GlassPill class="text-white">{tag}</GlassPill>
                </div>
            </figure>
            <div class="flex flex-col justify-between my-auto">
                {
                    coverVideo && (
                        <div class="project-progress-track h-1 bg-gray-400/30 overflow-hidden z-30 mx-4 mb-28 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
                            <div class="project-progress-bar h-full bg-accent w-full" />
                        </div>
                    )
                }
                <h3 class="p-4">{title}</h3>
                <div class="flex flex-col gap-16">
                    <p class="px-4">{description}</p>
                    <div
                        class="flex justify-end px-6 pb-6 transition-all duration-300 self-end opacity-0 group-hover:translate-x-1 group-hover:opacity-100"
                    >
                        <Arrow class="text-foreground w-16" />
                    </div>
                </div>
            </div>
        </div>
    </article>
</a>

<style>
    .mouse-track-card {
        position: relative;
        overflow: hidden;
    }

    .glow-effect {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            circle 250px at var(--x, 0px) var(--y, 0px),
            var(--five-lines),
            transparent 80%
        );
        opacity: 0;
        transition: opacity 0.3s;
        pointer-events: none;
    }

    .mouse-track-card:hover .glow-effect {
        opacity: 1;
    }

    .content {
        position: relative;
        z-index: 10;
    }

    .project-cover-image,
    .project-cover-video {
        aspect-ratio: 16 / 10;
    }

    .project-progress-bar {
        transform-origin: left center;
        transform: scaleX(0);
        will-change: transform;
    }

    .project-card:focus-within .project-progress-track {
        opacity: 1;
    }
</style>

<script>
    function trackingHover() {
        const cards =
            document.querySelectorAll<HTMLElement>(".mouse-track-card");

        cards.forEach((card) => {
            if (card.dataset.mouseTrackReady === "true") return;

            card.addEventListener("mousemove", (e: MouseEvent) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                // Update CSS Variables
                card.style.setProperty("--x", `${x}px`);
                card.style.setProperty("--y", `${y}px`);
            });
            card.dataset.mouseTrackReady = "true";
        });
    }

    function setupProjectCoverVideos() {
        const cards =
            document.querySelectorAll<HTMLAnchorElement>(".project-card");

        cards.forEach((card) => {
            const video = card.querySelector<HTMLVideoElement>(
                ".project-cover-video",
            );
            if (!video || card.dataset.videoHoverReady === "true") return;

            const progressBar = card.querySelector<HTMLDivElement>(
                ".project-progress-bar",
            );

            let progressAnimationId: number | null = null;

            const updateProgressBar = () => {
                if (progressBar && video.duration && !isNaN(video.duration)) {
                    const progress = video.currentTime / video.duration;
                    progressBar.style.transform = `scaleX(${progress})`;
                }

                if (!video.paused && !video.ended) {
                    progressAnimationId =
                        requestAnimationFrame(updateProgressBar);
                }
            };

            const playVideo = () => {
                video.play().catch(() => {});

                if (progressAnimationId === null) {
                    progressAnimationId =
                        requestAnimationFrame(updateProgressBar);
                }
            };

            const resetVideo = () => {
                video.pause();
                video.currentTime = 0;

                if (progressAnimationId !== null) {
                    cancelAnimationFrame(progressAnimationId);
                    progressAnimationId = null;
                }

                if (progressBar) {
                    progressBar.style.transform = "scaleX(0)";
                }
            };

            card.addEventListener("mouseenter", playVideo);
            card.addEventListener("focusin", playVideo);
            card.addEventListener("mouseleave", resetVideo);
            card.addEventListener("focusout", resetVideo);

            if (video && progressBar) {
                video.addEventListener("ended", resetVideo);
            }
            card.dataset.videoHoverReady = "true";
        });
    }

    document.addEventListener("astro:page-load", trackingHover);
    document.addEventListener("astro:page-load", setupProjectCoverVideos);
    trackingHover();
    setupProjectCoverVideos();
</script>
