---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import GreenBolb from "./greenBolb.astro";

interface Props {
    cover: ImageMetadata;
    coverType?: "image" | "green-blob";
    title: string;
}

const { cover, coverType, title } = Astro.props;
---

<div class="archive-image-wrap">
    {
        coverType === "green-blob" ? (
            <GreenBolb />
        ) : (
            <>
                <Image
                    class="archive-blur-image"
                    src={cover}
                    alt=""
                    loading="lazy"
                    aria-hidden="true"
                />
                <Image
                    class="archive-main-image"
                    src={cover}
                    alt={title}
                    loading="lazy"
                />
            </>
        )
    }
</div>

<style>
    .archive-image-wrap {
        position: relative;
        display: flex;
        width: 100%;
        height: var(--card-height);
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 24px;
        background: #e6e6e6;
    }

    .archive-image-wrap :global(img) {
        display: block;
    }

    .archive-blur-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: blur(24px);
        opacity: 0.75;
        transform: scale(1.12);
    }

    .archive-main-image {
        position: relative;
        z-index: 1;
        box-sizing: border-box;
        width: 100%;
        height: 100%;
        padding: var(--card-padding);
        object-fit: contain;
    }
</style>
