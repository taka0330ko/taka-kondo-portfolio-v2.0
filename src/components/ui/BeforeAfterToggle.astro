---
const { class: className } = Astro.props;
---
<div class:list={["stage", className]}>
        <div class="segmented">
          <span class="segment-indicator"></span>
          <input class="segment-input" id="segment-1" name="segment" type="radio" />
          <label class="segment" for="segment-1" style="anchor-name: --segment-1">Original</label>
          <input class="segment-input" id="segment-2" name="segment" type="radio" checked />
          <label class="segment" for="segment-2" style="anchor-name: --segment-2">Add Hours Breakdown</label>
        </div>
        <div class="toggle-content">
          <div class="toggle-panel before-panel">
            <slot name="before" />
          </div>
          <div class="toggle-panel after-panel">
            <slot name="after" />
          </div>
        </div>
</div>

<style>
    .stage {
        &:has(#segment-1:checked) {
          .before-panel {
            display: block;
          }

          .after-panel {
            display: none;
          }
        }

        &:has(#segment-2:checked) {
          .before-panel {
            display: none;
          }

          .after-panel {
            display: block;
          }
        }
      }

    .segmented {
        --selected-anchor: --segment-2;
        position: relative;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        width: fit-content;
        max-width: 100%;
        padding: 8px;
        border: 1px solid var(--brand-gray-400);
        border-radius: 999px;

        .segment-indicator {
          position: absolute;
          position-anchor: var(--selected-anchor);
          top: anchor(top);
          left: anchor(left);
          width: anchor-size(width);
          height: anchor-size(height);
          border-radius: 999px;
          background: var(--color-accent);
          pointer-events: none;
          transition:
            top 1s var(--spring-default),
            left 1s var(--spring-default),
            width 1s var(--spring-default),
            height 1s var(--spring-default);
        }

        .segment {
          position: relative;
          z-index: 1;
          display: inline flex;
          align-items: center;
          min-height: 48px;
          padding-inline: 20px;
          border-radius: 999px;
          cursor: pointer;
          user-select: none;
          transition: all 0.2s;

          @media (any-hover: hover) {
            &:hover {
              background: var(--hover-bg);
            }
          }
        }

        .segment-input:checked + .segment {
          color: var(--color-foreground-inverse);
        }

        &:has(#segment-1:checked) {
          --selected-anchor: --segment-1;
        }

        &:has(#segment-2:checked) {
          --selected-anchor: --segment-2;
        }

        @media (any-hover: hover) {
          .segment-input:checked + .segment:hover {
            background: transparent;
          }
        }

        @media (width < 578px) {
          width: 100%;
          flex-direction: column;
          border-radius: 24px;

          .segment {
            width: 100%;
            justify-content: center;
            padding-inline: 16px;
          }
        }
      }

      .segment-input {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        margin: -1px;
        padding: 0;
        border: 0;
        overflow: hidden;
        clip-path: inset(50%);
      }

</style>
