---
const { class: className } = Astro.props;
---
<div class:list={["stage", className]} data-before-after-toggle data-active="after">
        <div class="segmented">
          <span class="segment-indicator" aria-hidden="true"></span>
          <button class="segment" type="button" data-toggle-target="before" aria-pressed="false" style="anchor-name: --segment-before">Original</button>
          <button class="segment" type="button" data-toggle-target="after" aria-pressed="true" style="anchor-name: --segment-after">Redesign</button>
        </div>
        <div class="toggle-content">
          <div class="toggle-panel before-panel" data-toggle-panel="before" hidden>
            <slot name="before" />
          </div>
          <div class="toggle-panel after-panel" data-toggle-panel="after">
            <slot name="after" />
          </div>
        </div>
</div>

<script is:inline>
    function initBeforeAfterToggle() {
        const toggles = document.querySelectorAll("[data-before-after-toggle]");

        toggles.forEach((toggle) => {
            if (toggle.dataset.bound === "true") return;

            const buttons = toggle.querySelectorAll("[data-toggle-target]");
            const panels = toggle.querySelectorAll("[data-toggle-panel]");

            function setActive(active) {
                toggle.dataset.active = active;

                buttons.forEach((button) => {
                    const isActive = button.dataset.toggleTarget === active;
                    button.setAttribute("aria-pressed", String(isActive));
                });

                panels.forEach((panel) => {
                    panel.hidden = panel.dataset.togglePanel !== active;
                });
            }

            buttons.forEach((button) => {
                button.addEventListener("click", () => {
                    setActive(button.dataset.toggleTarget);
                });
            });

            setActive(toggle.dataset.active || "after");
            toggle.dataset.bound = "true";
        });
    }

    document.addEventListener("astro:page-load", initBeforeAfterToggle);
    initBeforeAfterToggle();
</script>

<style>
    .stage {
        overflow-anchor: none;
      }

    .segmented {
        --selected-anchor: --segment-after;
        position: relative;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        width: fit-content;
        max-width: 100%;
        padding: 8px;
        border: 1px solid var(--brand-gray-400);
        border-radius: 999px;

        .segment-indicator {
          position: absolute;
          position-anchor: var(--selected-anchor);
          top: anchor(top);
          left: anchor(left);
          width: anchor-size(width);
          height: anchor-size(height);
          border-radius: 999px;
          background: var(--color-accent);
          pointer-events: none;
          transition:
            top 1s var(--spring-default),
            left 1s var(--spring-default),
            width 1s var(--spring-default),
            height 1s var(--spring-default);
        }

        .segment {
          position: relative;
          z-index: 1;
          display: inline flex;
          align-items: center;
          min-height: 48px;
          padding-inline: 20px;
          border: 0;
          border-radius: 999px;
          background: transparent;
          color: inherit;
          font: inherit;
          cursor: pointer;
          user-select: none;
          transition: all 0.2s;

          @media (any-hover: hover) {
            &:hover {
              background: var(--hover-bg);
            }
          }
        }

        .segment[aria-pressed="true"] {
          color: var(--color-foreground-inverse);
        }

        .stage[data-active="before"] & {
          --selected-anchor: --segment-before;
        }

        .stage[data-active="after"] & {
          --selected-anchor: --segment-after;
        }

        @media (any-hover: hover) {
          .segment[aria-pressed="true"]:hover {
            background: transparent;
          }
        }

        @media (width < 578px) {
          width: 100%;
          flex-direction: column;
          border-radius: 24px;

          .segment {
            width: 100%;
            justify-content: center;
            padding-inline: 16px;
          }
        }
      }

      .toggle-content {
        position: relative;
        width: 100%;
        min-height: 0;
        flex: 1;
        overflow-anchor: none;
      }

      .toggle-panel {
        position: absolute;
        inset: 0;
        width: 100%;
        overflow: auto;
      }

      .toggle-panel[hidden] {
        display: none;
      }

</style>
