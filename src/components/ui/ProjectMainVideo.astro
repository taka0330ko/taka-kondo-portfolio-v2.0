---
import PlayButton from "./PlayButton.astro";

const { src, fallbackSrc, poster } = Astro.props;
const isWebm = typeof src === "string" && src.endsWith(".webm");
---

<PlayButton class="col-span-12">
    <video
        class="h-auto w-full aspect-video bg-text-block object-cover"
        poster={poster}
        controls
        loop
        muted
        playsinline>
        <source src={src} type={isWebm ? "video/webm" : "video/mp4"} />
        {fallbackSrc && <source src={fallbackSrc} type="video/mp4" />}
    </video>
</PlayButton>
