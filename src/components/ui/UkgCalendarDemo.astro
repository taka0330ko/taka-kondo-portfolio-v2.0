---
import Summary from "../../assets/images/projects/UKG/calendar-summary.svg?url";
import Week1 from "../../assets/images/projects/UKG/calendar-week-1.svg?url";
import Week2 from "../../assets/images/projects/UKG/calendar-week-2.svg?url";
---
<section class="ukg-calendar-demo" data-calendar-demo aria-label="Interactive UKG calendar preview">
  <h3>Hours breakdown</h3>
  <div class="week-toggle" role="group" aria-label="Select pay week">
    <span class="toggle-thumb" aria-hidden="true"></span>
    <button type="button" data-week="0" aria-pressed="true">week1</button>
    <button type="button" data-week="1" aria-pressed="false">week2</button>
  </div>
  <div class="calendar-art">
    <img src={Week1} data-week-art="0" alt="Week 1 calendar, April 5 to 11, with no work entries" width="639" height="401" />
    <img src={Week2} data-week-art="1" alt="Week 2 calendar, April 12 to 18, with no work entries" width="639" height="401" hidden />
  </div>
  <div class="summary-art">
    <img src={Summary} width="624" height="124" alt="Week 1 and Week 2 hours summary and total hours" />
    <span class="summary-marker" aria-hidden="true"></span>
  </div>
</section>
<style>
.summary-art{position:relative;margin-top:16px}.summary-art img{width:100%;height:auto;display:block}.summary-marker{position:absolute;left:2.56%;top:3.2%;width:1.28%;height:14.5%;background:#30cebb;border-radius:8px;transition:top .3s}

.calendar-art img{display:block;width:100%;height:auto}.calendar-art img[hidden]{display:none}

.ukg-calendar-demo{--calendar-ink:#1a1a1a;--calendar-muted:#434343;--calendar-line:#d9d9d9;--calendar-line-light:#f2f2f2;--calendar-action:#00786f;--calendar-accent:#30cebb;--calendar-space:16px;--calendar-grid-height:clamp(220px,26vw,360px);color:var(--calendar-ink);background:#fff;border:1px solid var(--calendar-line);border-radius:5px;padding:var(--calendar-space);font-family:inherit;width:100%;max-width:440px;margin:0;box-sizing:border-box}
.ukg-calendar-demo h3{font-size:18px;font-weight:400;line-height:1.3;margin:0 0 var(--calendar-space)}
.week-toggle{position:relative;display:flex;width:156px;margin:0 auto 24px;background:var(--calendar-accent);padding:3px;border-radius:100px}
.toggle-thumb{position:absolute;inset:3px auto 3px 3px;width:calc((100% - 6px)/2);border-radius:100px;background:var(--calendar-action);transition:transform .4s cubic-bezier(.22,1,.36,1)}
.week-toggle button{position:relative;z-index:1;width:50%;padding:7px 0;border:0;border-radius:100px;background:transparent;color:var(--calendar-ink);font:inherit;font-size:11px;cursor:pointer;transition:color .2s}
.week-toggle button[aria-pressed=true]{color:#fff}.week-toggle button:focus-visible{outline:2px solid var(--calendar-action);outline-offset:5px}
.calendar-chart{position:relative;display:grid;grid-template-columns:36px 1fr;grid-template-rows:var(--calendar-grid-height) auto;margin-top:var(--calendar-space)}
.time-axis{position:relative;grid-column:1;grid-row:1;font-size:10px;color:var(--calendar-muted)}.time-axis span{position:absolute;right:8px;transform:translateY(-50%)}
.week-grid{grid-column:2;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border-top:2px solid var(--calendar-line);border-bottom:2px solid var(--calendar-line);background:repeating-linear-gradient(to bottom,transparent 0,transparent calc(25% - 1px),var(--calendar-line) calc(25% - 1px),var(--calendar-line) calc(25% + 1px),transparent calc(25% + 1px),transparent 25%)}
.day-column{border-left:2px solid var(--calendar-line-light)}.day-column:last-child{border-right:2px solid var(--calendar-line-light)}
.date-row{grid-column:2;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));padding-top:18px;gap:3px}.day-label{display:flex;align-items:center;gap:5px;min-width:0}.day-label b{border-left:2px solid var(--calendar-line);padding-left:4px;font-size:clamp(16px,1.8vw,27px);font-weight:700;line-height:1}.day-label>div{display:grid;gap:3px;text-align:center}.day-label span{font-size:10px}.day-label small{font-size:7px;white-space:nowrap}
.weekly-summary{margin-top:28px;font-size:11px}.summary-row{display:grid;grid-template-columns:6px 1fr auto;gap:7px;align-items:center;margin-bottom:12px}.summary-row i{height:18px;border-radius:5px}.summary-row i.active{background:var(--calendar-accent)}.date-range{color:var(--calendar-muted);margin-left:4px}.total-row{border-top:1px solid var(--calendar-line);padding-top:20px;margin-top:8px;display:flex;justify-content:space-between;font-weight:700}.total-row strong{font-size:1.15em}
@media(max-width:480px){.ukg-calendar-demo{--calendar-space:10px}.date-row{gap:1px}.day-label{flex-direction:column;gap:4px}.day-label>div{gap:2px}.date-range{display:block;margin:2px 0 0}.weekly-summary{font-size:11px}}
@media(prefers-reduced-motion:reduce){.toggle-thumb,.week-toggle button{transition:none}}
</style>
<script>
function initCalendars(){
 document.querySelectorAll<HTMLElement>('[data-calendar-demo]').forEach(calendar=>{
  if(calendar.dataset.ready)return;calendar.dataset.ready='true';
  const buttons=calendar.querySelectorAll<HTMLButtonElement>('[data-week]');
  buttons.forEach(button=>button.addEventListener('click',()=>{
   const week=Number(button.dataset.week);
   buttons.forEach(tab=>tab.setAttribute('aria-pressed',String(tab===button)));
   const thumb=calendar.querySelector<HTMLElement>('.toggle-thumb');if(thumb)thumb.style.transform=`translateX(${week*100}%)`;
   calendar.querySelectorAll<HTMLImageElement>('[data-week-art]').forEach(art=>{art.hidden=Number(art.dataset.weekArt)!==week});
   const marker=calendar.querySelector<HTMLElement>('.summary-marker');if(marker)marker.style.top=week===0?'3.2%':'28.2%';
  }));
 });
}
initCalendars();document.addEventListener('astro:page-load',initCalendars);
</script>
