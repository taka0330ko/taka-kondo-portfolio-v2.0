---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    href: string;
    title: string;
    description: string;
    date: string;
    cover?: ImageMetadata;
    coverAlt?: string;
    coverVideo?: string;
    coverVideoFallback?: string;
    transitionKey: string;
}

const { href, title, description, date, cover, coverAlt, coverVideo, coverVideoFallback, transitionKey } = Astro.props;
---

<a class="blog-card mouse-track-card" href={href}>
    <div class="glow-effect" aria-hidden="true"></div>
    <div class="blog-card-cover content" aria-hidden={cover ? undefined : "true"}>
        {cover && (
            <Image
                src={cover}
                alt={coverAlt ?? ""}
                widths={[480, 768, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
                style={`view-transition-name: blog-cover-${transitionKey};`}
            />
        )}
        {coverVideo && (
            <video class="blog-card-video" muted loop playsinline preload="none" aria-hidden="true">
                <source data-src={coverVideo} type="video/webm" />
                {coverVideoFallback && <source data-src={coverVideoFallback} type="video/mp4" />}
            </video>
        )}
    </div>
    <div class="blog-card-body content">
        <time class="blog-card-date">{date}</time>
        <h3 class="blog-card-title">{title}</h3>
        <p class="blog-card-description">{description}</p>
    </div>
</a>

<style>
    .blog-card {
        position: relative;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        overflow: hidden;
        background: var(--card-surface, transparent);
        transition: transform 300ms cubic-bezier(0.2, 0.75, 0.25, 1);
    }

    .mouse-track-card {
        position: relative;
        overflow: hidden;
    }

    .glow-effect {
        position: absolute;
        inset: 0;
        z-index: 0;
        background: radial-gradient(
            circle 250px at var(--x, 0px) var(--y, 0px),
            var(--accent-bg-lines),
            transparent 80%
        );
        opacity: 0;
        transition: opacity 0.3s;
        pointer-events: none;
    }

    .mouse-track-card:hover .glow-effect,
    .mouse-track-card:focus-visible .glow-effect {
        opacity: 1;
    }

    .content {
        position: relative;
        z-index: 10;
    }

    .blog-card-cover {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--brand-gray-100, #e6e6e6);
        isolation: isolate;
    }

    .blog-card-cover :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
    }

    .blog-card-video {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
        opacity: 0;
        transition: opacity 180ms ease;
    }

    .blog-card.is-video-playing .blog-card-video {
        opacity: 1;
    }

    .blog-card-body {
        padding-block: 1rem;
    }

    .blog-card-date {
        display: block;
        font-size: 0.875rem;
        color: var(--text-body-default);
    }

    .blog-card-title {
        margin-top: 0.5rem;
        font-family: var(--font-satoshi), sans-serif;
        font-size: 1.25rem;
        color: var(--text-heading-default);
    }

    .blog-card-description {
        margin-top: 0.5rem;
        color: var(--text-body-default);
        line-height: 1.5;
    }

    @media (hover: hover) and (pointer: fine) {
        .blog-card:hover,
        .blog-card:focus-visible {
            transform: translateY(-3px);
        }

    }

    @media (prefers-reduced-motion: reduce) {
        .blog-card,
        .blog-card-video,
        .glow-effect {
            transition: none;
        }

        .blog-card:hover,
        .blog-card:focus-visible {
            transform: none;
        }
    }
</style>

<script>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const precisePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

    const bindBlogCardVideos = () => {
        document.querySelectorAll<HTMLElement>(".blog-card").forEach((card) => {
            if (card.dataset.glowBound !== "true") {
                card.dataset.glowBound = "true";
                card.addEventListener("pointermove", (event: PointerEvent) => {
                    const rect = card.getBoundingClientRect();
                    card.style.setProperty("--x", `${event.clientX - rect.left}px`);
                    card.style.setProperty("--y", `${event.clientY - rect.top}px`);
                });
            }

            if (card.dataset.videoBound === "true") return;

            const video = card.querySelector<HTMLVideoElement>(".blog-card-video");
            if (!video) return;
            card.dataset.videoBound = "true";

            let sourcesLoaded = false;
            const loadSources = () => {
                if (sourcesLoaded) return;
                video.querySelectorAll<HTMLSourceElement>("source[data-src]").forEach((source) => {
                    source.src = source.dataset.src ?? "";
                    source.removeAttribute("data-src");
                });
                video.load();
                sourcesLoaded = true;
            };

            const play = async () => {
                if (reducedMotion.matches) return;
                loadSources();
                video.currentTime = 0;
                try {
                    await video.play();
                    card.classList.add("is-video-playing");
                } catch {
                    card.classList.remove("is-video-playing");
                }
            };

            const stop = () => {
                card.classList.remove("is-video-playing");
                video.pause();
                video.currentTime = 0;
            };

            card.addEventListener("pointerenter", () => {
                if (precisePointer.matches) void play();
            });
            card.addEventListener("pointerleave", stop);
            card.addEventListener("focusin", () => void play());
            card.addEventListener("focusout", stop);
            // Reveal the still image before Astro captures the outgoing view.
            card.addEventListener("click", stop);
            reducedMotion.addEventListener("change", (event) => event.matches && stop());
        });
    };

    bindBlogCardVideos();
    document.addEventListener("astro:page-load", bindBlogCardVideos);
</script>
