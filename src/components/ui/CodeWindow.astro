---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";

//Restrict usage to only the languages supported by Astro's Code component
type CodeLang = ComponentProps<typeof Code>["lang"];

interface Props {
    code: string;
    lang?: CodeLang;
    showExpand?: boolean;
}

const { code, lang = "ts", showExpand = true } = Astro.props;
---


<figure data-code-window class="bg-glass bg-card-gradient overflow-hidden rounded-lg">
  {showExpand && (
    <div class="border-b border-black/10 px-4 py-3">
      <button
        data-toggle
        type="button"
        class="cursor-pointer rounded-sm bg-background px-2 py-1 text-sm text-heading-default transition hover:text-accent"
        aria-expanded="false"
      >
        Expand
      </button>
    </div>
  )}

  <div
    data-window-panel
    class="relative overflow-hidden transition-all duration-300 ease-in-out"
  >
      <Code code={code} lang={lang} class="p-4"/>

    {showExpand && (
      <div
        data-fade
        class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-linear-to-t from-[#0d1117] to-transparent transition-opacity duration-300"
      />
    )}
  </div>
</figure>

<script>
// idではなくdata属性でDOMを取得する。
// このコンポーネントは複数回使われるため、idだと衝突する。
// data属性とrootスコープで、各インスタンスごとに安全に制御する。

// Use data attributes for DOM selection instead of id.
// This component can be rendered multiple times, so id would cause conflicts.
// data-* + root.querySelector ensures scoped selection per component instance.

    function showCodePanel(){
  document.querySelectorAll('[data-code-window]').forEach((root) => {
// 1回目 → 初期化して data-bound="true" を付ける
// 2回目 → もう初期化済みだからスキップ
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const button = root.querySelector('[data-toggle]');
    const panel = root.querySelector('[data-window-panel]');
    const fade = root.querySelector('[data-fade]');

    if (!(panel instanceof HTMLElement)) return;

    const collapsedHeight = 200;
    let isExpanded = false;

    panel.style.maxHeight = `${collapsedHeight}px`;

    if (!(button instanceof HTMLButtonElement)) return;

    button.addEventListener('click', () => {
      isExpanded = !isExpanded;

      button.textContent = isExpanded ? 'Collapse' : 'Expand';
      button.setAttribute('aria-expanded', String(isExpanded));

      panel.style.maxHeight = isExpanded
        ? `${panel.scrollHeight}px`
        : `${collapsedHeight}px`;

      if (fade instanceof HTMLElement) {
        fade.style.opacity = isExpanded ? '0' : '1';
      }
    });
  });
}

document.addEventListener("astro:page-load", showCodePanel);
</script>