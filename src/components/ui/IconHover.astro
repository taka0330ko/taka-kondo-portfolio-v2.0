<style>
  /* Icon */
  .icon-link-hover {
    position: relative;
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    color: var(--color-heading-default);
    transition: color 300ms;
  }

  .icon-link-hover:hover {
    color: var(--color-accent);
  }

  .icon-link-hover:focus-visible {
    color: black;
  }

  .icon-link-hover::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateY(-100%);
    background: linear-gradient(
      to bottom right,
      rgb(255 255 255 / 0.3),
      rgb(255 255 255 / 0)
    );
    backdrop-filter: blur(16px);
    transition: transform 300ms;
  }

  .group:hover .icon-link-hover::after {
    transform: translateY(0);
  }

  /* Tooltip */
  .icon-tooltip {
    pointer-events: none;
    position: absolute;
    left: 50%;
    top: 100%;
    z-index: 20;
    margin-top: 0.5rem;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 0.25rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 0.25rem;
    background: linear-gradient(
      to bottom right,
      rgb(255 255 255 / 0.3),
      rgb(255 255 255 / 0)
    );
    backdrop-filter: blur(16px);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
    color: var(--color-accent);
    font-size: 0.75rem;
    line-height: 1rem;
    opacity: 0;
    transition:
      transform 800ms var(--spring-strong),
      opacity 800ms var(--spring-strong);
  }

  .group:hover .icon-tooltip {
    transform: translate(-50%, 0.25rem);
    opacity: 1;
  }
</style>
