---
import { Image } from "astro:assets";
import GreenSabonCover from "../../assets/images/archive/works/green-sbon/green-sabon-cover.png";
import GreenSabonLogo from "../../assets/images/archive/works/green-sbon/green-sabon-logo.png";
---

<div class="green-blob-cover" aria-label="Animated Green Sabon cover" role="img">
    <span
        class="blur-background"
        style={`background-image: url(${GreenSabonCover.src})`}
        aria-hidden="true"
    ></span>
    <span class="dot-panel" aria-hidden="true">
        <span class="bubble-layer">
            <span class="bubble bubble-1"></span>
            <span class="bubble bubble-2"></span>
            <span class="bubble bubble-3"></span>
        </span>
        <Image
            class="green-sabon-logo"
            src={GreenSabonLogo}
            alt="Green Sabon"
            loading="lazy"
        />
    </span>
</div>

<style>
    .green-blob-cover {
        --bubble-spring: linear(0, 0.0282, 0.1054, 0.2195, 0.3584, 0.5107, 0.6659, 0.8149, 0.9506, 1.0676, 1.1625, 1.2335, 1.2805, 1.3046, 1.3083, 1.2944, 1.2666, 1.2285, 1.1839, 1.1362, 1.0885, 1.0435, 1.0032, 0.9691, 0.9421, 0.9225, 0.9102, 0.9048, 0.9055, 0.9113, 0.921, 0.9335, 0.9477, 0.9626, 0.9771, 0.9906, 1.0025, 1.0124, 1.0201, 1.0254, 1.0285, 1.0296, 1.0288, 1.0266, 1.0233, 1.0192, 1.0147, 1.0101, 1.0057, 1.0017, 0.9982, 0.9953, 0.9932, 0.9918, 0.991, 0.9909, 0.9913, 0.9921, 0.9932, 0.9945, 0.9959, 0.9973, 0.9986, 0.9998, 1.0009, 1.0017, 1.0023, 1.0026, 1.0028, 1.0028, 1.0026, 1.0024, 1.002, 1.0016, 1.0011, 1.0007, 1.0003, 0.9999, 0.9996, 0.9994, 0.9993, 0.9992, 0.9991, 0.9991, 0.9992, 0.9993, 0.9994, 0.9996, 0.9997, 0.9998, 0.9999, 1, 1.0001, 1.0002, 1.0002, 1.0003, 1.0003, 1.0003, 1.0002, 1.0002, 1);
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        isolation: isolate;
        background: transparent;
    }

    .blur-background {
        position: absolute;
        inset: -10%;
        z-index: -1;
        background-position: center;
        background-size: cover;
        filter: blur(28px);
        opacity: 0.7;
        transform: scale(1.15);
    }

    .dot-panel {
        position: absolute;
        top: 50%;
        left: 50%;
        width: min(76%, calc(var(--card-height, 20rem) - 3rem));
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 24px;
        background-color: #f4f6f7;
        background-image: radial-gradient(
            circle,
            #dfe3e7 1.5px,
            transparent 1.75px
        );
        background-position: center;
        background-size: 24px 24px;
        box-shadow: 0 16px 40px rgb(31 82 48 / 0.08);
        transform: translate(-50%, -50%);
    }

    .bubble-layer {
        position: absolute;
        inset: 0;
        display: block;
        scale: 1;
        transition: scale 1.1s var(--bubble-spring);
        will-change: scale;
    }

    .green-sabon-logo {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 2;
        width: 70%;
        height: auto;
        transform: translate(-50%, -50%);
    }

    .bubble {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 71%;
        aspect-ratio: 1;
        translate: -50% -50%;
        background: #43b968;
        opacity: 0.42;
        scale: 1;
        transition:
            scale 1s var(--bubble-spring),
            opacity 1s var(--bubble-spring),
            border-radius 1s var(--bubble-spring);
        animation: bubble 60s linear infinite;
        will-change: border-radius, transform;
    }

    .bubble-2 {
        width: 80%;
        background: #73cf8b;
        opacity: 0.38;
        animation-delay: -10s;
    }

    .bubble-3 {
        width: 72%;
        background: #22a954;
        opacity: 0.32;
        animation-delay: -15s;
    }

    .green-blob-cover:hover .bubble-layer {
        scale: 1.08;
    }

    .green-blob-cover:hover .bubble {
        opacity: 0.52;
    }

    @keyframes bubble {
        0% {
            border-radius: 48% 52% 68% 32% / 42% 28% 72% 58%;
            transform: rotate(0deg) translate3d(0, 0, 0);
        }

        10% {
            border-radius: 69% 31% 71% 29% / 67% 31% 69% 33%;
        }

        20% {
            border-radius: 61% 39% 51% 49% / 57% 58% 42% 43%;
            transform: rotate(72deg) translate3d(3%, -2%, 0);
        }

        30% {
            border-radius: 32% 68% 38% 62% / 65% 60% 40% 35%;
        }

        40% {
            border-radius: 57% 43% 49% 51% / 55% 71% 29% 45%;
            transform: rotate(144deg) translate3d(-2%, 3%, 0);
        }

        50% {
            border-radius: 44% 56% 32% 68% / 69% 26% 74% 31%;
        }

        60% {
            border-radius: 38% 62% 35% 65% / 74% 53% 47% 26%;
            transform: rotate(216deg) translate3d(2%, 2%, 0);
        }

        70% {
            border-radius: 75% 25% 47% 53% / 49% 53% 47% 51%;
        }

        80% {
            border-radius: 41% 59% 65% 35% / 73% 50% 50% 27%;
            transform: rotate(288deg) translate3d(-3%, -2%, 0);
        }

        90% {
            border-radius: 74% 26% 33% 67% / 40% 65% 35% 60%;
        }

        100% {
            border-radius: 48% 52% 68% 32% / 42% 28% 72% 58%;
            transform: rotate(360deg) translate3d(0, 0, 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .bubble {
            animation: none;
            transition: none;
        }

        .bubble-layer {
            transition: none;
        }
    }
</style>
