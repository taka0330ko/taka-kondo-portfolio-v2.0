---
import ThemeToggle from "../ui/ThemeToggle.astro";
import Logo from "../../assets/images/common/kondo-logo-primary.svg";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isAboutPage = pathname === "/about";
const isProjectsPage = [
  "/",
  "/ukg",
  "/tastebuds",
  "/billow",
  "/xeno",
  "/stone-and-honey",
].includes(pathname);
---

<header class="fixed top-0 z-99 w-full bg-linear-to-br bg-theme-gradient px-8 py-4 md:py-2 backdrop-blur-sm">
  <nav class="mx-auto grid max-w-360 grid-cols-3 items-center gap-y-2 md:flex md:h-16 md:justify-between">
    <a href="/" aria-label="Home" class="col-span-3 md:col-span-1">
      <Logo class="h-auto w-36" />
    </a>

    <div class="col-start-1 pl-4 flex justify-center gap-8 md:col-auto md:gap-16">
      <a href="/#projects" data-astro-reload class={`flex items-center gap-2 ${isProjectsPage ? 'text-accent' : 'text-gray-600 hover:text-accent'}`}>
        <span class={`h-2 w-2 rounded-full ${isProjectsPage ? 'bg-accent' : 'invisible'}`}></span>
        Projects
      </a>

      <a href="/about" class={`flex items-center gap-2 ${isAboutPage ? 'text-accent' : 'text-gray-600 hover:text-accent'}`}>
        <span class={`h-2 w-2 rounded-full ${isAboutPage ? 'bg-accent' : 'invisible'}`}></span>
        About
      </a>
    </div>

    <div class="col-start-3 justify-self-end md:col-auto">
      <ThemeToggle />
    </div>
  </nav>
</header>
