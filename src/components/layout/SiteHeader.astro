---
import ThemeToggle from "../ui/ThemeToggle.astro";
import Logo from "../../assets/images/common/kondo-logo-primary.svg";
import MenuBar from "../ui/MenuBar.astro";
import MobileMenuPanel from "../ui/MobileMenuPanel.astro";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isAboutPage = pathname === "/about";
const isProjectsPage = [
  "/",
  "/ukg",
  "/tastebuds",
  "/billow",
  "/xeno",
  "/stone-and-honey",
].includes(pathname);
---

<header class="fixed top-0 z-99 w-full bg-linear-to-br bg-theme-gradient px-8 py-4 md:py-2 backdrop-blur-sm">
  <nav class="mx-auto max-w-360 items-center gap-y-2 flex md:h-16 justify-between">
    <a href="/" class="relative z-100 inline-block" aria-label="Home">
      <Logo class="h-auto w-36 md:w-48" />
    </a>

    <div class="hidden md:flex justify-center gap-8 md:gap-16">
      <a
        href="/#projects"
        data-astro-reload
        class={`relative pb-1 transition-colors ${isProjectsPage ? 'text-accent' : 'text-foreground hover:text-accent'}`}
      >
        Projects
        <span
          class={`absolute bottom-0 left-0 h-px w-full rounded-full transition-opacity ${isProjectsPage ? 'bg-accent opacity-100' : 'bg-accent opacity-0'}`}
        ></span>
      </a>

      <a
        href="/about"
        class={`relative pb-1 transition-colors ${isAboutPage ? 'text-accent' : 'text-foreground hover:text-accent'}`}
      >
        About
        <span
          class={`absolute bottom-0 left-0 h-px w-full rounded-full transition-opacity ${isAboutPage ? 'bg-accent opacity-100' : 'bg-accent opacity-0'}`}
        ></span>
      </a>
    </div>

    <div class="relative z-100 flex items-center gap-4 justify-self-end ">
      <ThemeToggle />
      <div class="md:hidden pb-2">
        <MenuBar/>
      </div>
    </div>
  </nav>
  <MobileMenuPanel/>
</header>
