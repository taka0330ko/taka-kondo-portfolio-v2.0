---
import ThemeToggle from "../ui/ThemeToggle.astro";
import Logo from "../../assets/images/common/kondo-logo-primary.svg";
import MenuBar from "../ui/MenuBar.astro";
import MobileMenuPanel from "../ui/MobileMenuPanel.astro";
import LanguageSwitch from "../ui/LanguageSwitch.astro";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isJapanese = pathname === "/jp" || pathname.startsWith("/jp/");
const localizedPathname = isJapanese
  ? pathname.replace(/^\/jp(?=\/|$)/, "") || "/"
  : pathname;
const homeHref = isJapanese ? "/jp" : "/";
const projectsHref = isJapanese ? "/jp#projects" : "/#projects";
const aboutHref = isJapanese ? "/jp/about" : "/about";
const archiveHref = isJapanese ? "/jp/archive" : "/archive";
const blogHref = isJapanese ? "/jp/blog" : "/blog";
const isAboutPage = localizedPathname === "/about";
const isArchivePage = [
  "/archive",
  "/xeno",
  "/stone-and-honey",
].includes(localizedPathname);
const isBlogPage = localizedPathname === "/blog" || localizedPathname.startsWith("/blog/");
const isProjectsPage = [
  "/",
  "/ukg",
  "/tastebuds",
  "/billow",
  "/store-map",
].includes(localizedPathname);
---

<header data-home={localizedPathname === "/" ? "true" : undefined} data-at-top={localizedPathname === "/" ? "true" : undefined} data-over-hero={localizedPathname === "/" ? "true" : undefined} class="fixed top-0 z-99 w-full px-8 py-4 md:py-2 backdrop-blur-sm">
  <nav class="mx-auto max-w-360 items-center gap-y-2 flex md:h-16 justify-between">
    <a href={homeHref} class="relative z-100 inline-block" aria-label="Home">
      <Logo class="h-auto w-36 md:w-48" />
    </a>

    <div class="hidden md:flex justify-center gap-8 md:gap-16 font-heading" lang="en">
      <a
        href={projectsHref}
        data-astro-reload
        class={`relative pb-1 transition-colors ${isProjectsPage ? 'text-accent' : 'text-foreground hover:text-accent'}`}
      >
        Projects
        <span
          class={`absolute bottom-0 left-0 h-px w-full rounded-full transition-opacity ${isProjectsPage ? 'bg-accent opacity-100' : 'bg-accent opacity-0'}`}
        ></span>
      </a>

      <a
        href={aboutHref}
        class={`header-top-white relative pb-1 transition-colors ${isAboutPage ? 'text-accent' : 'text-foreground hover:text-accent'}`}
      >
        About
        <span
          class={`absolute bottom-0 left-0 h-px w-full rounded-full transition-opacity ${isAboutPage ? 'bg-accent opacity-100' : 'bg-accent opacity-0'}`}
        ></span>
      </a>

      <a
        href={archiveHref}
        class={`header-top-white relative pb-1 transition-colors ${isArchivePage ? 'text-accent' : 'text-foreground hover:text-accent'}`}
      >
        Archive
        <span
          class={`absolute bottom-0 left-0 h-px w-full rounded-full transition-opacity ${isArchivePage ? 'bg-accent opacity-100' : 'bg-accent opacity-0'}`}
        ></span>
      </a>

      <a
        href={blogHref}
        aria-current={isBlogPage ? "true" : undefined}
        class={`header-top-white relative pb-1 transition-colors ${isBlogPage ? 'text-accent' : 'text-foreground hover:text-accent'}`}
      >
        Blog
        <span
          class={`absolute bottom-0 left-0 h-px w-full rounded-full transition-opacity ${isBlogPage ? 'bg-accent opacity-100' : 'bg-accent opacity-0'}`}
        ></span>
      </a>
    </div>

    <div class="header-controls relative z-100 flex items-center gap-4 justify-self-end">
      <div class="language-control">
        <LanguageSwitch/>
      </div>
      <div class="theme-control">
        <ThemeToggle />
      </div>
      <div class="menu-control md:hidden pb-2">
        <MenuBar/>
      </div>
    </div>
  </nav>
  <MobileMenuPanel/>
</header>

<script>
  const setupHeaderBackground = () => {
    const header = document.querySelector<HTMLElement>('header[data-home="true"]');
    if (!header) return;

    const updateBackground = () => {
      header.toggleAttribute("data-at-top", window.scrollY <= 0);
      const hero = document.querySelector<HTMLElement>(".video-hero");
      const headerRect = header.getBoundingClientRect();
      const heroRect = hero?.getBoundingClientRect();
      header.toggleAttribute("data-over-hero", Boolean(heroRect && heroRect.bottom > headerRect.top && heroRect.top < headerRect.bottom));
    };
    updateBackground();
    window.addEventListener("scroll", updateBackground, { passive: true });
    window.addEventListener("pageshow", updateBackground);
    window.addEventListener("resize", updateBackground);
    const hero = document.querySelector<HTMLElement>(".video-hero");
    const observer = new ResizeObserver(updateBackground);
    if (hero) observer.observe(hero);
    observer.observe(header);
    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("scroll", updateBackground);
      window.removeEventListener("pageshow", updateBackground);
      window.removeEventListener("resize", updateBackground);
      observer.disconnect();
    }, { once: true });
  };

  document.addEventListener("astro:page-load", setupHeaderBackground);
</script>

<style>
  header[data-home="true"][data-at-top] {
    background-color: transparent;
    background-image: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  header[data-home="true"][data-over-hero] .header-top-white:not(:hover),
  header[data-home="true"][data-over-hero] .language-control :global(#language-switch:not(:hover)),
  header[data-home="true"][data-over-hero] .language-control :global(#another-lang a:not(:hover)) {
    color: #fff;
  }

  @media (max-width: 480px) {
    .header-controls {
      display: grid;
      grid-template-columns: auto auto;
      column-gap: 1rem;
      row-gap: 0.25rem;
      align-items: center;
    }

    .theme-control {
      grid-column: 1;
      grid-row: 1;
    }

    .menu-control {
      grid-column: 2;
      grid-row: 1;
    }

    .language-control {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: end;
    }
  }
</style>
