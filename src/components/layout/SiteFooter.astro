     <div class="flex items-center gap-4">
      <AstroIcon class="w-6 h-6 text-foreground" />       
      <TailwindIcon class="w-6 h-6 text-foreground" />       
     </div>
        <p class='text-heading-default'>© {year} Taka Kondo</p>
        <nav class="flex gap-6 text-heading-default items-center">
          <!-- <span class="flex items-center gap-2">Resume</span> -->
          <a class="hover:text-accent" href="https://www.linkedin.com/in/takanarikondo/">LinkedIn</a>
          <a class="hover:text-accent" href="https://github.com/Taka0330-jp">GitHub</a>
        </nav>
    </div>
</footer>
