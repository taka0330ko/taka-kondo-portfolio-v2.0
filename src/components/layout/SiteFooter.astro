---
import { Github, Linkedin, FileText } from "@lucide/astro";
import AstroIcon from "../../assets/images/icons/astro-logo-icon.svg";
import TailwindIcon from "../../assets/images/common/tailwind.svg";
---

<footer class='bg-footer w-full z-999 sticky top-full'>
    <div class=' max-w-360 mx-auto px-8 py-4 flex justify-between'>
     <div class="flex items-center gap-4">
      <AstroIcon class="w-6 h-6 text-icons" />       
      <TailwindIcon class="w-6 h-6 text-icons" />       
     </div>
        <p class='text-heading-default'>© 2026 Taka Kondo</p>
        <nav class="flex gap-6 text-heading-default items-center">
          <span class="flex items-center gap-2"><FileText class="w-4 h-4" />Resume</span>
          <span class="flex items-center gap-2"><Linkedin class="w-4 h-4" />LinkedIn</span>
          <span class="flex items-center gap-2"><Github class="w-4 h-4" />GitHub</span>
        </nav>
    </div>
</footer>