---
import AstroIcon from "../../assets/images/icons/astro-logo-icon.svg";
import TailwindIcon from "../../assets/images/common/tailwind.svg";
import { ArrowUpRight } from "@lucide/astro";
const year = new Date().getFullYear();
const isJapanese = Astro.url.pathname === "/jp" || Astro.url.pathname.startsWith("/jp/");
const privacyHref = isJapanese ? "/jp/privacy-policy" : "/privacy-policy";

---

<footer class='bg-footer w-full z-999 sticky top-full font-heading' lang="en">
    <div class=' max-w-360 mx-auto px-8 py-4 flex flex-col gap-6 md:flex-row md:items-center justify-between'>
     <div class="flex items-center gap-4">
      <AstroIcon class="w-6 h-6 text-foreground" />       
      <TailwindIcon class="w-6 h-6 text-foreground" />       
     </div>
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:gap-12">
          <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-3 text-heading-default items-center">
            <a class="hover:text-accent hover:underline underline-offset-4" href={privacyHref} aria-current={Astro.url.pathname.replace(/\/+$/, "") === privacyHref ? "page" : undefined}>Privacy Policy</a>
            <a class="inline-flex items-center gap-1 hover:text-accent" href="https://www.linkedin.com/in/takanarikondo/">
              LinkedIn
              <ArrowUpRight class="size-4" aria-hidden="true" />
            </a>
            <a class="inline-flex items-center gap-1 hover:text-accent" href="https://github.com/taka0330ko">
              GitHub
              <ArrowUpRight class="size-4" aria-hidden="true" />
            </a>
          </nav>
          <p class='text-heading-default'>© {year} Taka Kondo</p>
        </div>
    </div>
</footer>
