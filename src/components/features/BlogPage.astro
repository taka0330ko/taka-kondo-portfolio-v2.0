---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BlogObject from "../../assets/images/blog/blog-page-object.png";
import BlogCardGrid from "../layout/BlogCardGrid.astro";
import type { BlogContent } from "../../content/blog.types";

interface Props {
    content: BlogContent;
    posts: {
        href: string;
        title: string;
        description: string;
        date: string;
        cover?: ImageMetadata;
        coverAlt?: string;
        coverVideo?: string;
        coverVideoFallback?: string;
        transitionKey: string;
    }[];
}

const { content, posts } = Astro.props;
---

<main>
    <section id="blog-hero" aria-labelledby="blog-title">
        <div class="blog-hero-grid grid-container">
            <div class="blog-intro">
                <h1 id="blog-title">{content.hero.title}</h1>
                <p>{content.hero.introLines.map((line) => <>{line}<br /></>)}</p>
            </div>
            <div class="blog-object mt-16 md:mt-0">
                <Image src={BlogObject} alt={content.hero.imageAlt} />
            </div>
        </div>
    </section>
    <section id="blog-list" class="blog-list-inner grid-container">
        <div class="col-span-full">
            <BlogCardGrid posts={posts} emptyLabel={content.list.emptyLabel} />
        </div>
    </section>
</main>

<style>
    #blog-hero {
        min-height: 100svh;
        overflow: hidden;
    }

    .blog-list-inner {
        padding-block: clamp(2rem, 6vh, 5rem);
    }

    .blog-hero-grid {
        min-height: calc(100svh - 6rem);
        padding-block: clamp(2rem, 6vh, 5rem);
    }

    .blog-intro {
        z-index: 1;
        align-self: end;
    }

    .blog-intro h1 {
        font-family: var(--font-satoshi), sans-serif;
        font-size: clamp(3.5rem, 8vw, 7rem);
        font-weight: 400;
        line-height: 0.9;
    }

    .blog-intro p {
        margin-top: 1.5rem;
        color: var(--text-heading-default);
        font-size: clamp(1.125rem, 2vw, 1.75rem);
        line-height: 1.35;
    }

    .blog-intro p:lang(ja) {
        margin-top: 1.5rem;
        color: var(--text-heading-default);
        font-size: clamp(1.125rem, 2vw, 1.75rem);
        font-weight: 300;
        letter-spacing: 1.3;
        line-height: 1.35;
    }

    .blog-object {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
    }

    .blog-object :global(img) {
        width: 80%;
        height: auto;
    }

    @media (width < 768px) {
        .blog-hero-grid {
            justify-content: space-between;
        }

        .blog-intro {
            order: 2;
            align-self: start;
        }

        .blog-object {
            order: 1;
            width: min(100%, 30rem);
            margin-inline: auto;
        }
    }

    @media (width >= 768px) {
        .blog-intro {
            grid-column: 1 / span 4;
            padding-bottom: clamp(1rem, 5vh, 4rem);
        }

        .blog-object {
            grid-column: 7 / span 5;
            align-self: center;
        }
    }
</style>
