---
import { Github, Linkedin, Mail } from "@lucide/astro";
import IconHover from "../ui/IconHover.astro";
import GoToProjectsLinkBtn from "../ui/GoToProjectsLinkBtn.astro";
---

<div class="grid grid-cols-1 md:grid-cols-12 md:grid-rows-2 mt-16 md:mt-28">
  <div class="md:col-span-8 md:row-span-2 flex items-center">
    <h1 class="hero-title">
      Taka bridges<br />
      <span class="reveal-text">Design</span>
      and
      <span class="reveal-text">Development</span><br />
      through collaboration to<br />
      create
      <span class="reveal-text">user-centered</span>
      products.
    </h1>
  </div>

  <div
    class="icons md:col-start-10 md:col-span-3 md:row-start-1 flex items-center justify-center gap-16 mt-8 md:mt-0"
  >
    <IconHover
      href="https://github.com/taka0330ko"
      aria-label="GitHub profile"
      label="GitHub"
    >
      <Github />
    </IconHover>

    <IconHover
      href="https://www.linkedin.com/in/takanarikondo/"
      aria-label="LinkedIn profile"
      label="LinkedIn"
    >
      <Linkedin />
    </IconHover>

    <IconHover
      href="mailto:gtakanari0330@gmail.com"
      aria-label="Send email"
      label="Email"
    >
      <Mail />
    </IconHover>
  </div>

  <div
    class="md:col-start-10 md:col-span-3 md:row-start-2 flex justify-center items-center mt-12 md:mt-0"
  >
    <GoToProjectsLinkBtn />
  </div>
</div>

<style>
  .reveal-text {
    background: linear-gradient(
      to right,
      var(--color-accent) 0%,
      var(--color-accent) 50%,
      currentColor 50%,
      currentColor 100%
    );

    background-size: 200% 100%;
    background-position: 100% 0;

    -webkit-background-clip: text;
    background-clip: text;
    color: inherit;
    -webkit-text-fill-color: transparent;

    display: inline-block;
    line-height: 1.08;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero-title {
    line-height: 1.12;
    overflow: visible;
  }
</style>

<script>
  import { gsap } from "gsap";

  const runHeroAnimation = () => {
    const textEl = document.querySelector(".hero-title");
    const iconsEl = document.querySelector(".icons");

    if (!textEl) return;

    gsap.killTweensOf(textEl);
    if (iconsEl) gsap.killTweensOf(iconsEl);

    gsap.fromTo(
      textEl,
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        clearProps: "opacity,transform",
      },
    );

    if (iconsEl) {
      gsap.fromTo(
        iconsEl,
        { opacity: 0, y: 25 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: 0.3,
          ease: "power2.out",
          clearProps: "opacity,transform",
        },
      );
    }

    const revealTexts = gsap.utils.toArray<HTMLElement>(".reveal-text");

    gsap.set(revealTexts, {
      backgroundPosition: "100% 0",
    });

    gsap.to(revealTexts, {
      backgroundPosition: "0% 0%",
      duration: 1,
      delay: 0.45,
      stagger: 0.15,
      ease: "power2.out",
    });
  };

  document.addEventListener("astro:page-load", runHeroAnimation);
</script>
