---
import RippleEffectRings from "../webGL/RippleEffectRings";
import { Mail } from "@lucide/astro";
import { GithubIcon, LinkedinIcon } from "../../data/icons";
import IconHover from "../ui/IconHover.astro";
import GoToProjectsLinkBtn from "../ui/GoToProjectsLinkBtn.astro";
---

<div class="home-hero-grid">
  <div class="hero-copy">
    <h1 class="hero-title">
      Taka bridges<br />
      <span class="reveal-text">Design</span>
       &nbsp;and&nbsp;
      <span class="reveal-text">Development </span><br />
      through collaboration to<br />
      create&nbsp;
      <span class="reveal-text">user-centred</span>
      products.
    </h1>
  </div>

  <div class="hero-rings" aria-hidden="true">
    <RippleEffectRings client:visible />
  </div>

  <div class="hero-socials">
    <IconHover
      href="https://github.com/taka0330ko"
      aria-label="GitHub profile"
      label="GitHub"
    >
      <GithubIcon />
    </IconHover>

    <IconHover
      href="https://www.linkedin.com/in/takanarikondo/"
      aria-label="LinkedIn profile"
      label="LinkedIn"
    >
      <LinkedinIcon />
    </IconHover>

    <IconHover
      href="mailto:gtakanari0330@gmail.com"
      aria-label="Send email"
      label="Email"
    >
      <Mail />
    </IconHover>
  </div>

  <div class="hero-cta">
    <GoToProjectsLinkBtn />
  </div>
</div>

<style>
  .home-hero-grid {
    display: grid;
    min-height: calc(100svh - 9rem);
    max-width: 90rem;
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "rings"
      "copy"
      "socials"
      "cta";
    align-items: center;
    gap: 2rem;
  }

  .hero-copy {
    grid-area: copy;
    min-width: 0;
  }

  .hero-rings {
    grid-area: rings;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .hero-socials {
    grid-area: socials;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .hero-cta {
    grid-area: cta;
    display: flex;
    justify-content: center;
  }

  .reveal-text {
    background: linear-gradient(
      to right,
      var(--color-accent) 0%,
      var(--color-accent) 50%,
      currentColor 50%,
      currentColor 100%
    );

    background-size: 200% 100%;
    background-position: 100% 0;

    -webkit-background-clip: text;
    background-clip: text;
    color: inherit;
    -webkit-text-fill-color: transparent;

    display: inline-block;
    line-height: 1.08;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero-title {
    line-height: 1.12;
    overflow: visible;
  }

  @media (width >= 768px) {
    .home-hero-grid {
      min-height: calc(100svh - 8.5rem);
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: minmax(20rem, 1fr) minmax(5rem, auto) minmax(6rem, auto);
      grid-template-areas:
        "copy copy copy copy copy copy copy rings rings rings rings rings"
        "copy copy copy copy copy copy copy socials socials socials socials socials"
        ". . . . . cta cta . . . . .";
      column-gap: 1.5rem;
      row-gap: clamp(1.5rem, 4vh, 3.5rem);
    }

    .hero-copy {
      align-self: end;
      padding-bottom: clamp(0rem, 5vh, 3rem);
    }

    .hero-title {
      max-width: 56rem;
    }

    .hero-rings {
      align-self: center;
      justify-content: center;
    }

    .hero-socials {
      align-self: start;
    }

    .hero-cta {
      align-self: start;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const runHeroAnimation = () => {
    const textEl = document.querySelector(".hero-title");
    const iconsEl = document.querySelector(".hero-socials");

    if (!textEl) return;

    gsap.killTweensOf(textEl);
    if (iconsEl) gsap.killTweensOf(iconsEl);

    gsap.fromTo(
      textEl,
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        clearProps: "opacity,transform",
      },
    );

    if (iconsEl) {
      gsap.fromTo(
        iconsEl,
        { opacity: 0, y: 25 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          delay: 0.3,
          ease: "power2.out",
          clearProps: "opacity,transform",
        },
      );
    }

    const revealTexts = gsap.utils.toArray<HTMLElement>(".reveal-text");

    gsap.set(revealTexts, {
      backgroundPosition: "100% 0",
    });

    gsap.to(revealTexts, {
      backgroundPosition: "0% 0%",
      duration: 1,
      delay: 0.45,
      stagger: 0.15,
      ease: "power2.out",
    });
  };

  document.addEventListener("astro:page-load", runHeroAnimation);
</script>
