---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const rotations = Array.from({ length: 32 }, () => `${Math.random() * 180}deg`);
---

<div class:list={["square-ring", className]} aria-hidden="true">
  <div class="square-ring-spin">
    {rotations.map((rotation) => <span style={`--rotation: ${rotation}`} />)}
  </div>
</div>

<style>
  .square-ring {
    position: var(--ring-position, relative);
    width: var(--ring-width, 100%);
    aspect-ratio: 1;
  }

  .square-ring-spin {
    position: absolute;
    inset: 0;
  }

  .square-ring-spin span {
    position: absolute;
    inset: 15%;
    border: 1.2px solid var(--accent-bg-lines);
    transform: rotate(var(--rotation));
    transform-origin: center;
    pointer-events: none;
  }
</style>
