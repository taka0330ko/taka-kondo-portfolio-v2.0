---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const rotations = Array.from({ length: 64 }, () => `${Math.random() * 180}deg`);
---

<div class:list={["square-ring", className]} aria-hidden="true">
  {rotations.map((rotation) => <span style={`--rotation: ${rotation}`} />)}
</div>

<style>
  .square-ring {
    width: var(--ring-width, min(80vw, 22rem));
    aspect-ratio: 1;
  }

  .square-ring span {
    position: absolute;
    inset: 15%;
    border: .5px solid var(--five-lines);
    transform: rotate(var(--rotation));
    transform-origin: center;
    pointer-events: none;
  }
</style>
