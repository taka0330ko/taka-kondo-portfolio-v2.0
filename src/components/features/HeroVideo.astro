---
interface Props {
  title: string;
  description: string;
  lang?: "en" | "ja";
}

const { title, description, lang = "en" } = Astro.props;
---

<section class="video-hero" aria-labelledby="home-title">
  <div class="sr-only">
    <h1 id="home-title">{title}</h1>
    <p>{description}</p>
  </div>
  <video
    class="hero-video"
    width="1920"
    height="1080"
    poster="/videos/hero/hero-poster-v4.jpg"
    preload="metadata"
    muted
    loop
    playsinline
    aria-label={lang === "ja" ? "近藤嵩成のデザイン・開発紹介動画" : "Takanari Kondo design and development introduction"}
  >
    <source src="/videos/hero/hero-video-v4-1080p.mp4" type="video/mp4" />
    <p>{description}</p>
  </video>
</section>

<style>
  /* Prevent elastic scrolling from exposing the page backing on Home. */
  :global(html:has(.video-hero)),
  :global(body:has(.video-hero)) {
    overscroll-behavior-y: none;
  }

  .video-hero {
    --hero-surface: #000;
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    padding-top: 0;
    margin-bottom: clamp(4rem, 8vw, 8rem);
    background: var(--hero-surface);
    /* Continue the hero backing beneath the offset bottom fade. */
    box-shadow: 0 4rem 0 var(--hero-surface);
  }

  :global(html.light) .video-hero {
    --hero-surface: #303238;
  }

  .video-hero::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    height: clamp(4rem, 12svh, 9rem);
    z-index: 1;
    pointer-events: none;
  }

  .video-hero::after {
    bottom: -4rem;
    background: linear-gradient(to top, var(--bg-default), transparent);
  }

  .hero-video {
    --hero-side-mask: linear-gradient(#000, #000);
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center top;
    background: var(--hero-surface);
    -webkit-mask-image: var(--hero-side-mask), linear-gradient(to bottom, #000 0%, #000 96%, transparent);
    mask-image: var(--hero-side-mask), linear-gradient(to bottom, #000 0%, #000 96%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .hero-video.has-side-bars {
    --hero-side-mask: linear-gradient(to right, transparent, #000 2%, #000 98%, transparent);
  }
</style>

<script>
  const setupHeroVideo = () => {
    const video = document.querySelector<HTMLVideoElement>(".hero-video");
    if (!video) return;

    const hero = video.closest<HTMLElement>(".video-hero");
    if (!hero) return;

    const updateSideFade = () => {
      const ratio = video.videoWidth && video.videoHeight
        ? video.videoWidth / video.videoHeight
        : 1920 / 1080;
      const hasSideBars = hero.clientWidth > video.clientHeight * ratio + 1;
      video.classList.toggle("has-side-bars", hasSideBars);
    };
    const resizeObserver = new ResizeObserver(updateSideFade);
    resizeObserver.observe(hero);
    resizeObserver.observe(video);
    video.addEventListener("loadedmetadata", updateSideFade);
    updateSideFade();

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const updatePlayback = () => {
      video.autoplay = !reducedMotion.matches;
      if (reducedMotion.matches) {
        video.pause();
      } else {
        video.muted = true;
        void video.play().catch(() => {
          // Keep the poster visible when autoplay is blocked.
        });
      }
    };

    updatePlayback();
    reducedMotion.addEventListener("change", updatePlayback);
    document.addEventListener("astro:before-swap", () => {
      video.pause();
      resizeObserver.disconnect();
      video.removeEventListener("loadedmetadata", updateSideFade);
      reducedMotion.removeEventListener("change", updatePlayback);
    }, { once: true });
  };

  document.addEventListener("astro:page-load", setupHeroVideo);
</script>
