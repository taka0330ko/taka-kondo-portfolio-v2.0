---
import RippleEffectRings from "../webGL/RippleEffectRings";
import { Mail } from "@lucide/astro";
import { GithubIcon, LinkedinIcon } from "../../data/icons";
import IconHover from "../ui/IconHover.astro";
import GoToProjectsLinkBtn from "../ui/GoToProjectsLinkBtn.astro";
import type { HeroContent } from "../../content/home.types";

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<div class="jp-hero-grid">
  <div class="jp-hero-content mt-12">
    <div class="jp-hero-copy">
      <h1 class="jp-hero-name">{content.name}</h1>
      <p class="jp-hero-role">{content.role}</p>
    </div>

    <div class="jp-hero-rings" aria-hidden="true">
      <RippleEffectRings client:visible />
    </div>

    <div class="jp-hero-socials">
      <IconHover
        href="https://github.com/taka0330ko"
        aria-label="GitHub profile"
        label="GitHub"
      >
        <GithubIcon />
      </IconHover>

      <IconHover
        href="https://www.linkedin.com/in/takanarikondo/"
        aria-label="LinkedIn profile"
        label="LinkedIn"
      >
        <LinkedinIcon />
      </IconHover>

      <IconHover
        href="mailto:gtakanari0330@gmail.com"
        aria-label={content.emailAriaLabel}
        label="Email"
      >
        <Mail />
      </IconHover>
    </div>
  </div>

  <div class="jp-hero-cta">
    <GoToProjectsLinkBtn label={content.projectsLabel} ariaLabel={content.projectsAriaLabel} />
  </div>
</div>

<style>
  .jp-hero-grid {
    display: grid;
    min-height: calc(100svh - 9rem);
    max-width: 90rem;
    margin-inline: auto;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-content: center;
    gap: clamp(2rem, 5vh, 4rem) 1.5rem;
  }

  .jp-hero-content {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .jp-hero-copy {
    order: 2;
    min-width: 0;
    text-align: center;
  }

  .jp-hero-name {
    font-family: "Yu Mincho", "Hiragino Mincho ProN", serif;
    font-size: clamp(2.25rem, 4vw, 5.25rem);
    font-weight: 500;
    letter-spacing: clamp(0.08em, 0.4vw, 0.22em);
    line-height: 1.4;
  }

  .jp-hero-role {
    margin-top: clamp(1.5rem, 4vh, 3.25rem);
    color: var(--color-heading-default);
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.6vw, 1.25rem);
    letter-spacing: 0.14em;
  }

  .jp-hero-rings {
    order: 1;
    display: flex;
    width: 100%;
    min-width: 0;
    justify-content: center;
  }

  .jp-hero-socials {
    order: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .jp-hero-cta {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
  }

  @media (width >= 768px) {
    .jp-hero-grid {
      min-height: calc(100svh - 8.5rem);
    }

    .jp-hero-content {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      gap: 1.5rem;
    }

    .jp-hero-copy {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
      align-self: center;
    }

    .jp-hero-rings {
      grid-column: 8 / -1;
      grid-row: 1;
    }

    .jp-hero-socials {
      grid-column: 8 / -1;
      grid-row: 2;
    }

    .jp-hero-name,
    .jp-hero-role {
      white-space: nowrap;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const runJapaneseHeroAnimation = () => {
    const elements = document.querySelectorAll(
      ".jp-hero-copy, .jp-hero-rings, .jp-hero-socials",
    );

    if (!elements.length) return;

    gsap.killTweensOf(elements);
    gsap.fromTo(
      elements,
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: "power2.out",
        clearProps: "opacity,transform",
      },
    );
  };

  document.addEventListener("astro:page-load", runJapaneseHeroAnimation);
</script>
