---
// Layout
import Layout from "../layouts/Layout.astro";

//UI
import BreadCrumb from "../components/ui/BreadCrumb.astro";
import GlassPill from "../components/ui/GlassPill.astro";
import CaseStudySidebar from "../components/ui/CaseStudySidebar.astro";
import Card from "../components/ui/Card.astro";
import CodeWindow from "../components/ui/CodeWindow.astro";
import ProjectMainVideo from "../components/ui/ProjectMainVideo.astro";
import PlayButton from "../components/ui/PlayButton.astro";

// Images
import Image from "astro/components/Image.astro";
import Hackathon from "../assets/images/projects/billow/hackathon.png";
import Billow_MVP from "../assets/images/projects/billow/bilow-mvp.png";
import Diagram from "../assets/images/projects/billow/diagram.png";
import Diagram_SoC from "../assets/images/projects/billow/diagram-soc.png";

//Videos
import CoverVideo from "../assets/images/projects/billow/videos/billow-cover-video.webm";
import CoverVideoMp4 from "../assets/images/projects/billow/videos/billow-cover-video.mp4";
import CoverVideoPoster from "../assets/images/projects/billow/videos/billow-cover-video-poster.webp";
import MVPVideo from "../assets/images/projects/billow/videos/billow-mvp.webm";
import MVPVideoMp4 from "../assets/images/projects/billow/videos/billow-mvp.mp4";

// Icon
import { ArrowUpRight, TriangleAlert } from "@lucide/astro";

import { projects } from "../data/projects";

import {
    summaryCodeMVP,
    viewCode,
    logicCode,
    serviceCode,
    stateCode,
} from "../data/billowCode.ts";
import DefinitionCard from "../components/ui/DefinitionCard.astro";
import { NextJS, ReactLogo, Tailwind, TypeScript } from "../data/icons";

export const billowSections = [
    { label: "Overview", href: "#Overview" },
    { label: "Problem", href: "#Problem" },
    { label: "Approach", href: "#Approach" },
    { label: "Reflection", href: "#Reflection" },
];

// Definition card content
export const cardContents = [
    {
        title: "View",
        body: "Responsible for rendering the UI and layout, with no business logic",
        ex: "e.g. message list, chat input form, loading indicator",
        className: "bg-blue-300",
        data: "view",
    },
    {
        title: "Logic",
        body: "Manages chat flow, side effects, and user interactions",
        ex: "e.g. handling message submission, managing loading state, triggering AI responses",
        className: "bg-green-300",
        data: "logic",
    },
    {
        title: "Service",
        body: "Encapsulates AI communication and external API calls",
        ex: "e.g. calling AI API, formatting requests, parsing responses",
        className: "bg-yellow-300",
        data: "service",
    },
    {
        title: "State",
        body: "Manages shared conversation data across components",
        ex: "e.g. chat messages store, current chat room state, global state (Zustand)",
        className: "bg-red-300",
        data: "state",
    },
];
---

<Layout>
    <main class="mt-30 md:mt-40">
        <div class="container pl-8">
            <BreadCrumb>Billow</BreadCrumb>
        </div>
        <section id="hero" aria-labelledby="billow-overview">
            <div class="grid grid-cols-12 grid-container items-start">
                <div class="col-span-8">
                    <h1 id="billow-overview" class="mt-8">
                        AI Chat Base Subscription Management Dashboard
                    </h1>
                    <p class="flex mt-8">
                        Originally built during a hackathon, the first version prioritized speed over structure, resulting in tightly coupled UI, state, and API logic that became difficult to debug and scale. Through rebuilding the project, I learned the importance of separation of concerns and restructured the application into a more maintainable and scalable AI dashboard.
                    </p>
                    <div class="mt-8 md:my-8">
                        <GlassPill
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Open Billow live site in a new tab"
                            href="https://billow-tau.vercel.app/"
                        >
                            <ArrowUpRight
                                slot="after"
                                aria-hidden="true"
                                focusable="false"
                            />
                            Prototype
                            <span class="sr-only">(opens in a new tab)</span>
                        </GlassPill>
                    </div>
                </div>
                <dl
                    class="order-3 md:order-2 grid gap-4 border-l-2 border-accent pl-6 md:min-w-64 mt-16 md:col-span-4"
                >
                    <div class="grid gap-2">
                        <dt
                            class="text-caption uppercase tracking-wide text-body-default"
                        >
                            Core Stacks
                        </dt>
                        <dd
                            class="flex items-center gap-2"
                            aria-label="Technologies used in this project"
                        >
                            <ReactLogo class="w-6 h-6" />
                            <TypeScript class="w-6 h-6" />
                            <Tailwind class="w-6 h-6" />
                            <NextJS class="w-6 h-6 text-foreground" />
                        </dd>
                    </div>
                    <div class="grid gap-1">
                        <dt
                            class="text-caption uppercase tracking-wide text-body-default"
                        >
                            Role
                        </dt>
                        <dd class="text-body font-medium text-heading-default">
                            UI Designer / Front-end Developer
                        </dd>
                    </div>
                    <div class="grid gap-1">
                        <dt
                            class="text-caption uppercase tracking-wide text-body-default"
                        >
                            Timeline
                        </dt>
                        <dd class="text-body font-medium text-heading-default">
                            One month, Apr-May, 2026ding
                        </dd>
                    </div>
                </dl>
                <div class="order-2 md:order-3 col-span-12">
                    <ProjectMainVideo src={CoverVideo} fallbackSrc={CoverVideoMp4} poster={CoverVideoPoster.src} />
                </div>
            </div>
        </section>
        <!-- ====================== Case Study Start ====================== -->
        <section class="mt-32">
            <div class="flex flex-col max-w-360 mx-auto lg:grid grid-cols-12">
                <aside
                    aria-label="Project section navigation"
                    class="col-start-1 col-span-2 p-4 sticky top-24 h-fit"
                >
                    <CaseStudySidebar
                        items={billowSections}
                        className="col-start-1 col-span-2"
                    />
                </aside>
                <div class="px-4 md:px-8 md:col-start-3 col-span-10">
                    <section id="Overview" class="">
                        <h2 class="font-semibold">
                            <span class="heading-accent-bar">Overview</span>
                        </h2>
                        <div class="text-box">
                            <h3 class="pb-16">
                                From Hackathon Prototype to Scalable
                                Architecture
                            </h3>
                            <p>
                                This project was originally developed during a
                                hackathon in collaboration with a designer
                                partner. Due to the speed-focused nature of the
                                development, the initial implementation revealed
                                limitations in structure and state management.
                            </p>
                            <div
                                class="overflow-auto flex md:justify-center gap-4 mx-auto pt-8 horizontal-scroll"
                            >
                                <Image
                                    class="w-100"
                                    src={Hackathon}
                                    alt="Hackathon setup with two laptops displaying a subscription management dashboard, as developers collaborate side by side."
                                />
                                <Image
                                    class="w-100"
                                    src={Billow_MVP}
                                    alt="Billow prototype landing page"
                                />
                            </div>
                            <p class="pt-8">
                                I later revisited the project from both a design
                                and architectural perspective. Rather than
                                simply replicating the UI, I restructured the
                                system around managing complex state and
                                interactions, rebuilding it into a scalable
                                front-end architecture.
                            </p>
                        </div>
                    </section>
                    <section id="Problem">
                        <h2 class="font-semibold">
                            <span class="heading-accent-bar">Problem</span>
                        </h2>
                        <div class="text-box">
                            <h3>Works, but Not Scalable</h3>
                            <p>
                                In the hackathon version, the priority was to
                                quickly deliver a working AI chat experience. As
                                a result, UI rendering, state management, send
                                logic, and API communication were all
                                concentrated within a single component.
                            </p>
                            <div
                                class="lg:flex items-center gap-16 justify-center py-8"
                            >
                                <PlayButton class="flex justify-center">
                                    <video
                                        class="py-16 w-150"
                                        controls
                                        loop
                                        muted
                                        playsinline>
                                        <source src={MVPVideo} type="video/webm" />
                                        <source src={MVPVideoMp4} type="video/mp4" />
                                    </video>
                                </PlayButton>
                                <div class="flex flex-col gap-4 items-center">
                                    <span class="flex items-center gap-2">
                                        <TriangleAlert
                                            class="text-heading-default"
                                        />
                                        <h4>Everything in One Component</h4>
                                    </span>
                                    <Image
                                        class="max-w-80 max-h-80"
                                        src={Diagram}
                                        alt="Diagram showing all chat logic combined in a single Chat.jsx component"
                                    />
                                </div>
                            </div>
                            <p>
                                While this structure was sufficient for a
                                prototype, the boundaries between
                                responsibilities were unclear, and separation of
                                concerns was lacking. API communication, local
                                state, event handling, and UI rendering were
                                tightly coupled, which made the code difficult
                                to read, maintain, and scale.
                            </p>
                            <div class="max-w-200 mx-auto mt-16">
                                <p class="py-4 text-center">
                                    Simplified version of the original code ↓
                                </p>
                                <CodeWindow code={summaryCodeMVP} lang="js" />
                            </div>
                        </div>
                        <section id="Approach" class="">
                            <h2 class="font-semibold">
                                <span class="heading-accent-bar">Approach</span>
                            </h2>
                            <div class="text-box">
                                <section>
                                    <div
                                        class="flex flex-col md:grid grid-cols-4 gap-4 place-items-center"
                                    >
                                        <div class="col-span-2">
                                            <h3 class="mb-4">
                                                Architecture Decision
                                            </h3>
                                            <p>
                                                To make the chat feature
                                                scalable, I first defined clear
                                                responsibility boundaries for
                                                the architecture. Instead of
                                                separating code by file size or
                                                UI sections, I reorganized it by
                                                concern: View, Logic, Service,
                                                and State.
                                            </p>
                                        </div>
                                        <div
                                            class="col-span-2 col-start-3 lg:max-w-130"
                                        >
                                            <Image src={Diagram_SoC} alt="Diagram showing the chat feature separated into View, Logic, Service, and State layers" />
                                        </div>
                                    </div>
                                </section>
                                <section class="mt-16">
                                    <!-- title and carousel box -->
                                    <div>
                                        <h3 class="mb-4">Definition</h3>
                                        <!-- carousel box -->
                                        <div
                                            data-definition-card-group
                                            class="flex gap-4 overflow-x-auto lg:grid grid-cols-2 grid-rows-2 lg:overflow-visible"
                                        >
                                            <DefinitionCard
                                                contents={cardContents}
                                            />
                                        </div>
                                    </div>

                                    <div class="w-full mt-8">
                                        <div data-panel="view">
                                            <h4 class="mb-4 text-center">
                                                View: Assembles and renders the
                                                UI
                                            </h4>
                                            <CodeWindow
                                                code={viewCode}
                                                lang="tsx"
                                            />
                                        </div>
                                        <div data-panel="logic">
                                            <h4 class="mb-4 text-center">
                                                Logic: Controls message
                                                submission and side effects
                                            </h4>
                                            <CodeWindow
                                                code={logicCode}
                                                lang="tsx"
                                            />
                                        </div>
                                        <div data-panel="service">
                                            <h4 class="mb-4 text-center">
                                                Service: Abstracts AI
                                                communication
                                            </h4>
                                            <CodeWindow
                                                code={serviceCode}
                                                lang="tsx"
                                            />
                                        </div>
                                        <div data-panel="state">
                                            <h4 class="mb-4 text-center">
                                                State: Shares conversation data
                                                across components
                                            </h4>
                                            <CodeWindow
                                                code={stateCode}
                                                lang="tsx"
                                            />
                                        </div>
                                    </div>
                                </section>
                                <p class="mt-16">
                                    As the feature evolved to support multiple
                                    chat rooms, conversation data needed to be
                                    shared beyond a single component. This made
                                    local state insufficient, so shared
                                    conversation data was moved into a
                                    centralized Zustand store.
                                </p>
                            </div>
                        </section>
                        <section id="Reflection">
                            <h2 class="font-semibold">
                                <span class="heading-accent-bar"
                                    >Reflection</span
                                >
                            </h2>
                            <section class="text-box">
                                <h3>Reevaluating the Development Process</h3>
                                <p class="mt-4">
                                    When I was developing the application during
                                    the hackathon, I prioritized getting it up
                                    and running so much that I didn’t fully
                                    grasp the importance of structural design.
                                    As I revisited this project, my
                                    understanding of the importance of design,
                                    and my approach to AI changed significantly.
                                    Rather than simply letting AI create
                                    “something that sort of works,” I’ve started
                                    using it as a tool to assist my
                                    decision-making, guided by a clear design
                                    intent. While AI tools can quickly generate
                                    working code, I’ve come to realize that
                                    understanding the underlying architecture is
                                    essential for writing code that is
                                    maintainable, readable, and scalable. I’ve
                                    also come to find the process of designing
                                    while organizing the structure itself to be
                                    quite engaging.
                                </p>
                                <h3 class="mt-8">
                                    The Gap Between Design and Implementation
                                </h3>
                                <p class="mt-4">
                                    This project also gave me an opportunity to
                                    reconsider the gap between design and
                                    implementation. Even when wireframes and
                                    style guides are well-organized in Figma,
                                    reproducing them accurately as a consistent
                                    UI requires careful implementation
                                    decisions. I was reminded that the process
                                    of bridging design and implementation cannot
                                    yet be fully automated; adjustments and
                                    judgments made by human eyes remain
                                    indispensable and continue to play a vital
                                    role. This project went beyond mere
                                    refactoring; it served as an opportunity to
                                    reevaluate how we utilize AI and how we
                                    translate design intent into implementation.
                                </p>
                            </section>
                        </section>
                    </section>
                </div>
            </div>
        </section>

        <!-- Other Projects -->
        <section class="p-4 md:p-16">
            <h2 class="text-center p-16">Other Projects</h2>
            <div
                class="grid grid-cols-1 md:grid-cols-2 grid-rows-auto gap-4 max-w-400 mx-auto"
            >
                {
                    projects
                        .filter(
                            (project) =>
                                ["/ukg", "/tastebuds", "/billow"].includes(
                                    project.href,
                                ) && project.href !== "/billow",
                        )
                        .slice(0, 2)
                        .map((project) => {
                            return (
                                <Card
                                    href={project.href}
                                    cover={project.cover}
                                    title={project.title}
                                    description={project.description}
                                    tag={project.tag}
                                />
                            );
                        })
                }
            </div>
        </section>
    </main>
</Layout>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("astro:page-load", () => {
        // This script stays loaded across ClientRouter navigations,
        // so bail out on every page except this one.
        if (window.location.pathname.replace(/\/$/, "") !== "/billow") return;

        const refresh = () =>
            requestAnimationFrame(() => ScrollTrigger.refresh());

        const fadeUp = (target: string, trigger: string, start = "top 70%") => {
            gsap.fromTo(
                target,
                {
                    y: 56,
                    opacity: 0,
                    scale: 0.98,
                },
                {
                    y: 0,
                    opacity: 1,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger,
                        start,
                        toggleActions: "play none none reverse",
                        invalidateOnRefresh: true,
                    },
                },
            );
        };

        gsap.fromTo(
            "#case-study-sidebar",
            { x: -32, opacity: 0 },
            {
                x: 0,
                opacity: 1,
                duration: 0.8,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: "#hero",
                    start: "bottom 30%",
                    toggleActions: "play none none reverse",
                    invalidateOnRefresh: true,
                },
            },
        );

        fadeUp("#Overview", "#Overview");
        fadeUp("#Problem", "#Problem");
        fadeUp("#Approach", "#Approach");
        fadeUp("#Reflection", "#Reflection");

        refresh();
        setTimeout(refresh, 300);

        const root = document.querySelector<HTMLElement>(
            "[data-definition-card-group]",
        );
        const tabs = root?.querySelectorAll<HTMLElement>("[data-tab]") ?? [];

        const panels = document.querySelectorAll<HTMLElement>("[data-panel]");

        if (tabs.length === 0 || panels.length === 0) return;

        //  initial state（View）
        const initial = "view";

        panels.forEach((panel) => {
            panel.hidden = panel.dataset.panel !== initial;
        });

        tabs.forEach((tab) => {
            tab.classList.toggle("is-active", tab.dataset.tab === initial);
        });

        // click
        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const target = tab.dataset.tab;
                if (!target) return;

                // switch active
                tabs.forEach((item) => {
                    item.classList.toggle("is-active", item === tab);
                });

                // switch panel
                panels.forEach((panel) => {
                    panel.hidden = panel.dataset.panel !== target;
                });
            });
        });

        const resizeObserver = new ResizeObserver(() => {
            refresh();
        });

        //get code view element for observing
        document.querySelectorAll(".code-view").forEach((el) => {
            resizeObserver.observe(el);
        });

        // "astro:before-swap" -> because of Astro View Transitions, need to cleanup before moving other page
        document.addEventListener(
            "astro:before-swap",
            () => {
                //resizeObserver.disconnect() -> cleanup observer
                resizeObserver.disconnect();
            },
            { once: true },
        );
    });
</script>
