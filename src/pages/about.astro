---
import Layout from "../layouts/Layout.astro";
import RippleEffectMyPic from "../components/webGL/RippleEffectMyPic";
import CopyEmail from "../components/ui/CopyEmail.astro";
import Gallery from "../components/ui/Gallery.astro";
import { X } from "@lucide/astro"
---

<Layout>
  <div class="grid grid-cols-12 grid-container">
    <div class="order-2 md:order-1 col-start-2 col-end-6">
      <section class="md:h-screen flex items-center">
        <div class="md:mt-20">
          <h1 class="text-heading-default text-4xl text-nowrap">
            Hello, I&apos;m Taka
          </h1>
          <div class="text-body-default mt-4">
            <p>
              I&apos;m currently studying New Media Design and Web Development at
              BCIT.
            </p>
            <p>
              As I learn both design and front-end development, I&apos;ve become
              particularly interested in UI/UX that values not only visual appeal,
              but also how ideas are formed and how interfaces function.
            </p>
            <p>
              I enjoy learning new things and find the most satisfaction in
              applying what I&apos;ve learned through hands-on practice
            </p>
          </div>
        </div>
      </section>
      <section class="flex items-center">
        <div class="flex flex-col gap-4">
          <p>
            When I&apos;m not in front of a computer screen, you&apos;ll likely find
            me painting or practicing calligraphy.
          </p>
          <div class="gallery-shell" data-gallery-shell>
            <div class="gallery-modal" data-gallery-modal hidden>
              <div class="gallery-modal__panel glass-card">
                <button
                  class="gallery-modal__close text-heading-default  p-1 hover:bg-accent/50 rounded-full"
                  type="button"
                  data-gallery-modal-close
                  aria-label="Close gallery modal"
                >
                  <X />
                </button>
                <img
                  class="gallery-modal__image"
                  data-gallery-modal-image
                  alt=""
                />
              </div>
            </div>
            <Gallery />
          </div>
        </div>
      </section>
    </div>
    <div class="order-1 md:order-2 col-start-7 col-end-12">
      <div class="md:sticky md:top-50 flex justify-center mt-30">
        <RippleEffectMyPic client:visible />
      </div>
    </div>
  </div>
  <div class="flex justify-center items-center my-20">
    <CopyEmail />
  </div>
</Layout>

<style>
  .gallery-shell {
    position: relative;
  }

  .gallery-modal {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    background: #0000009f;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .gallery-modal[hidden] {
    display: none;
  }

  .gallery-modal.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .gallery-modal__panel {
    display: flex;
    flex-direction: column;
    width: min(100%, 28rem);
    max-height: calc(100% - 2rem);
    overflow: auto;
    border-radius: 8px;
    padding: 1rem;
    transform: translateY(12px);
    opacity: 0;
    transition:
      transform 220ms ease,
      opacity 220ms ease;
  }

  .gallery-modal.is-visible .gallery-modal__panel {
    transform: translateY(0);
    opacity: 1;
  }

  .gallery-modal__close {
    cursor: pointer;
    display: inline-flex;
    align-self: flex-end;
    margin-left: auto;
    margin-bottom: 1rem;
  }

  .gallery-modal__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
</style>
