---
import Layout from "../layouts/Layout.astro";
import Card from "../components/ui/Card.astro";
import ArchiveBackButton from "../components/ui/ArchiveBackButton.astro";
import { projects } from "../data/projects";
import { homeJa } from "../content/ja/home";
import {
    stoneAndHoneyJa,
    stoneAndHoneyJaMeta,
} from "../content/ja/stone-and-honey";

//Images
import HeroImage from "../assets/images/projects/stone-and-honey/hero.webp";
import PackagingDisplay from "../assets/images/projects/stone-and-honey/packaging-display.webp";
import CustomerHoldingJar from "../assets/images/projects/stone-and-honey/customer-holding-jar.webp";
import BrandWords from "../assets/images/projects/stone-and-honey/brand-words.webp";
import MoodBoard from "../assets/images/projects/stone-and-honey/mood-board.webp";
import TypographyColor from "../assets/images/projects/stone-and-honey/typography-color.webp";
import LogoDirection1 from "../assets/images/projects/stone-and-honey/logo-direction-1.webp";
import LogoDirection2 from "../assets/images/projects/stone-and-honey/logo-direction-2.webp";
import LogoDirection3 from "../assets/images/projects/stone-and-honey/logo-direction-3.webp";
import FinalLogoDesign from "../assets/images/projects/stone-and-honey/final-logo-design.webp";
import MerchandiseMockup from "../assets/images/projects/stone-and-honey/merchandise-mockup.webp";
import { Image } from "astro:assets";

const isJapanese = Astro.url.pathname === "/jp/stone-and-honey";
const t = (text: string) => isJapanese ? (stoneAndHoneyJa[text] ?? text) : text;

const relatedProjects = projects
    .filter((project) =>
        ["/ukg", "/tastebuds", "/billow"].includes(project.href) &&
        project.href !== "/stone-and-honey"
    )
    .slice(0, 2)
    .map((project) => isJapanese
        ? {
            ...project,
            ...homeJa.projects[project.slug],
            href: `/jp${project.href}`,
        }
        : project
    );
---

<Layout title={isJapanese ? stoneAndHoneyJaMeta.title : undefined} description={isJapanese ? stoneAndHoneyJaMeta.description : undefined}>
    <main class:list={["px-8 pt-20 pb-24 md:pb-32", { "case-study-ja": isJapanese }]}> 
        <section class="mx-auto flex max-w-360 flex-col gap-20 md:gap-28">
            <Image
                src={HeroImage}
                alt="Stone & Honey brand presentation hero image"
                class="aspect-video w-full max-w-none pointer-events-none"
            />

            <div class="grid gap-10 md:grid-cols-12 md:items-start">
                <div class="md:col-span-8">
                    <h1 class="max-w-220">
                        {t("The branding challenge behind a nut butter brand.")}
                    </h1>
                    <p class="mt-6">
                        {t("The brief was simple: let the ingredients speak for themselves. No added sugar or oil — just the natural flavor of the nuts. Through transparent sourcing and seasonal blends, the goal was a brand trusted by people who care about what's inside the jar.")}
                    </p>
                </div>
                <div class="md:col-span-4 md:flex md:justify-end">
                    <dl class="grid gap-4 border-l border-accent pl-6 md:min-w-64">
                        <div class="grid gap-2">
                            <dt class="text-caption uppercase tracking-wide text-body-default">
                                {t("Tools Used")}
                            </dt>
                            <dd class="flex items-center gap-2" aria-label="Photoshop, Illustrator, and Dimension">
                                <span class="tool-badge tool-badge--ps">Ps</span>
                                <span class="tool-badge tool-badge--ai">Ai</span>
                                <span class="tool-badge tool-badge--dn">Dn</span>
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <Image
                src={PackagingDisplay}
                alt="Stone & Honey jar packaging displayed in a branded countertop box"
                class="w-full rounded-lg"
            />

            <div class="grid gap-8 md:grid-cols-12 md:items-start">
                <p class="md:col-span-8">
                    {t("The target audience is health-conscious men and women aged 25 to 50. Before buying, they check the ingredients, sourcing, and process, valuing purity, honest craftsmanship, and real quality over price.")}
                </p>
                <Image
                    src={CustomerHoldingJar}
                    alt="Customer reading the label on a Stone & Honey jar"
                    class="w-full max-w-60 rounded-lg md:col-span-4 md:col-start-9 md:justify-self-end"
                />
            </div>

            <div class="flex flex-col gap-8">
                <h2>{t("Keywords")}</h2>
                <Image
                    src={BrandWords}
                    alt="Brand word map: authentic, natural, minimal, transparent, pure, handcrafted, earthy, simplicity, honest, sincere"
                    class="w-full rounded-lg"
                />
            </div>

            <div class="flex flex-col gap-8">
                <h2>{t("Mood board")}</h2>
                <Image
                    src={MoodBoard}
                    alt="Stone & Honey mood board"
                    class="w-full max-w-160 mx-auto rounded-lg"
                />
            </div>

            <Image
                src={TypographyColor}
                alt="Stone & Honey typography (Josefin Slab, Archivo) and color palette"
                class="w-full rounded-lg"
            />

            <div class="flex flex-col gap-8">
                <h2>{t("Logo directions")}</h2>
                <div class="mx-auto flex w-full max-w-3xl flex-col gap-8">
                    <div class="grid grid-cols-[1.5rem_minmax(0,1fr)] items-start gap-6">
                        <span class="pt-1 text-title text-body-default">1</span>
                        <Image
                            src={LogoDirection1}
                            alt="Logo direction 1: candle icon mark with Stone & Honey wordmark"
                            class="w-full max-w-2xl rounded-lg"
                        />
                    </div>
                    <div class="grid grid-cols-[1.5rem_minmax(0,1fr)] items-start gap-6">
                        <span class="pt-1 text-title text-body-default">2</span>
                        <Image
                            src={LogoDirection2}
                            alt="Logo direction 2: mountain line mark with Stone & Honey wordmark"
                            class="w-full max-w-2xl rounded-lg"
                        />
                    </div>
                    <div class="grid grid-cols-[1.5rem_minmax(0,1fr)] items-start gap-6">
                        <span class="pt-1 text-title text-body-default">3</span>
                        <Image
                            src={LogoDirection3}
                            alt="Logo direction 3: ST monogram grid mark with Stone & Honey wordmark"
                            class="w-full max-w-2xl rounded-lg"
                        />
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-8">
                <h2>{t("Final design")}</h2>
                <Image
                    src={FinalLogoDesign}
                    alt="Final Stone & Honey logo system: wordmark and SH monogram across light and dark backgrounds"
                    class="w-full rounded-lg"
                />
            </div>

            <Image
                src={MerchandiseMockup}
                alt="Stone & Honey merchandise mockup: tote bag, cap, and jars"
                class="w-full max-w-200 mx-auto rounded-lg"
            />
        </section>

        <ArchiveBackButton />

        <section class="pt-24 md:pt-32">
            <h2 class="text-center p-16">{t("Other Projects")}</h2>
            <div
                class="grid grid-cols-1 md:grid-cols-2 grid-rows-auto gap-4 max-w-400 mx-auto"
            >
                {
                    relatedProjects
                        .map((project) => {
                            return (
                                <Card
                                    href={project.href}
                                    cover={project.cover}
                                    title={project.title}
                                    description={project.description}
                                    tag={project.tag}
                                />
                            );
                        })
                }
            </div>
        </section>
    </main>
</Layout>

<style>
    .tool-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 0.25rem;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.01em;
    }

    .tool-badge--ps {
        background-color: #0c2436;
        color: #4fb6f5;
    }

    .tool-badge--ai {
        background-color: #3b0a0a;
        color: #f79a1e;
    }

    .tool-badge--dn {
        background-color: #0b3d0b;
        color: #3edb53;
    }
</style>
