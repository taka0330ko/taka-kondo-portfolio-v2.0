---
import Layout from "../layouts/Layout.astro";
import BreadCrumb from "../components/ui/BreadCrumb.astro";
import Card from "../components/ui/Card.astro";
import { projects } from "../data/projects";

//Images
import HeroImage from "../assets/images/projects/stone-and-honey/Hero-image.jpg";
import AppMockUp from "../assets/images/projects/stone-and-honey/Mockup-items.jpg";
import JarMockup from "../assets/images/projects/stone-and-honey/Mockup-jar.jpg";
import TrackMockup from "../assets/images/projects/stone-and-honey/MOckup-track.jpg";
import MoodBoard from "../assets/images/projects/stone-and-honey/Moad-board.jpg";
import LogoSheet from "../assets/images/projects/stone-and-honey/logos.jpg";
import PackagingSlide from "../assets/images/projects/stone-and-honey/Slide 16_9 - 33.jpg";
import TypoColor from "../assets/images/projects/stone-and-honey/typo-color.jpg";
import { Image } from "astro:assets";
---

<Layout>
    <main class="px-8 pt-32 pb-24 md:pt-40 md:pb-32">
        <section class="mx-auto flex max-w-360 flex-col gap-20 md:gap-28">
            <div class="grid gap-10 md:grid-cols-12 md:items-end">
                <div class="md:col-span-8">
                    <BreadCrumb>Stone & Honey</BreadCrumb>
                    <h1 class="max-w-220">
                        Stone & Honey crafts clean, transparent nut butters from
                        pure ingredients.
                    </h1>
                </div>
                <div class="md:col-span-4 md:flex md:justify-end">
                    <dl class="grid gap-4 border-l border-accent pl-6 md:min-w-64">
                        <div class="grid gap-1">
                            <dt class="text-caption uppercase tracking-wide text-body-default">
                                Industry
                            </dt>
                            <dd class="text-title font-medium text-heading-default">
                                Food & Beverage
                            </dd>
                        </div>
                        <div class="grid gap-1">
                            <dt class="text-caption uppercase tracking-wide text-body-default">
                                Category
                            </dt>
                            <dd class="text-title font-medium text-heading-default">
                                Branding
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <Image
                src={HeroImage}
                alt="Stone & Honey brand presentation hero image"
                class="w-full rounded-lg"
            />

            <div class="grid gap-8 md:grid-cols-2 md:items-start">
                <div class="flex flex-col gap-6">
                    <h2>Natural, simple, honest.</h2>
                    <p>
                        Made with carefully sourced ingredients and nothing unnecessary, our products focus on purity, transparency, and natural flavor.
                    </p>
                </div>
                <Image
                    src={MoodBoard}
                    alt="Stone & Honey mood board"
                    class="w-full rounded-lg"
                />
            </div>

            <div class="grid gap-8">
                <Image
                    src={TypoColor}
                    alt="Stone & Honey typography and color system"
                    class="w-full rounded-lg"
                />
                <Image
                    src={LogoSheet}
                    alt="Stone & Honey logo variations"
                    class="w-full rounded-lg"
                />
            </div>

            <div class="grid gap-8 md:grid-cols-2">
                <Image
                    src={JarMockup}
                    alt="Stone & Honey jar packaging mockup"
                    class="w-full rounded-lg"
                />
                <Image
                    src={AppMockUp}
                    alt="Stone & Honey product items mockup"
                    class="w-full rounded-lg"
                />
            </div>

            <div class="grid gap-8 md:grid-cols-12 md:items-center">
                <div class="md:col-span-4">
                    <h2>Made to feel grounded.</h2>
                    <p class="mt-6">
                        Designed to bring you back to what matters, with simple ingredients and a naturally honest approach.
                    </p>
                </div>
                <div class="grid gap-8 md:col-span-8">
                    <Image
                        src={PackagingSlide}
                        alt="Stone & Honey packaging layout"
                        class="w-full rounded-lg"
                    />
                    <Image
                        src={TrackMockup}
                        alt="Stone & Honey brand touchpoint mockup"
                        class="w-full rounded-lg"
                    />
                </div>
            </div>

        </section>

        <section class="pt-24 md:pt-32">
            <h2 class="text-center p-16">Other Projects</h2>
            <div
                class="grid grid-cols-1 md:grid-cols-2 grid-rows-auto gap-4 max-w-400 mx-auto"
            >
                {
                    projects
                        .filter(
                            (project) =>
                                ["/ukg", "/tastebuds", "/billow"].includes(
                                    project.href,
                                ) && project.href !== "/stone-and-honey",
                        )
                        .slice(0, 2)
                        .map((project) => {
                            return (
                                <Card
                                    href={project.href}
                                    cover={project.cover}
                                    title={project.title}
                                    description={project.description}
                                    tag={project.tag}
                                />
                            );
                        })
                }
            </div>
        </section>
    </main>
</Layout>
