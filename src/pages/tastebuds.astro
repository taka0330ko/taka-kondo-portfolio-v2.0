---
// Layout
import Layout from "../layouts/Layout.astro";

// Icons
import Arrow from "../assets/images/icons/card-arrow.svg";
import { Github, ArrowUpRight} from "@lucide/astro";

// UI
import CaseStudySidebar from "../components/ui/CaseStudySidebar.astro";
import CodeWindow from "../components/ui/CodeWindow.tsx";
import { postsDataCode, templateTagCode, renderPostCode, postDataType, fetchData, CardRenderA, CardRenderB, Folders} from "../data/tastebudsCode.ts";
import GlassPill from "../components/ui/GlassPill.astro";

// Videos
import MVPVideo from "../assets/images/projects/tastebuds/videos/mvp-record.mp4";
import ReDevVideo from "../assets/images/projects/tastebuds/videos/redesign-record.mp4";

// Images
import MVPFolders from "../assets/images/projects/tastebuds/mvp-folders.png";
import Tastebuds_Website_Pic from "../assets/images/projects/tastebuds/teast-buds-website.png";
import CardUI from "../assets/images/projects/tastebuds/card-ui.png";
import PatternA from "../assets/images/projects/tastebuds/render-pattern-a.png";
import PatternB from "../assets/images/projects/tastebuds/render-pattern-b.png";



// Stack Logo assets
import {
    CSS,
    HTML,
    JS,
    NextJS,
    ReactLogo,
    SASS,
    Supabase,
    Tailwind
} from "../data/icons.ts"


export const tastebudsSections = [
  { label: "Overview", href: "#Overview" },
  { label: "MVP", href: "#MVP" },
  { label: "Redevelopment", href: "#Redevelopment" },
  { label: "Reflection", href: "#Reflection" }
]
---
<Layout>
    <main>
        <section id="hero" aria-labelledby="tastebuds-overview">
      <div class="grid grid-cols-12 grid-container mt-30 md:mt-40 items-start">
    <!-- Text Block -->
        <div class="md:col-start-1 md:col-span-6">

         <!-- Breadcrumb -->
            <nav aria-label="Breadcrumb" class="text-sm mb-6">
                <ol class="flex items-center gap-2 text-muted-foreground">
                    <li>
                        <a href="/" class="hover:text-accent">Home</a>
                    </li>
                    <li aria-hidden="true">/</li>
                    <li>
                        <a href="/#projects" class="hover:text-accent">Projects</a>
                    </li>
                    <li aria-hidden="true">/</li>
                    <li>
                        <a aria-current="page" class="text-accent">Tastebuds</a>
                    </li>
                </ol>
            </nav>
            <h1
             id="tastebuds-overview"
             class="text-4xl text-center p-6 font-semibold">“TASTEBUDS” Food Blog Site</h1>
            <p class="text-xl pt-6 text-center font-medium">A learning journey from MVP development with <span class="text-accent"> vanilla JavaScript </span>to redeveloping with <span class="text-accent">React and Next.js.</span></p>

        <!-- Vanilla to Next -->
        <div 
        role="img"
        aria-label="Technology transition from JavaScript to Next.js" 
        class="flex items-end gap-8 lg:gap-12 p-16 justify-center">
            <JS class="w-24 h-24" aria-hidden="true" focusable="false"/>
            <Arrow  class="text-foreground w-14 h-14" aria-hidden="true" focusable="false"/>
            <NextJS class="w-24  h-24 text-foreground" aria-hidden="true" focusable="false"/>
        </div>

        <!-- link pills -->
         <div class="flex justify-center gap-4">
             <GlassPill
             target="_blank" 
             rel="noopener noreferrer"
             aria-label="Open Tastebuds live site in a new tab"
             href="https://tastebuds-mbh7.vercel.app/"
             >
             <ArrowUpRight slot="after" aria-hidden="true" focusable="false"/>
             Live Site
             <span class="sr-only">(opens in a new tab)</span>
             </GlassPill>
             <GlassPill
             target="_blank"
             rel="noopener noreferrer"
             aria-label="Open Tastebuds GitHub repository in a new tab"
             href="https://github.com/Taka0330-jp/Tastebuds.git"
             >
             <Github slot="after" aria-hidden="true" focusable="false"/>
             GitHub
             <span class="sr-only">(opens in a new tab)</span>
             </GlassPill>
         </div>

    </div>

    <!-- Homepage Screenshot -->
       <div class="md:col-start-7 md:col-span-6 max-w-150 m-auto">
        <img 
        class="mask-b-from-70% mask-b-to-100%"
        src={Tastebuds_Website_Pic.src} 
        alt="Screenshot of the Tastebuds food blog homepage">
       </div>
    </div>
</section>

<section class="mt-32">
    <div class="flex flex-col lg:grid grid-cols-12">
        <aside 
        aria-label="Project section navigation"
        class="col-start-1 col-span-2 p-4 sticky top-24 h-fit">

        <CaseStudySidebar
        items={tastebudsSections}
        className="col-start-1 col-span-2"
        />

        </aside>
        <div class="px-8 md:col-start-3 col-span-10">

        <!-- Overview Section -->
        <section id="Overview" class="h-screen">
                <h2 class="text-3xl"><span class="heading-accent-bar">Overview</span></h2>
                <p class="pt-32 text-xl">TASTEBUDS began as a social media marketing project with my classmates, 
                    <span class="text-accent text-2xl"> a food blog featuring restaurants and cafés in Vancouver.</span></p>
                <p class="pt-16">At first, I had not learned React yet, so I built the site using <span class="text-accent text-xl"> 
                    HTML, CSS (Sass), and vanilla JavaScript.</span> As development progressed, I wanted a more efficient workflow, 
                    which led me to learn <span class="text-accent text-xl">React and Next.js.</span>
                    I also redesigned the UI in Figma and rebuilt the project from the ground up.</p>
        </section>

        <!-- MVP Section -->
        <section id="MVP">
                <h2 class="text-3xl"><span class="heading-accent-bar">MVP</span></h2>
                <div class="grid grid-cols-1 md:grid-cols-2 grid-rows-1 gap-8">
                    <div class="col-span-1 flex flex-col justify-between">
                        <p class="pt-16 text-xl place-items-center">For the MVP, I first explored how to create a structure that allows posts to be added using JavaScript.
                            Instead of manually dding more static HTML, I designed the system so that <span class="text-accent"> cards are generated from data using JavaScript.</span></p>
            
                    </div>
                    <div class="flex flex-col gap-4">
                        <!-- MVP Live Site & GitHub -->
                        <div class="flex gap-4">

                                     <GlassPill
                                     target="_blank" 
                                     rel="noopener noreferrer"
                                     aria-label="Open Tastebuds MVP live site in a new tab"
                                     href="https://tastebuds-website.vercel.app/pages/home.html"
                                     >
                                     <ArrowUpRight slot="after" aria-hidden="true" focusable="false"/>
                                     Live Site
                                     <span class="sr-only">(opens in a new tab)</span>
                                     </GlassPill>

                                     <GlassPill
                                     target="_blank"
                                     rel="noopener noreferrer"
                                     aria-label="Open Tastebuds MVP GitHub repository in a new tab"
                                     href="https://github.com/Taka0330-jp/tastebuds-website.git"
                                     >
                                     <Github slot="after" aria-hidden="true" focusable="false"/>
                                     GitHub
                                     <span class="sr-only">(opens in a new tab)</span>
                                     </GlassPill>

                        </div>
                        <!-- MVP Video -->
                        <div class="bg-card-gradient border border-frame-ring rounded-lg shadow-lg">
                            <video
                            class="p-4"
                            src={MVPVideo}
                            autoplay
                            loop
                            muted
                            playsinline ></video>
                        </div>
                        
                        <!-- MVP Stacks -->
                        <div class="flex justify-end items-center gap-2">
                            <HTML class="w-6 h-6"/>
                            <CSS class="w-6 h-6"/>
                            <SASS class="w-6 h-6"/>
                            <JS class="w-6 h-6"/>
                        </div>
                    </div>

                </div>
                <!-- My approach -->
                <section class="mt-32">
                    <h3 class="text-2xl">My approach</h3>
                <p class="py-16 text-xl">Using Vanilla JavaScript and the &lt;template&gt; element, I built a reusable card component.</p>
                
                <!-- Code Steps -->
                    <ol class="steps">
                            <li class="step relative">
                                <div class="timeline-number hidden md:flex ">
                                    <span>1</span>
                                </div>
                                    <div class="step-content">
                                        <div class="step-title flex items-center gap-4 md:pt-2">
                                            <span class="timeline-number md:hidden">1</span>
                                            <h4>Create a data structure for posts</h4>
                                        </div>
                                        <div class="code-view pt-8 mb-8">
                                            <CodeWindow
                                            code={postsDataCode}
                                            client:visible
                                            />
                                        </div>
                                    </div>
                            </li>
                            <li class="step relative">
                                <div class="timeline-number hidden md:flex ">
                                    <span>2</span>
                                </div>
                                    <div class="step-content">
                                        <div class="step-title flex items-center gap-4 md:pt-2">
                                            <span class="timeline-number md:hidden">2</span>
                                            <h4>Use the <code>&lt;template&gt;</code> element</h4>
                                        </div>
                                        <div class="code-view pt-8 mb-8">
                                            <CodeWindow
                                            code={templateTagCode}
                                            client:visible
                                            />
                                        </div>
                                    </div>
                            </li>
                            <li class="step">
                                <div class="timeline-number hidden md:flex ">
                                    <span>3</span>
                                </div>
                                    <div class="step-content">
                                        <div class="step-title flex items-center gap-4 md:pt-2">
                                            <span class="timeline-number md:hidden">3</span>
                                            <h4 >Generate cards dynamically with JavaScript</h4>
                                        </div>
                                        <div class="code-view pt-8">
                                            <CodeWindow
                                            code={renderPostCode}
                                            client:visible
                                            />
                                        </div>
                                    </div>
                            </li>
                        
                    </ol>

                </section>
                <!-- Code Steps end // -->
            </section>
            <!-- My approach end // -->

            <section class="mt-32">
                <h3 class="text-2xl">Learning and Challenges</h3>
                <p class="py-16 text-xl">Through the MVP, I learned the basics of DOM manipulation, reusable UI design, and separating structure, data, and styles.</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="col-start-1 my-auto">
                        <p>At the same time, state management became complex, routing was hard to maintain, and the architecture didn’t scale well.</p>
                        <p class="pt-8">This led me to rebuild the project with Next.js.</p>
                    </div>
                    <div class="bg-frame border border-frame-ring rounded-lg max-w-100 mx-auto">
                        <img
                        class="p-4 rounded-lg w-full"
                        src={MVPFolders.src}
                        alt="">
                    </div>

                </div>
            </section>

            <!-- Redevelopment Section -->
            <section id="Redevelopment" class="mt-32">
                <h2 class="text-3xl"><span class="heading-accent-bar">Redevelopment</span></h2>
                <div class="grid grid-cols-1 md:grid-cols-2 grid-rows-1 gap-8">
                    <div class="col-span-1 flex flex-col justify-between">
                        <p class="pt-16 text-xl place-items-center">To improve the scalability of the project, I redesigned the application using <span class="text-accent">React and Next.js.</span> 
                        </br>The UI was rebuilt as React components, allowing the interface to be generated declaratively from data.
                        </br>I also introduced Next.js to better organize the page structure and implement routing for individual posts, resulting in a more <span class="text-accent"> maintainable and extensible architecture.</span></p>
            
                    </div>
                    <div class="flex flex-col gap-4">
                        <!-- MVP Live Site & GitHub -->
                        <div class="flex gap-4">

                                     <GlassPill
                                     target="_blank" 
                                     rel="noopener noreferrer"
                                     aria-label="Open Tastebuds MVP live site in a new tab"
                                     href="https://tastebuds-mbh7.vercel.app/"
                                     >
                                     <ArrowUpRight slot="after" aria-hidden="true" focusable="false"/>
                                     Live Site
                                     <span class="sr-only">(opens in a new tab)</span>
                                     </GlassPill>

                                     <GlassPill
                                     target="_blank"
                                     rel="noopener noreferrer"
                                     aria-label="Open Tastebuds MVP GitHub repository in a new tab"
                                     href="https://github.com/Taka0330-jp/Tastebuds.git"
                                     >
                                     <Github slot="after" aria-hidden="true" focusable="false"/>
                                     GitHub
                                     <span class="sr-only">(opens in a new tab)</span>
                                     </GlassPill>

                        </div>
                        <!-- MVP Video -->
                        <div class="bg-card-gradient border border-frame-ring rounded-lg shadow-lg">
                            <video
                            class="p-4"
                            src={ReDevVideo}
                            autoplay
                            loop
                            muted
                            playsinline ></video>
                        </div>
                        
                        <!-- MVP Stacks -->
                        <div class="flex justify-end items-center gap-2">
                            <ReactLogo class="w-6 h-6"/>
                            <Tailwind class="w-6 h-6"/>
                            <NextJS class="w-6 h-6 text-foreground"/>
                            <Supabase class="w-6 h-6"/>
                        </div>
                    </div>
            </section>
            <section  class="mt-32">
                <h3 class="text-xl">Structured Content Management</h3>
                <p class="pt-16">In the MVP, blog content was stored as a front-end data array.
While this worked for an early prototype, it required manual updates whenever a new post was added, which made content management less efficient as the project expanded.</p>
                <p class="py-8">This led me to rethink how post data should be handled.
To create a more scalable structure, I separated content from the application code and migrated post management to Supabase.
This made the workflow easier to maintain and created a foundation that could later evolve into a CMS-like system.</p>
<!-- Code Steps -->
                    <ol class="steps mt-24">
                            <li class="step relative">
                                <div class="timeline-number hidden md:flex ">
                                    <span>1</span>
                                </div>
                                    <div class="step-content">
                                        <div class="step-title flex items-center gap-4 md:pt-2">
                                            <span class="timeline-number md:hidden">1</span>
                                            <h4>Design the post data structure</h4>
                                        </div>
                                        <div class="code-view pt-8 mb-8">
                                            <CodeWindow
                                            code={postDataType}
                                            client:visible
                                            />
                                        </div>
                                    </div>
                            </li>
                            <li class="step relative">
                                <div class="timeline-number hidden md:flex ">
                                    <span>2</span>
                                </div>
                                    <div class="step-content">
                                        <div class="step-title flex items-center gap-4 md:pt-2">
                                            <span class="timeline-number md:hidden">2</span>
                                            <h4>Retrieve posts from Supabase</h4>
                                        </div>
                                        <div class="code-view pt-8 mb-8">
                                            <CodeWindow
                                            code={fetchData}
                                            client:visible
                                            />
                                        </div>
                                    </div>
                            </li>
                        
                    </ol>
                    <p>Based on this structured data, UI components can dynamically generate blog cards and article pages.</p>
            </section>
            <section class="mt-16">
            <h3 class="text-xl">Rendering Architecture</h3>

 <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="col-start-1 my-auto">
                        <p>The UI was rebuilt using reusable React components.
                            Post data is passed into card components to generate article cards, creating a structure that can easily scale as more content is added.</p>
                    </div>
                    <div class="bg-frame border border-frame-ring rounded-lg max-w-300 mx-auto">
                        <img
                        class="p-4 rounded-lg w-full"
                        src={CardUI.src}
                        alt="">
                    </div>

                </div>
<!-- Code Views -->
<ol class="steps mt-24">
                        <!-- PatternA -->
                            <li class="">
                                            <div class="flex flex-col py-16">
                                                <h4>PatternA: Curated layout for the homepage</h4>
                                                <p class="pt-4">To highlight the latest articles, the homepage selects specific posts from the dataset and displays them in a curated layout.</p>
                                            </div>
                                       <div class="flex flex-col md:flex-row gap-8 items-center">
                                            <div class="code-view pt-8 mb-8">
                                                <CodeWindow
                                                showExpand= {false}
                                                code={CardRenderA}
                                                client:visible
                                                />
                                            </div>
                                            <div class="bg-black border border-frame-ring rounded-lg max-w-150 mx-auto p-4">
                                                <img src={PatternA.src} alt="">
                                            </div>
                                        </div>

                            </li>
                        <!-- PatternB -->
                            <li class="mt-8 ">
                                    <div class="">
                                            <div class="flex flex-col py-16">
                                                <h4>PatternB: Dynamic rendering for the blog archive</h4>
                                                <p class="pt-4">On the blog page, filtered post data is mapped into card components to dynamically generate the article list.</p>
                                            </div>
                                        <div class="flex flex-col md:flex-row gap-8 items-center">
                                            <div class="code-view pt-8 mb-8">
                                                <CodeWindow
                                                showExpand= {false}
                                                code={CardRenderB}
                                                client:visible
                                                />
                                            </div>
                                            <div class="bg-black border border-frame-ring rounded-lg max-w-150 mx-auto p-4">
                                                <img src={PatternB.src} alt="">
                                            </div>
                                        </div>
                                    </div>
                            </li>
                        
                    </ol>
            </section>
            <section>
                <h3 class="text-xl py-12">Dynamic Routing</h3>
                <h4 class="py-8">Problem</h4>
                <p>In the MVP, each article was managed as a separate page, making the structure difficult to scale as content grew.</p>
                <h4 class="py-8">Solution</h4>
                <p>I implemented Next.js Dynamic Routing using the /blog/[slug] route structure, allowing pages to be generated from a single shared template.</p>
                <div class="py-16">
                    <CodeWindow
                    code={Folders}
                    client:visible/>
                </div>
                <h4 class="py-8">Result</h4>
                <p>By fetching content based on the slug, new articles can be added without creating new pages, improving scalability and maintainability.</p>
            </section>

            <!-- Reflection Section -->
            <section id="Reflection" class="h-screen mt-32">
                <h2 class="text-3xl"><span class="heading-accent-bar">Reflection</span></h2>
            </section>
        </div>
    </div>
</section>
    </main>
</Layout>

    <!-- global css @layer components -->
    <!-- .heading-accent-bar{
      @apply relative inline-block pl-3 before:absolute before:left-0 before:top-0  
             before:w-1 before:h-full before:bg-accent
    } -->

<script>
    import gsap from "gsap"
    import { ScrollTrigger } from "gsap/ScrollTrigger"
    gsap.registerPlugin(ScrollTrigger)

    document.addEventListener("astro:page-load", ()=>{
gsap.fromTo(
  "#case-study-sidebar",
  { x: -40, opacity: 0 },
  {
    x: 0,
    opacity: 1,
    duration: 0.6,
    scrollTrigger: {
      trigger: "#hero",
      start: "bottom 30%",
      toggleActions: "play none none reverse",
    }
  }
)

    })
</script>