---
import Layout from "../layouts/Layout.astro";
import CaseStudySidebar from "../components/ui/CaseStudySidebar.astro";
import Tastebuds_Website_Pic from "../assets/images/projects/tastebuds/teast-buds-website.png";
import Js_Icon from "../assets/images/projects/tastebuds/icons/js-logo.svg";
import Next_Js_Icon from "../assets/images/projects/tastebuds/icons/nextjs-svgrepo-com.svg";
import CssLogo from "../assets/images/projects/tastebuds/icons/css-3.svg";
import HTMLLogo from "../assets/images/projects/tastebuds/icons/html-1.svg";
import SassLogo from "../assets/images/projects/tastebuds/icons/sass-logo.svg"
import Arrow from "../assets/images/icons/card-arrow.svg";
import { Github, ArrowUpRight} from "@lucide/astro";
import GlassPill from "../components/ui/GlassPill.astro";
import MVPVideo from "../assets/images/projects/tastebuds/videos/mvp-record.mp4"

export const tastebudsSections = [
  { label: "Overview", href: "#Overview" },
  { label: "MVP", href: "#MVP" },
  { label: "Redevelopment", href: "#Redevelopment" },
  { label: "Reflection", href: "#Reflection" }
]
---
<Layout>
    <main>
        <section id="hero" aria-labelledby="tastebuds-overview">
      <div class="grid grid-cols-12 grid-container mt-30 md:mt-40 items-start">
        <!-- Text Block -->
        <div class="md:col-start-1 md:col-span-6">
            <nav aria-label="Breadcrumb" class="text-sm mb-6">
                <ol class="flex items-center gap-2 text-muted-foreground">
                    <li>
                        <a href="/" class="hover:text-accent">Home</a>
                    </li>
                    <li aria-hidden="true">/</li>
                    <li>
                        <a href="/#projects" class="hover:text-accent">Projects</a>
                    </li>
                    <li aria-hidden="true">/</li>
                    <li>
                        <a aria-current="page" class="text-accent">Tastebuds</a>
                    </li>
                </ol>
            </nav>
            <h1
             id="tastebuds-overview"
             class="text-4xl text-center p-6 font-semibold">“TASTEBUDS” Food Blog Site</h1>
            <p class="text-xl pt-6 text-center font-medium">A learning journey from MVP development with <span class="text-accent"> vanilla JavaScript </span>to redeveloping with <span class="text-accent">React and Next.js.</span></p>

        <!-- Vanilla to Next -->
        <div 
        role="img"
        aria-label="Technology transition from JavaScript to Next.js" 
        class="flex items-end gap-8 lg:gap-12 p-16 justify-center">
            <Js_Icon class="w-24 h-24" aria-hidden="true" focusable="false"/>
            <Arrow  class="text-foreground w-14 h-14" aria-hidden="true" focusable="false"/>
            <Next_Js_Icon class="w-24  h-24 text-foreground" aria-hidden="true" focusable="false"/>
        </div>

        <!-- link pills -->
         <div class="flex justify-center gap-4">
             <GlassPill
             target="_blank" 
             rel="noopener noreferrer"
             aria-label="Open Tastebuds live site in a new tab"
             href="https://tastebuds-mbh7.vercel.app/"
             >
             <ArrowUpRight slot="after" aria-hidden="true" focusable="false"/>
             Live Site
             <span class="sr-only">(opens in a new tab)</span>
             </GlassPill>
             <GlassPill
             target="_blank"
             rel="noopener noreferrer"
             aria-label="Open Tastebuds GitHub repository in a new tab"
             href="https://github.com/Taka0330-jp/Tastebuds.git"
             >
             <Github slot="after" aria-hidden="true" focusable="false"/>
             GitHub
             <span class="sr-only">(opens in a new tab)</span>
             </GlassPill>
         </div>

    </div>

    <!-- Homepage Screenshot -->
       <div class="md:col-start-7 md:col-span-6 flex justify-center">
        <img 
        class="mask-b-from-70% mask-b-to-100%"
        src={Tastebuds_Website_Pic.src} 
        alt="Screenshot of the Tastebuds food blog homepage">
       </div>
    </div>
</section>

<section class="mt-32">
    <div class="flex flex-col lg:grid grid-cols-12">
        <aside 
        aria-label="Project section navigation"
        class="col-start-1 col-span-2 p-4 sticky top-24 h-fit">

        <CaseStudySidebar
        items={tastebudsSections}
        className="col-start-1 col-span-2"
        />

        </aside>
        <div class="px-8 ld:col-star-3 col-span-10">
            <!-- Overview Section -->
            <article id="Overview" class="h-screen">
                <h2 class="text-3xl"><span class="heading-accent-bar">Overview</span></h2>
                <p class="pt-32 text-xl">TASTEBUDS began as a social media marketing project with my classmates, 
                    <span class="text-accent text-2xl"> a food blog featuring restaurants and cafés in Vancouver.</span></p>
                <p class="pt-16">At first, I had not learned React yet, so I built the site using <span class="text-accent text-xl"> 
                    HTML, CSS (Sass), and vanilla JavaScript.</span> As development progressed, I wanted a more efficient workflow, 
                    which led me to learn <span class="text-accent text-xl">React and Next.js.</span>
                    I also redesigned the UI in Figma and rebuilt the project from the ground up.</p>
            </article>
            <!-- MVP Section -->
        <article id="MVP">
                <h2 class="text-3xl"><span class="heading-accent-bar">MVP</span></h2>
                <div class="grid grid-cols-1 md:grid-cols-2 grid-rows-1 gap-4">
                    <div class="col-span-1 flex flex-col justify-between">
                        <p class="pt-32 text-xl">For the MVP, I first explored how to create a structure that allows posts to be added using JavaScript.
                            Instead of manually adding more static HTML, I designed the system so that <span class="text-accent"> cards are generated from data using JavaScript.</span></p>
            <div class="flex justify-center gap-4">
             <GlassPill
             target="_blank" 
             rel="noopener noreferrer"
             aria-label="Open Tastebuds MVP live site in a new tab"
             href="https://tastebuds-website.vercel.app/pages/home.html"
             >
             <ArrowUpRight slot="after" aria-hidden="true" focusable="false"/>
             Live Site
             <span class="sr-only">(opens in a new tab)</span>
             </GlassPill>
             <GlassPill
             target="_blank"
             rel="noopener noreferrer"
             aria-label="Open Tastebuds MVP GitHub repository in a new tab"
             href="https://github.com/Taka0330-jp/tastebuds-website.git"
             >
             <Github slot="after" aria-hidden="true" focusable="false"/>
             GitHub
             <span class="sr-only">(opens in a new tab)</span>
             </GlassPill>
         </div>
                    </div>
                    <div class="bg-card-gradient border border-frame-ring rounded-lg shadow-lg">
                        <video
                        class="p-4"
                        src={MVPVideo}
                        autoplay
                        loop
                        muted
                        playsinline ></video>
                        <div class="flex justify-end items-center gap-2 p-4">
                            <HTMLLogo class="w-6 h-6"/>
                            <CssLogo class="w-6 h-6"/>
                            <SassLogo class="w-6 h-6"/>
                            <Js_Icon class="w-6 h-6"/>
                        </div>
                    </div>
                </div>
                <!-- My approach -->
                <div class="h-screen mt-32">
                    <h3 class="text-2xl">My approach</h3>
                </div>

            </article>

            <!-- Redevelopment Section -->
            <div id="Redevelopment" class="h-screen">
                <h2>Redevelopment</h2>
            </div>

            <!-- Reflection Section -->
            <div id="Reflection" class="h-screen">
                <h2>Reflection</h2>
            </div>
        </div>
    </div>
</section>
    </main>
</Layout>

    <!-- global css @layer components -->
    <!-- .heading-accent-bar{
      @apply relative inline-block pl-3 before:absolute before:left-0 before:top-0  
             before:w-1 before:h-full before:bg-accent
    } -->

<script>
    import gsap from "gsap"
    import { ScrollTrigger } from "gsap/ScrollTrigger"
    gsap.registerPlugin(ScrollTrigger)

    document.addEventListener("astro:page-load", ()=>{
gsap.fromTo(
  "#case-study-sidebar",
  { x: -40, opacity: 0 },
  {
    x: 0,
    opacity: 1,
    duration: 0.6,
    scrollTrigger: {
      trigger: "#hero",
      start: "bottom 30%",
      toggleActions: "play none none reverse",
    }
  }
)

    })
</script>