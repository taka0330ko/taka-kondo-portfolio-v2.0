---
import RippleEffectRings from '../components/webGL/RippleEffectRings';
import Layout from '../layouts/Layout.astro';
import HeroTextBlock from '../components/features/HeroTextBlock.astro';
import CopyEmail from '../components/ui/CopyEmail.astro';
import { projects } from '../data/projects';
import MainProjectCard from '../components/ui/MainProjectCard.astro';

---

<Layout>
<main>
	<section class="mb-64">
    <div class="grid grid-cols-12 grid-container mt-45 md:mt-60 items-center">
       <HeroTextBlock />
       <div class="col-span-6 flex justify-center">
        <RippleEffectRings client:visible />
       </div>
    </div>
	</section>

  <section id="projects" class="max-w-350 mx-auto px-4 md:px-8" >
    <h2 class="pb-16 sr-only">Projects</h2>
    <div class="grid gap-24">
      {projects.map((project) =>{
       return (
            <MainProjectCard
            href={project.href}
            cover={project.cover}
            coverVideo={project.coverVideo}
            title={project.title}
            description={project.description}
            summaryList={project.summaryList}
            tag={project.tag}          />
        )
      })}
    </div>
  </section>
          <section class="flex justify-center items-center h-100">
          <CopyEmail/>
        </section>
</main>
</Layout>
