          <span class="text-accent">UX experience.</span>
        </h1>

      </div>

      <div class="col-span-6 flex justify-center">
        <RippleEffectRings client:visible />
      </div>
            <div  class='flex items-center gap-10 col-start-1 col-end-4 mt-4'>
                      <!-- <Github className='text-heading-default'/>
                      <Linkedin  className='text-heading-default'/>
