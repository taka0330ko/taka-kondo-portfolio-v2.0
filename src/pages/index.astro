---
import RippleEffectRings from '../components/webGL/RippleEffectRings';
import Layout from '../layouts/Layout.astro';
import HeroTextBlock from '../components/features/HeroTextBlock.astro';
import Card from '../components/ui/Card.astro'
import CopyEmail from '../components/ui/CopyEmail.astro';
import { projects } from '../data/projects';

---

<Layout>
<main>
	<section class="mb-64">
    <div class="grid grid-cols-12 grid-container mt-45 md:mt-60 items-center">
       <HeroTextBlock />
       <div class="col-span-6 flex justify-center">
        <RippleEffectRings client:visible />
       </div>
    </div>
	</section>

  <section id="projects" class="grid-container grid-rows-2">
    {projects.map((project) =>{

     return (
        <div class={project.gridClass}>
          <Card 
          href={project.href}
          cover={project.cover} 
          title={project.title} 
          description={project.description} 
          tag={project.tag}          />
        </div>
      )

    })}
  </section>
          <section class="flex justify-center items-center h-100">
          <CopyEmail/>
        </section>
</main>
</Layout>


