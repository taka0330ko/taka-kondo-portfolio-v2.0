---
import Layout from '../layouts/Layout.astro';
import RippleEffectLogo from '../components/webGL/RippleEffectLogo';
import HeroVideo from '../components/features/HeroVideo.astro';
import CopyEmail from '../components/ui/CopyEmail.astro';
import { projects } from '../data/projects';
import MainProjectCard from '../components/ui/MainProjectCard.astro';
import IconHover from '../components/ui/IconHover.astro';
import { GithubIcon, LinkedinIcon } from '../data/icons';
import { Mail } from '@lucide/astro';
import { homeEn } from '../content/en/home';

---

<Layout title={homeEn.meta.title} description={homeEn.meta.description}>
<main>
	<HeroVideo title={homeEn.meta.title} description={homeEn.meta.description} lang="en" />

  <section id="projects" class="max-w-350 mx-auto px-4 pt-8 md:px-8 md:pt-16" >
    <div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-5 md:mb-16">
        <h2 class="font-heading text-[clamp(3.5rem,10.5vw,10rem)] font-light leading-[0.95] tracking-[-0.055em] text-foreground/40" lang="en">Selected Projects</h2>
        <p class="ml-auto pb-1 text-right font-heading text-xs font-medium leading-tight tracking-[0.08em] text-foreground/40 md:text-sm" lang="en">
          DISCOVER<br />LEARN<br />REFINE
        </p>
      </div>
    <div class="grid gap-24">
      {projects.map((project) =>{
       return (
            <MainProjectCard
            href={project.href}
            cover={project.cover}
            coverVideo={project.coverVideo}
            coverVideoFallback={project.coverVideoFallback}
            title={project.title}
            description={project.description}
            summaryList={project.summaryList}
            tag={project.tag} 
            isReady={project.isReady}
            readMoreLabel={homeEn.projectCard.readMore}
            comingSoonLabel={homeEn.projectCard.comingSoon}
                     />
        )
      })}
    </div>
  </section>
<section class="flex flex-col justify-center items-center my-40">
    <CopyEmail copiedLabel={homeEn.contact.copiedLabel} />
    <div class="icons flex items-center gap-10 mt-4">
      <IconHover
        href="https://github.com/taka0330ko"
        aria-label="GitHub profile"
        label="GitHub"
      >
        <GithubIcon />
      </IconHover>

      <IconHover
        href="https://www.linkedin.com/in/takanarikondo/"
        aria-label="LinkedIn profile"
        label="LinkedIn"
      >
        <LinkedinIcon />
      </IconHover>

      <IconHover
        href="mailto:gtakanari0330@gmail.com"
        aria-label={homeEn.contact.emailAriaLabel}
        label="Email"
      >
        <Mail />
      </IconHover>
    </div>
    <div class="mt-16 flex w-full justify-center">
      <RippleEffectLogo client:visible />
    </div>
  </section>
</main>
</Layout>
