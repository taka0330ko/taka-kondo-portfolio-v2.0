---
import RippleEffectRings from '../components/webGL/RippleEffectRings';
import Layout from '../layouts/Layout.astro';
import HeroTextBlock from '../components/features/HeroTextBlock.astro';
import CopyEmail from '../components/ui/CopyEmail.astro';
import { projects } from '../data/projects';
import MainProjectCard from '../components/ui/MainProjectCard.astro';
import IconHover from '../components/ui/IconHover.astro';
import { Github, Linkedin, Mail } from '@lucide/astro';

---

<Layout>
<main>
	<section class="mb-64 mt-6 mx-auto max-w-360 md:gap-12 px-4 md:px-8 flex flex-col ">
      <div class="mx-auto flex items-center justify-center mt-36 md:mt-48">
        <RippleEffectRings client:visible />
      </div>
      <HeroTextBlock/>
	</section>

  <section id="projects" class="max-w-350 mx-auto px-4 md:px-8" >
    <h2 class="pb-16 sr-only">Projects</h2>
    <div class="grid gap-24">
      {projects.map((project) =>{
       return (
            <MainProjectCard
            href={project.href}
            cover={project.cover}
            coverVideo={project.coverVideo}
            title={project.title}
            description={project.description}
            summaryList={project.summaryList}
            tag={project.tag}          />
        )
      })}
    </div>
  </section>
<section class="flex flex-col justify-center items-center my-40">
    <CopyEmail />
    <div class="icons flex items-center gap-10 mt-4">
      <IconHover
        href="https://github.com/taka0330ko"
        aria-label="GitHub profile"
        label="GitHub"
      >
        <Github />
      </IconHover>

      <IconHover
        href="https://www.linkedin.com/in/takanarikondo/"
        aria-label="LinkedIn profile"
        label="LinkedIn"
      >
        <Linkedin />
      </IconHover>

      <IconHover
        href="mailto:gtakanari0330@gmail.com"
        aria-label="Send email"
        label="Email"
      >
        <Mail />
      </IconHover>
    </div>
  </section>
</main>
</Layout>
