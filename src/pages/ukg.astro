---
// Layout
import Layout from "../layouts/Layout.astro";
import UKGVideo from "../assets/images/projects/UKG/videos/demo_video.mp4";
import UKGIcon from "../assets/images/projects/UKG/ukg-icon.png";
import MyUKGPage from "../assets/images/projects/UKG/my-ukg-page.webp";
import Survey01 from "../assets/images/projects/UKG/survey-result-1.webp";
import Survey02 from "../assets/images/projects/UKG/survey-result-2.webp";
import UXResearchLayer from "../assets/images/projects/UKG/ux-research-layer.svg";
import UIDesignLayer from "../assets/images/projects/UKG/uidesign-layer.svg";
import InterviewLayer from "../assets/images/projects/UKG/interview-layer.svg";
import FormLayer from "../assets/images/projects/UKG/form-layer.svg";
import DevLayer from "../assets/images/projects/UKG/dev-layer.svg";
import TestingLayer from "../assets/images/projects/UKG/testing-layer.svg";
import Cashier from "../assets/images/projects/UKG/cashier.svg";
import GroceryStaff from "../assets/images/projects/UKG/grocery.svg";
import Schedule from "../assets/images/projects/UKG/schedle.webp";
import TotalHours from "../assets/images/projects/UKG/total-hours.webp";
import StickyNote from "../assets/images/projects/UKG/sticky-note.svg";
import Arrow from "../assets/images/projects/UKG/arrow.svg";
import JourneyMap from "../assets/images/projects/UKG/journey-map.webp";
// import LowFide from "../assets/images/projects/UKG/low-fide.webp";
import MidFide from "../assets/images/projects/UKG/mid-fide.webp";
import OldLogo from "../assets/images/projects/UKG/ukg-old-logo.png";
import NewLogo from "../assets/images/projects/UKG/ukg-new-logo.png";
import DevTool from "../assets/images/projects/UKG/dev-tool.webp";
import PrimitiveColors from "../assets/images/projects/UKG/color-primitive.webp";
import DesignSystem from "../assets/images/projects/UKG/design-system.webp";
import HighFide from "../assets/images/projects/UKG/high-fide.webp";
import Image from "astro/components/Image.astro";
import { ArrowUpRight } from "@lucide/astro";

// UI
import BreadCrumb from "../components/ui/BreadCrumb.astro";
import CaseStudySidebar from "../components/ui/CaseStudySidebar.astro";
import ProjectMainVideo from "../components/ui/ProjectMainVideo.astro";
import GlassPill from "../components/ui/GlassPill.astro";

export const ukgSections = [
    { label: "Overview", href: "#Overview" },
    { label: "Problem", href: "#Problem" },
    { label: "UI Design", href: "#UI-design" },
    { label: "User Feedback", href: "#User-feedback" },
    { label: "Reflection", href: "#Reflection" },
];
---

<Layout>
    <main class="mt-30 md:mt-40">
        <!-- Breadcrumb -->
        <div class="ml-8">
            <BreadCrumb>UKG Redesign Project</BreadCrumb>
        </div>
        <section id="hero" aria-labelledby="ukg-redesign-overview">
            <div class="grid grid-cols-12 grid-container items-start">
                <div class="col-span-8">
                    <h1 class="mt-8">
                        “Are my work hours being calculated correctly...?”
                    </h1>
                    <p class="flex justify-end mt-8">
                        That my coworker’s question inspired this redesign
                    </p>
                    <div class="mt-8 md:my-8">
                        <GlassPill
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Open Tastebuds live site in a new tab"
                            href="https://ukg-pro-redesign.vercel.app/"
                        >
                            <ArrowUpRight
                                slot="after"
                                aria-hidden="true"
                                focusable="false"
                            />
                            Prototype
                            <span class="sr-only">(opens in a new tab)</span>
                        </GlassPill>
                    </div>
                </div>
                <dl
                    class="order-3 md:order-2 grid gap-4 border-l border-accent pl-6 md:min-w-64 mt-16 md:col-span-4"
                >
                    <div class="grid gap-1">
                        <dt class="text-caption uppercase tracking-wide">
                            Tool
                        </dt>
                        <dd class="font-medium text-body text-heading-default">
                            Google form / Figma / React & Tailwind
                        </dd>
                    </div>
                    <div class="grid gap-1">
                        <dt
                            class="text-caption uppercase tracking-wide text-body-default"
                        >
                            Role
                        </dt>
                        <dd class="text-body font-medium text-heading-default">
                            UX Researcher / UI Designer / Front-end Developer
                        </dd>
                    </div>
                    <div class="grid gap-1">
                        <dt
                            class="text-caption uppercase tracking-wide text-body-default"
                        >
                            Timeline
                        </dt>
                        <dd class="text-body font-medium text-heading-default">
                            One month, Apr-May, 2026
                        </dd>
                    </div>
                </dl>
                <div class="order-2 md:order-3 col-span-12">
                    <ProjectMainVideo src={UKGVideo} />
                </div>
            </div>
            <!-- ====================== Case Study Start ====================== -->
            <section class="mt-32">
                <div
                    class="flex flex-col max-w-360 mx-auto lg:grid grid-cols-12"
                >
                    <aside
                        aria-label="Project section navigation"
                        class="col-start-1 col-span-2 p-4 sticky top-24 h-fit"
                    >
                        <CaseStudySidebar
                            items={ukgSections}
                            className="col-start-1 col-span-2"
                        />
                    </aside>
                    <div class="px-8 md:col-start-3 col-span-10">
                        <!-- Overview Section -->
                        <section id="Overview" class="mt-32">
                            <h2 class="font-semibold">
                                <span class="heading-accent-bar">Overview</span>
                            </h2>
                            <div class="text-box">
                                <h3 class="text-xl md:text-2xl">
                                    UX/UI redesign of the UKG Pro payroll
                                    experience based on user research.
                                </h3>
                                <div
                                    class="mt-24 flex flex-col items-center gap-8 md:flex-row md:justify-center md:gap-32"
                                >
                                    <Image
                                        class="w-16"
                                        src={UKGIcon}
                                        alt="UKG logo"
                                    />
                                    <p class="text-body-default">
                                        UKG Pro: Employee HR, Payroll, and
                                        Workforce Management platform
                                    </p>
                                </div>
                                <div
                                    class="mt-24 grid gap-12 md:grid-cols-2 md:items-center"
                                >
                                    <Image
                                        src={MyUKGPage}
                                        alt="UKG Pro dashboard displayed on a laptop screen"
                                    />
                                    <div class="grid gap-6">
                                        <p>
                                            This project began with UX research
                                            focused on UKG Pro, a payroll
                                            application that I actively use at
                                            my part-time workplace.
                                        </p>
                                        <p>
                                            The goal of the redesign was to
                                            improve transparency and usability
                                            within the payroll checking
                                            experience.
                                        </p>
                                    </div>
                                </div>
                                <div class="mt-32">
                                    <h3 class="mb-4">My strategy</h3>
                                    <div
                                        class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center"
                                    >
                                        <p class="text-subtitle pb-16">
                                            In this project, I first analyzed
                                            pain points through interviews and
                                            surveys conducted with real users,
                                            including my coworkers. Based on
                                            these insights, I designed the UI in
                                            Figma, built a prototype using
                                            AI-assisted development tools, and
                                            conducted usability testing with
                                            participants.
                                        </p>
                                        <div
                                            class="grid grid-cols-[1fr_3fr_2fr] items-center max-w-xl mx-auto"
                                        >
                                            <!-- Step 1 -->
                                            <div
                                                class="relative w-10 flex justify-center"
                                            >
                                                <div
                                                    class="w-10 h-10 rounded-full bg-accent text-white flex items-center justify-center font-semibold"
                                                >
                                                    1
                                                </div>
                                                <div
                                                    class="absolute top-full left-1/2 w-0.5 h-20 bg-accent/30 transform -translate-x-1/2"
                                                >
                                                </div>
                                            </div>
                                            <h4>
                                                UX Research<br />
                                                (Interview & Form)
                                            </h4>
                                            <div class="flex justify-center">
                                                <img
                                                    class="w-40"
                                                    src={UXResearchLayer.src}
                                                    alt="UX Research illustration"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <!-- Step 2 -->
                                            <div
                                                class="relative w-10 flex justify-center"
                                            >
                                                <div
                                                    class="w-10 h-10 rounded-full bg-accent text-white flex items-center justify-center font-semibold"
                                                >
                                                    2
                                                </div>
                                                <div
                                                    class="absolute top-full left-1/2 w-0.5 h-20 bg-accent/30 transform -translate-x-1/2"
                                                >
                                                </div>
                                            </div>
                                            <h4>UI design</h4>
                                            <div class="flex justify-center">
                                                <img
                                                    class="w-40"
                                                    src={UIDesignLayer.src}
                                                    alt="UI design illustration"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <!-- Step 3 -->
                                            <div
                                                class="relative w-10 flex justify-center"
                                            >
                                                <div
                                                    class="w-10 h-10 rounded-full bg-accent text-white flex items-center justify-center font-semibold"
                                                >
                                                    3
                                                </div>
                                                <div
                                                    class="absolute top-full left-1/2 w-0.5 h-20 bg-accent/30 transform -translate-x-1/2"
                                                >
                                                </div>
                                            </div>
                                            <h4>Prototype Development</h4>
                                            <div class="flex justify-center">
                                                <img
                                                    class="w-40"
                                                    src={DevLayer.src}
                                                    alt="Prototype development illustration"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <!-- Step 4 -->
                                            <div
                                                class="relative w-10 flex justify-center"
                                            >
                                                <div
                                                    class="w-10 h-10 rounded-full bg-accent text-white flex items-center justify-center font-semibold"
                                                >
                                                    4
                                                </div>
                                            </div>
                                            <h4>Usability Testing</h4>
                                            <div class="flex justify-center">
                                                <img
                                                    class="w-40"
                                                    src={TestingLayer.src}
                                                    alt="Usability testing illustration"
                                                    loading="lazy"
                                                />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- Problem Section -->
                        <section id="Problem" class="mt-32"></section>
                        <h2 class="font-semibold">
                            <span class="heading-accent-bar">Problem</span>
                        </h2>
                        <div class="grid md:flex items-center gap-16 mt-16">
                            <img
                                class="w-40 mx-auto md:mx-0"
                                src={InterviewLayer.src}
                                alt="Usability testing illustration"
                                loading="lazy"
                            />
                            <h3 class="text-3xl md:text-4xl">
                                I started by listening to my coworkers.
                            </h3>
                        </div>

                        <div class="flex gap-8 items-center mt-16">
                            <div class="flex flex-col items-center">
                                <Image
                                    class="w-40 mx-auto md:mx-0"
                                    src={GroceryStaff}
                                    alt="Usability testing illustration"
                                    loading="lazy"
                                />
                                <p class="text-caption">Grocery Saff</p>
                            </div>
                            <p>
                                “I can see the total hours worked, but I can’t
                                see the breakdown.”
                            </p>
                        </div>
                        <div
                            class="bg-black border border-gray-100 p-4 rounded-lg max-w-120 mx-auto mt-8 md:mt-0"
                        >
                            <Image
                                class="w-full"
                                src={TotalHours}
                                alt="UKG logo"
                            />
                        </div>
                        <div class="flex gap-4 items-center mt-16">
                            <p>
                                “The punch records should exist somewhere, but I
                                can’t verify them in UKG Pro. The schedule only
                                shows assigned shifts.”
                            </p>
                            <div class="flex flex-col items-center">
                                <Image
                                    class="w-56 mx-auto md:mx-0"
                                    src={Cashier}
                                    alt="Usability testing illustration"
                                    loading="lazy"
                                />
                                <p class="text-caption">Cashier</p>
                            </div>
                        </div>
                        <div
                            class="bg-black border border-gray-100 p-4 rounded-lg max-w-150 mx-auto mt-8 md:mt-0"
                        >
                            <Image
                                class="w-full"
                                src={Schedule}
                                alt="UKG logo"
                            />
                        </div>
                        <div class="mt-16">
                            <h3>Existing User Journey Pain Points</h3>
                            <div class="mt-16 grid gap-12">
                                <div class="flex mx-auto gap-8">
                                    <div
                                        class="relative mx-auto w-56 max-w-full md:mx-0"
                                    >
                                        <img
                                            class="w-full"
                                            src={StickyNote.src}
                                            alt=""
                                            loading="lazy"
                                        />
                                        <div
                                            class="absolute inset-0 px-8 py-8 text-heading-default"
                                        >
                                            <h4
                                                class="text-black text-body font-semibold"
                                            >
                                                User Intent
                                            </h4>
                                            <p
                                                class="text-gray-800 mt-2 md:mt-4 text-sm"
                                            >
                                                Confirm that payroll hours were
                                                calculated accurately
                                            </p>
                                        </div>
                                    </div>
                                    <img
                                        class="mx-auto w-20"
                                        src={Arrow.src}
                                        alt=""
                                        loading="lazy"
                                    />
                                    <div
                                        class="relative mx-auto w-56 max-w-full md:mx-0"
                                    >
                                        <img
                                            class="w-full hue-rotate-60 saturate-200"
                                            src={StickyNote.src}
                                            alt=""
                                            loading="lazy"
                                        />
                                        <div
                                            class="absolute inset-0 px-8 py-8 text-heading-default"
                                        >
                                            <h4
                                                class="text-black text-body font-semibold"
                                            >
                                                Outcome
                                            </h4>
                                            <p
                                                class="text-gray-800 mt-2 md:mt-4 text-sm"
                                            >
                                                The user leaves without knowing
                                                the exact payroll calculation
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="overflow-x-auto">
                                    <Image
                                        class="min-w-240 md:min-w-0"
                                        src={JourneyMap}
                                        alt="Existing user journey map showing payroll review phases, actions, thoughts, emotions, and friction points"
                                    />
                                </div>
                                <p class="text-xl">
                                    Users cannot verify how payroll hours are
                                    calculated, forcing them to rely on manual
                                    estimation instead of system transparency.
                                </p>
                            </div>
                            <div class="grid md:flex items-center gap-16 mt-32">
                                <img
                                    class="w-40 mx-auto md:mx-0"
                                    src={FormLayer.src}
                                    alt="Google form illustration"
                                    loading="lazy"
                                />
                                <div class="flex flex-col gap-4">
                                    <h3 class="text-3xl md:text-4xl">
                                        Research Findings
                                    </h3>
                                    <p>
                                        Conducted a survey to further validate
                                        existing pain points and identify strong
                                        user demand for better visibility into
                                        payroll records.
                                    </p>
                                </div>
                            </div>

                            <div
                                class="grid md:flex justify-between gap-8 items-center mt-16"
                            >
                                <p>
                                    80% of participants said they would not feel
                                    confident verifying payroll calculations if
                                    an error occurred.
                                </p>
                                <div
                                    class="bg-black border border-gray-100 p-4 rounded-lg max-w-120 mx-auto mt-8 md:mt-0"
                                >
                                    <Image
                                        src={Survey01}
                                        alt=""
                                        class="w-100"
                                    />
                                </div>
                            </div>
                            <div
                                class="grid md:flex flex-row-reverse justify-between gap-8 items-center"
                            >
                                <p>
                                    90% of participants wanted access to actual
                                    clock-in and clock-out records.
                                </p>
                                <div
                                    class="bg-black border border-gray-100 p-4 rounded-lg max-w-120 mx-auto mt-8 md:mt-0"
                                >
                                    <Image
                                        src={Survey02}
                                        alt=""
                                        class="w-100"
                                    />
                                </div>
                            </div>
                        </div>
                        <p class="mt-16 text-xl">
                            Users lacked confidence in payroll calculations
                            because the system did not provide enough visibility
                            into payroll records and actual worked hours.
                        </p>

                        <div class="mt-32">
                            <div
                                class="mb-16 flex flex-col gap-4 justify-center items-start"
                            >
                                <h3
                                    class="inline-block font-light border-b-2 border-accent"
                                >
                                    GOAL
                                </h3>
                                <h3>
                                    Improve payroll transparency by providing
                                    visibility into clock-in and clock-out
                                    records.
                                </h3>
                            </div>
                            <div
                                class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-4 md:gap-16 items-center"
                            >
                                <div class="flex gap-4 items-center">
                                    <Image
                                        src={GroceryStaff}
                                        alt=""
                                        class="w-32"
                                    />
                                    <p class="text-xl">
                                        As an employee, I want to review my
                                        clock-in and clock-out history so that I
                                        can verify how my payroll hours were
                                        calculated.
                                    </p>
                                </div>
                                <div
                                    class="mt-16 rounded-lg border border-gray-100 bg-black p-4 w-120"
                                >
                                    <Image
                                        src={MidFide}
                                        alt=""
                                        class="w-full"
                                    />
                                </div>
                            </div>
                        </div>
                        <!-- UI design Section -->
                        <section id="UI-design" class="mt-64">
                            <h2 class="font-semibold">
                                <span class="heading-accent-bar">UI Design</span
                                >
                            </h2>
                            <Image
                                src={UIDesignLayer}
                                alt=""
                                class="w-48 mx-auto my-16"
                            />
                            <h3>
                                Designing the UI Around UKG’s New Brand Identity
                            </h3>
                            <div
                                class="flex items-center justify-center gap-8 md:gap-12 my-16"
                            >
                                <Image
                                    src={OldLogo}
                                    alt="Previous logo design"
                                    class="w-40 object-contain"
                                />

                                <Image
                                    src={Arrow}
                                    alt="Transformation arrow"
                                    class="w-16 opacity-50"
                                />

                                <Image
                                    src={NewLogo}
                                    alt="Redesigned logo"
                                    class="w-40 object-contain"
                                />
                            </div>
                            <p>
                                In 2025, UKG introduced a refreshed visual
                                identity.
                            </p>
                            <p>
                                The redesign explored how the updated visual
                                identity could be applied more consistently
                                across the payroll experience.
                            </p>

                            <div class="mt-16 grid gap-6">
                                <p>
                                    Since the official design system was not
                                    publicly available, visual styles and UI
                                    patterns were independently analyzed from
                                    UKG’s public website.
                                </p>
                                <div class="max-w-280">
                                    <Image
                                        src={DevTool}
                                        alt="Browser developer tools used to inspect UKG website visual styles"
                                        class="w-full"
                                    />
                                </div>
                                <Image
                                    src={Arrow}
                                    alt=""
                                    class="transform rotate-90 mx-auto"
                                />
                                <Image
                                    src={PrimitiveColors}
                                    alt=""
                                    class="w-120 mx-auto mt-8"
                                />
                                <p class="text-center">
                                    Primitive color tokens derived from the
                                    analysis
                                </p>
                                <div>
                                    <Image
                                        src={DesignSystem}
                                        alt=""
                                        class="w-full mt-8 rounded-lg"
                                    />
                                    <p class="mt-16">
                                        Rather than connecting raw color values
                                        directly to the UI, I designed a
                                        hierarchical structure consisting of
                                        Primitive → Semantic → Component
                                        (optional). I placed particular emphasis
                                        on Semantic Tokens, as defining intent
                                        and meaning instead of visual values
                                        helps create more consistent design
                                        rules. Since this project contained
                                        relatively few repeated UI patterns,
                                        Component Tokens were introduced only
                                        where they provided additional value.
                                    </p>
                                </div>
                            </div>

                            <div class="mt-32">
                                <h3>Final deign</h3>
                                <div class="max-w-150 mx-auto">
                                    <Image
                                            src={HighFide}
                                            alt=""
                                            class="w-full mt-8 rounded-lg"
                                        />
                                </div>
                            </div>
                            <h3 class="text-center mt-32">The rest is currently in progress...</h3>
                        </section>
                        <!-- User Feedback Section -->
                        <section id="User-feedback" class="mt-64"></section>
                        <!-- Reflection -->
                        <section id="Reflection" class="mt-64"></section>
                    </div>
                </div>
            </section>
        </section>
    </main>
</Layout>
