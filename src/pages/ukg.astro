    gsap.registerPlugin(ScrollTrigger);
    let approachContext: ReturnType<typeof gsap.context> | undefined;
    function setupApproachAnimation() {
        approachContext?.revert();
        const steps = document.querySelector<HTMLOListElement>(".ukg-approach-steps");
        if (!steps || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        approachContext = gsap.context(() => {
            const rows = Array.from(steps.querySelectorAll<HTMLElement>(".ukg-approach-step"));
            const timeline = gsap.timeline({ scrollTrigger: { trigger: steps, start: "top 78%", once: true } });
            rows.forEach((row, index) => {
                const content = row.querySelectorAll(".ukg-approach-number, h4, .ukg-approach-illustration, .ukg-approach-detail");
                const line = row.querySelector(".ukg-approach-connector");
                timeline.from(content, { autoAlpha: 0, y: "-=14", duration: 0.25, ease: "power2.out" }, index * 0.3);
                if (line) timeline.from(line, { scaleY: 0, duration: 0.2, ease: "power1.inOut" }, index * 0.3 + 0.15);
            });
        }, steps);
        ScrollTrigger.refresh();
    }
    setupApproachAnimation();
    document.addEventListener("astro:page-load", setupApproachAnimation);
    document.addEventListener("astro:before-swap", () => { approachContext?.revert(); approachContext = undefined; });
</script>

