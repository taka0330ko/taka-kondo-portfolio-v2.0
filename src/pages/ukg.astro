                                    </div>
                                    <div>
                                        <h4>Calendar</h4>
                                        <p class="mt-6">
                                            Using darker horizontal grid lines than
                                            vertical lines improves readability and
                                            makes time progression easier to scan.
                                        </p>
                                        <p class="mt-6">
                                            Emphasizing date numbers makes dates
                                            easier to identify at a glance.
                                        </p>
                                    </div>
                                </div>
                                <div
                                    class="grid gap-16 md:grid-cols-[1.4fr_1fr] md:items-center"
                                >
                                    <div class="bg-frame border-gray-100 p-4 rounded-lg">
                                        <Image
                                            src={WorkCellUI}
                                            alt="Work cell UI showing time entry variations for regular hours, late clock-in, and overtime states"
                                            class="mx-auto w-full max-w-130 rounded-lg bg-(--brand-gray-200)"
