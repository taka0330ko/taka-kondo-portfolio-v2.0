                        </div>

                        <div
                            class="mt-16 grid items-center gap-10 rounded-lg bg-frame px-6 py-12 md:grid-cols-[minmax(18rem,0.9fr)_minmax(0,1.4fr)] md:gap-16 md:px-12 md:py-16"
                        >
                            <div
                                class="rounded-lg bg-text-block p-6 md:max-w-110"
                            >
                                <dl class="space-y-6">
                                    <div>
                                        <dt
                                            class="text-sm uppercase text-body-default/65"
