<style>
    .ukg-image-trigger { position: relative; display: block; width: 100%; max-width: 24rem; justify-self: center; padding: 0; cursor: pointer; border-radius: 0.25rem; }
    .ukg-image-zoom-icon { position: absolute; bottom: 0.75rem; right: 0.75rem; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; background: rgb(255 255 255 / 92%); color: #171717; border-radius: 50%; box-shadow: 0 2px 12px #0002; opacity: 0; transform: translateY(4px); transition: opacity 200ms, transform 200ms; }
    .ukg-image-trigger:hover .ukg-image-zoom-icon, .ukg-image-trigger:focus-visible .ukg-image-zoom-icon { opacity: 1; transform: none; }
    .ukg-image-trigger:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
    .ukg-image-dialog { position: fixed; inset: 0; width: 100vw; max-width: none; height: 100dvh; max-height: none; padding: 3.5rem 1.5rem 1.5rem; margin: 0; border: 0; background: transparent; overflow: hidden; }
    .ukg-image-dialog[open] { display: grid; place-items: center; }
    .ukg-image-dialog::backdrop { background: rgb(10 15 20 / 72%); backdrop-filter: blur(5px); animation: ukg-backdrop-in 300ms ease-out; }
    .ukg-image-dialog > img { display: block; width: auto; height: auto; max-width: min(90vw, 1200px); max-height: calc(100dvh - 6rem); object-fit: contain; border-radius: 0.375rem; box-shadow: 0 16px 64px #0004; }
    .ukg-image-close { position: absolute; top: 1rem; right: 1.5rem; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: #fff; color: #171717; cursor: pointer; }
    @keyframes ukg-backdrop-in { from { opacity: 0; } to { opacity: 1; } }
    @media (hover: none) { .ukg-image-zoom-icon { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .ukg-image-dialog::backdrop { animation: none; } }
</style>
<script>
    function setupUkgImageZoom() {
        const dialog = document.querySelector<HTMLDialogElement>("#ukg-image-dialog");
        const expanded = dialog?.querySelector<HTMLImageElement>("[data-enlarged-image]");
        if (!dialog || !expanded || dialog.dataset.ready) return;
        dialog.dataset.ready = "true";
        const modal = dialog;
        const image = expanded;
        let source: HTMLImageElement | null = null;
        let trigger: HTMLButtonElement | null = null;
        let busy = false;
        let savedOverflow = "";
        const reduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        function thumbnailTransform() {
            const from = source!.getBoundingClientRect();
            const to = image.getBoundingClientRect();
            return `translate(${from.left + from.width / 2 - to.left - to.width / 2}px, ${from.top + from.height / 2 - to.top - to.height / 2}px) scale(${from.width / to.width}, ${from.height / to.height})`;
        }
        document.querySelectorAll<HTMLButtonElement>("[data-image-zoom]").forEach((button) => {
            button.addEventListener("click", async () => {
                if (busy || modal.open) return;
                source = button.querySelector("img");
                if (!source) return;
                trigger = button;
                image.src = source.currentSrc || source.src;
                image.alt = source.alt;
                busy = true;
                try { await image.decode(); } catch {}
                savedOverflow = document.documentElement.style.overflow;
                document.documentElement.style.overflow = "hidden";
                modal.showModal();
                const transform = thumbnailTransform();
                source.style.visibility = "hidden";
                await image.animate([{ transform, opacity: 0.6 }, { transform: "none", opacity: 1 }], { duration: reduced() ? 0 : 380, easing: "cubic-bezier(.22,1,.36,1)" }).finished;
                busy = false;
            });
        });
        async function closeImage() {
            if (busy || !modal.open) return;
            busy = true;
            if (source) await image.animate([{ transform: "none", opacity: 1 }, { transform: thumbnailTransform(), opacity: 0.5 }], { duration: reduced() ? 0 : 280, easing: "cubic-bezier(.4,0,.2,1)" }).finished;
            modal.close();
            busy = false;
        }
        modal.querySelector("[data-image-close]")?.addEventListener("click", closeImage);
        modal.addEventListener("click", (event) => { if (event.target === modal) closeImage(); });
        modal.addEventListener("cancel", (event) => { event.preventDefault(); closeImage(); });
        modal.addEventListener("close", () => {
            if (source) source.style.visibility = "";
            document.documentElement.style.overflow = savedOverflow;
            trigger?.focus({ preventScroll: true });
        });
        document.addEventListener("astro:before-swap", () => { if (modal.open) modal.close(); }, { once: true });
    }
    setupUkgImageZoom();
    document.addEventListener("astro:page-load", setupUkgImageZoom);
</script>

