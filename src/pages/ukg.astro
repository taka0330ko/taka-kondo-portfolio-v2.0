---
// Page layout
import Layout from "../layouts/Layout.astro";
import { ukgJa, ukgJaMeta } from "../content/ja/ukg";
import { homeJa } from "../content/ja/home";

// Astro utilities
import Image from "astro/components/Image.astro";

// UI components
import BreadCrumb from "../components/ui/BreadCrumb.astro";
import CaseStudySidebar from "../components/ui/CaseStudySidebar.astro";
import Card from "../components/ui/Card.astro";
import CodeWindow from "../components/ui/CodeWindow.astro";
import ColorTokens from "../assets/images/projects/UKG/semantic-color-tokens.png";
import FontSizeTokens from "../assets/images/projects/UKG/semantic-font-size-tokens.png";
import SpacingTokens from "../assets/images/projects/UKG/semantic-spacing-tokens.png";
import RadiusTokens from "../assets/images/projects/UKG/semantic-radius-tokens.png";
import UkgWorkCellsDemo from "../components/ui/UkgWorkCellsDemo.astro";
import UkgCalendarDemo from "../components/ui/UkgCalendarDemo.astro";
import ProjectMainVideo from "../components/ui/ProjectMainVideo.astro";
import GlassPill from "../components/ui/GlassPill.astro";
import BeforeAfterToggle from "../components/ui/BeforeAfterToggle.astro";
import ToolPill from "../components/ui/ToolPill.astro";

// Icons
import { ArrowUpRight, Notebook, NotebookPen, ZoomIn, X } from "@lucide/astro";
import GoogleFormIcon from "../assets/images/icons/stacks/google-form.svg";
import FigmaIcon from "../assets/images/icons/stacks/figma.svg";
import ReactIcon from "../assets/images/icons/stacks/react.svg";
import TailwindIcon from "../assets/images/icons/stacks/tailwind.svg";

// Project data
import { postsDataCode } from "../data/ukgCode";
import { projects } from "../data/projects";

const isJapanese = Astro.url.pathname === "/jp/ukg";
const t = (text: string) => isJapanese ? (ukgJa[text] ?? text) : text;
const relatedProjects = projects
    .filter((project) =>
        ["/ukg", "/tastebuds", "/billow"].includes(project.href) &&
        project.href !== "/ukg"
    )
    .slice(0, 2)
    .map((project) => isJapanese
        ? { ...project, ...homeJa.projects[project.slug], href: `/jp${project.href}` }
        : project
    );

// Hero media
import UKGHeroVideo from "../assets/images/projects/UKG/videos/dashboard-motion-thumbnail.mp4";
import UKGVideo from "../assets/images/projects/UKG/videos/prototype-walkthrough.mp4";

// Research media
import Survey from "../assets/images/projects/UKG/survey.webp";
import Cashier from "../assets/images/projects/UKG/cashier.svg";
import GroceryStaff from "../assets/images/projects/UKG/grocery.svg";
import Schedule from "../assets/images/projects/UKG/schedle.webp";
import TotalHours from "../assets/images/projects/UKG/total-hours.webp";
import SadIcon from "../assets/images/projects/UKG/sad.svg";
import SmileIcon from "../assets/images/projects/UKG/smile.svg";

// Process layer graphics
import UXResearchLayer from "../assets/images/projects/UKG/ux-research-layer.svg";
import UIDesignLayer from "../assets/images/projects/UKG/uidesign-layer.svg";
import InterviewLayer from "../assets/images/projects/UKG/interview-layer.svg";
import FormLayer from "../assets/images/projects/UKG/form-layer.svg";
import DevLayer from "../assets/images/projects/UKG/dev-layer.svg";
import TestingLayer from "../assets/images/projects/UKG/testing-layer.svg";

// Design process media
import MidFide from "../assets/images/projects/UKG/mid-fide.webp";
import MyUKGPage from "../assets/images/projects/UKG/my-ukg-page.webp";
import NewLogo from "../assets/images/projects/UKG/ukg-new-logo.png";

// Design system media

// Prototype and testing media
import BrandDirectionPreview from "../assets/images/projects/UKG/brand-direction-preview.png";
import BrandPreviousLogo from "../assets/images/projects/UKG/brand-previous-logo.png";
import UkgTokenFlow from "../components/ui/UkgTokenFlow.astro";
import OriginalDesign from "../assets/images/projects/UKG/original-design.webp";
import HighFide from "../assets/images/projects/UKG/final-redesign-sidebar-expanded.png";
import Testers from "../assets/images/projects/UKG/testers.webp";

const ukgSections = [
    { label: t("Overview"), href: "#Overview" },
    { label: t("Research"), href: "#Research" },
    { label: t("UI Design"), href: "#UI-design" },
    { label: t("Prototype Development"), href: "#Prototype-dev" },
    { label: t("User Feedback"), href: "#User-feedback" },
    { label: t("Reflection"), href: "#Reflection" },
];
---

<Layout title={isJapanese ? ukgJaMeta.title : undefined} description={isJapanese ? ukgJaMeta.description : undefined}>
    <main class:list={["mt-30 md:mt-40", { "case-study-ja": isJapanese }]}>
        <!-- Breadcrumb -->
        <div class="container pl-8">
            <BreadCrumb>{t("UKG Redesign Project")}</BreadCrumb>
        </div>
        <section id="hero" aria-labelledby="ukg-redesign-overview">
            <div class="grid grid-cols-12 grid-container items-start">
                <div class="col-span-8">
                    <h1 id="ukg-redesign-overview" class="mt-8 ukg-hero-title">
                        {isJapanese
                            ? t("“How can I verify my work hours...?”")
                                .replace("。", "。\n")
                                .split("\n")
                                .map((line) => <span class="ukg-hero-title-line">{line}</span>)
                            : t("“How can I verify my work hours...?”")}
                    </h1>
                    <p class="mt-8 ukg-hero-description">
                        {t("The existing payroll screen showed total hours, but provided no way to verify them.")}
                    </p>
                    <div class="mt-8 md:my-8">
                        <GlassPill
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Open UKG prototype in a new tab"
                            href="https://ukg-pay-overview-design-md.vercel.app/v3/"
                        >
                            <ArrowUpRight
                                slot="after"
                                aria-hidden="true"
                                focusable="false"
                            />
                            {isJapanese ? "作ったものを見る" : "Prototype"}
                            <span class="sr-only">(opens in a new tab)</span>
                        </GlassPill>
                    </div>
                </div>
                <dl
                    class="order-3 md:order-2 grid gap-4 border-l border-accent pl-6 md:min-w-64 md:col-span-4"
                >
                    <div class="grid gap-2">
                        <dt class="text-caption uppercase tracking-wide">
                            Tool
                        </dt>
                        <dd class="flex flex-wrap gap-2">
                            <ToolPill label="Google Form">
                                <GoogleFormIcon slot="icon" />
                            </ToolPill>
                            <ToolPill label="Figma">
                                <FigmaIcon slot="icon" />
                            </ToolPill>
                            <ToolPill label="React">
                                <ReactIcon slot="icon" />
                            </ToolPill>
                            <ToolPill label="Tailwind">
                                <TailwindIcon slot="icon" />
                            </ToolPill>
                        </dd>
                    </div>
                    <div class="grid gap-1">
                        <dt
                            class="text-caption uppercase tracking-wide text-body-default"
                        >
                            {t("Role")}
                        </dt>
                        <dd class="text-body text-heading-default">
                            {t("UX Researcher / UI Designer / Front-end Developer")}
                        </dd>
                    </div>
                    <div class="grid gap-1">
                        <dt
                            class="text-caption uppercase tracking-wide text-body-default"
                        >
                            {t("Timeline")}
                        </dt>
                        <dd class="text-body  text-heading-default">
                            {t("One month, Apr-May, 2026")}
                        </dd>
                    </div>
                </dl>
                <div class="order-2 md:order-3 col-span-12">
                    <ProjectMainVideo src={UKGHeroVideo} />
                </div>
            </div>
        </section>
        <!-- ====================== Case Study Start ====================== -->
        <section class="mt-32">
            <div class="container flex flex-col lg:grid grid-cols-12">
                <aside
                    aria-label="Project section navigation"
                    class="col-start-1 col-span-2 p-4 sticky top-24 h-fit"
                >
                    <CaseStudySidebar
                        items={ukgSections}
                        className="col-start-1 col-span-2"
                    />
                </aside>
                <div class="px-4 md:px-8 md:col-start-3 col-span-10">
                    <!-- Overview Section -->
                    <section id="Overview" class="mt-16">
                        <h2 class="text-cs-section font-medium">
                            <span class="heading-accent-bar">{t("Overview")}</span>
                        </h2>
                        <div
                            class="h-px mt-4 min-w-0 flex-1 bg-body-default/35"
                        >
                        </div>

                        <div class="mt-12">
                            <div class="ukg-project-intro">
                            <p class="caption-pill">About this project</p>
                            <h3
                                class="mt-2 max-w-5xl text-cs-h1 font-normal leading-tight"
                            >
                                {t("Redesigning the payroll experience of \"UKG Pro\" to help employees understand and verify their payroll information.")}
                            </h3>

                            {isJapanese && (
                                <p class="ukg-project-context">アルバイト先で実際に使っているサービスを対象に、従業員の視点から給与確認画面を見直しました。</p>
                            )}

                            </div>

                            <div class="ukg-about-card mt-8 bg-text-block">
                                <div class="ukg-about-copy">
                                    <div class="ukg-about-header">
                                        <h4 class="ukg-about-heading">
                                            {isJapanese ? "UKG Proとは" : "About UKG Pro"}
                                        </h4>

                                    </div>
                                    <p class="ukg-about-description">
                                        {isJapanese
                                            ? "勤務時間の管理やシフト、給与明細の確認ができる従業員向けサービスです。"
                                            : t("An employee platform for managing work hours, accessing payroll information, and reviewing pay statements.")}
                                    </p>
                                    <a
                                        href="https://www.ukg.com/"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="ukg-about-link"
                                    >
                                        {isJapanese ? "UKG公式サイトを見る" : "Visit UKG website"}
                                        <ArrowUpRight class="size-4" aria-hidden="true" />
                                        <span class="sr-only">{isJapanese ? "（新しいタブで開きます）" : "(opens in a new tab)"}</span>
                                    </a>

                                </div>
                                <div class="ukg-carousel" data-ukg-carousel role="region" aria-label={isJapanese ? "UKGの紹介画像" : "UKG gallery"} aria-roledescription="carousel">
                                    <div class="ukg-carousel-viewport">
                                    <div class="ukg-carousel-stage">
                                        <figure data-slide class="ukg-carousel-slide">
                                            <Image alt="UKG" src={NewLogo} class="ukg-about-logo" />
                                        </figure>
                                        <figure data-slide class="ukg-carousel-slide" aria-hidden="true" inert>
                                            <Image src={MyUKGPage} alt={isJapanese ? "UKG Proのホーム画面" : "UKG Pro home screen"} class="ukg-carousel-photo" />
                                            <figcaption>{isJapanese ? "アルバイト先で実際に使っているUKG Proのホーム画面" : "The UKG home screen I use at work"}</figcaption>
                                        </figure>
                                    </div>
                                    </div>
                                    <div class="ukg-carousel-controls">
                                        <button type="button" data-prev aria-label={isJapanese ? "前の画像" : "Previous image"}>←</button>
                                        <span data-counter aria-live="polite" aria-atomic="true">1 / 2</span>
                                        <button type="button" data-next aria-label={isJapanese ? "次の画像" : "Next image"}>→</button>
                                    </div>
                                </div>
                            </div>

                            <div class="ukg-goal mt-28">
                                <p class="caption-pill">Goal</p>
                                <h4 class="ukg-goal-heading">
                                    {isJapanese ? "「給与の計算過程が分かる画面にしたい」" : t("Toward a More Transparent Payroll Experience")}
                                </h4>
                                <button type="button" class="ukg-image-trigger ukg-goal-zoom" data-image-zoom aria-haspopup="dialog" aria-controls="ukg-image-dialog" aria-label={isJapanese ? "画面を拡大する" : "Enlarge screenshot"}>
                                    <Image
                                        src={OriginalDesign}
                                        alt={isJapanese ? "改善前のUKG Pro給与確認画面。合計勤務時間は表示されるが、日ごとの内訳は確認できない。" : "Original UKG Pro payroll overview"}
                                        class="ukg-goal-image"
                                    />
                                    <span class="ukg-image-zoom-icon"><ZoomIn class="size-5" aria-hidden="true" /></span>
                                </button>
                                <p class="ukg-goal-description">
                                    {isJapanese
                                        ? "このプロジェクトは、そんな従業員の声をヒントに、利用体験を改善できる点を探るところから始めました。その過程を踏まえ、給与情報の根拠を理解し、自分で確かめられる体験に改善することを目標としました。"
                                        : `${t("This project began with UX research focused on UKG Pro, which I actively use at my part-time workplace primarily to review pay statements.")} ${t("The goal of the redesign was to improve transparency and verifiability within the payroll checking experience.")}`}
                                </p>
                            </div>

                            <div class="ukg-approach mt-28">
                                <p class="caption-pill">My Approach</p>
                                <h3 class="ukg-approach-heading">{t("A User-Centered Design Process")}</h3>
                                <p class="ukg-approach-description">
                                    {t("In this project, I first analyzed pain points through interviews and surveys conducted with real users, including my coworkers. Based on these insights, I designed the UI in Figma, built a prototype using AI-assisted development tools, and gathered feedback through participant evaluations.")}
                                </p>
                                <ol class="ukg-approach-steps">
                                    {[
                                        { label: t("UX Research"), image: UXResearchLayer, detail: isJapanese ? "インタビュー・アンケート" : "Interview & Survey" },
                                        { label: t("UI design"), image: UIDesignLayer, detail: "" },
                                        { label: t("Prototype Development"), image: DevLayer, detail: "" },
                                        { label: t("User Feedback"), image: TestingLayer, detail: "" },
                                    ].map((step, index) => (
                                        <li class="ukg-approach-step">
                                            {index < 3 && <span class="ukg-approach-connector" aria-hidden="true"></span>}
                                            <span class="ukg-approach-number">{index + 1}</span>
                                            <img src={step.image.src} alt="" loading="lazy" class="ukg-approach-illustration" />
                                            <h4>{step.label}</h4>
                                            {step.detail && <span class="ukg-approach-detail">{step.detail}</span>}
                                        </li>
                                    ))}
                                </ol>
                            </div>
                        </div>
                    </section>
                    <!-- Research Section -->
                    <section id="Research" class="mt-32">
                        <h2 class="text-cs-section font-medium">
                            <span class="heading-accent-bar">{t("Research")}</span>
                        </h2>
                        <div
                            class="h-px mt-4 min-w-0 flex-1 bg-body-default/35"
                        >
                        </div>
                        <div class="ukg-research-lead">
                            <div class="ukg-research-intro">
                                <h2 class="text-cs-h2">
                                    {t("A challenge uncovered through everyday conversations with coworkers")}
                                </h2>
                                <p class="text-cs-body">
                                    {t("During a regular day at work, a conversation about checking payroll in UKG revealed a shared frustration among my coworkers and myself. To better understand the issue, I conducted interviews with other coworkers.")}
                                </p>
                            </div>
                            <Image class="ukg-research-lead-image" src={InterviewLayer} alt="Interview research illustration" loading="lazy" />
                        </div>

                        <div class="ukg-interviews my-16">
                            {[
                                { quote: "“I can see the total hours worked, but I can’t see the breakdown.”", role: "Grocery Staff", person: GroceryStaff, screen: TotalHours, alt: "UKG screenshot showing total hours worked without breakdown" },
                                { quote: "“The punch records should exist somewhere, but I can’t verify them in UKG Pro. The schedule only shows assigned shifts.”", role: "Cashier", person: Cashier, screen: Schedule, alt: "UKG schedule showing assigned shifts without punch records" },
                            ].map((interview, index) => (
                                <article class="ukg-interview">
                                    <h3 class="sr-only">Interview {index + 1}</h3>
                                    <div class="ukg-interview-copy">
                                        <blockquote>{t(interview.quote)}</blockquote>
                                        <div class="ukg-interview-person">
                                            <Image src={interview.person} alt="" loading="lazy" />
                                            <span>{t(interview.role)}</span>
                                        </div>
                                    </div>
                                    <button type="button" class="ukg-image-trigger" data-image-zoom aria-haspopup="dialog" aria-controls="ukg-image-dialog" aria-label={isJapanese ? "画面を拡大する" : "Enlarge screenshot"}>
                                        <Image src={interview.screen} alt={interview.alt} class="ukg-interview-screen" loading="lazy" />
                                        <span class="ukg-image-zoom-icon"><ZoomIn class="size-5" aria-hidden="true" /></span>
                                    </button>
                                </article>
                            ))}
                        </div>
                        <div class="mt-46">
                            <div class="ukg-research-lead">
                                <div class="ukg-research-intro">
                                    <h2 class="text-cs-h2">{t("Research Findings")}</h2>
                                    <p class="text-cs-body">
                                        {t("Conducted a survey to further validate existing pain points and identify strong user demand for better visibility into payroll records.")}
                                    </p>
                                </div>
                                <Image class="ukg-research-lead-image" src={FormLayer} alt="Survey form illustration representing research findings phase" loading="lazy" />
                            </div>

                            <div
                                class="flex flex-col justify-center items-center gap-8 md:gap-16 md:flex-row mx-auto mt-16"
                            >
                                <div
                                    class="bg-frame border-gray-100 p-4 rounded-lg max-w-150 mt-8 md:mt-0"
                                >
                                    <Image
                                        src={Survey}
                                        alt="User survey showing research findings about payroll transparency needs"
                                        class="w-100 rounded-lg"
                                    />
                                </div>

                                <div class="bg-text-block p-4 rounded-lg max-w-100">
                                    <div
                                        class="flex items-center gap-4 justify-center mb-4"
                                    >
                                        <h4>{t("Main findings")}</h4>
                                        <NotebookPen />
                                    </div>
                                    <ul class="list-disc pl-5">
                                        <li>
                                            {t("80% of participants said they would not feel confident verifying payroll calculations if an error occurred.")}
                                        </li>
                                        <li class="mt-4">
                                            {t("90% of participants wanted access to actual clock-in and clock-out records.")}
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="mt-28">
                            <div class="ukg-research-intro mx-auto mt-12">
                                <h2 class="text-cs-h2">
                                    {t("Existing User Journey Pain Points")}
                                </h2>
                                <p class="text-cs-body mt-4">
                                    {t("Users cannot verify how payroll hours are calculated, forcing them to rely on manual estimation instead of system transparency.")}
                                </p>
                            </div>
                            <ol class="ukg-pain-flow" aria-label={isJapanese ? "給与確認で行き詰まる流れの例" : "Example payroll verification journey"}>
                                {[
                                    { title: isJapanese ? "前回との違いに気づく" : "Notice a difference", body: isJapanese ? "同じシフトのはずなのに、前回は32時間。今回は29.18333時間。" : "The shifts seem the same, but the total changed from 32 to 29.18333 hours." },
                                    { title: isJapanese ? "打刻記録を確認したい" : "Try to check punch records", body: isJapanese ? "「打刻を忘れた日がある？」日ごとの記録を見て確かめたい。" : "Was a punch missed? Check daily records to find out." },
                                    { title: isJapanese ? "記録が見られず、原因がわからない" : "Cannot identify the cause", body: isJapanese ? "表示されるのは合計時間だけ。差の理由を確認できないまま終わる。" : "Only total hours are visible, leaving the difference unexplained." },
                                ].map((step, index) => (
                                    <li class="ukg-pain-step">
                                        <div class="ukg-pain-meta">
                                            <span class="ukg-pain-number" aria-hidden="true">0{index + 1}</span>
                                            <svg class="ukg-pixel-face" viewBox="0 0 24 24" role="img" aria-label={isJapanese ? ["疑問", "不安", "困り果てる"][index] : ["Skeptical", "Worried", "Distressed"][index]} shape-rendering="crispEdges">
                                                <path d="M6 2h12v2h2v2h2v12h-2v2h-2v2H6v-2H4v-2H2V6h2V4h2z" fill="none" />
                                                <path d="M6 2h12v2H6zM4 4h2v2H4zM18 4h2v2h-2zM2 6h2v12H2zM20 6h2v12h-2zM4 18h2v2H4zM18 18h2v2h-2zM6 20h12v2H6z" fill="currentColor" />
                                                {index === 0 && <g fill="currentColor"><path d="M6 6h6v2H6zM14 8h4v2h-4zM8 9h2v3H8zM15 10h2v2h-2zM8 16h8v2H8z" /></g>}
                                                {index === 1 && <><path d="M6 7h4v2H6zM14 7h4v2h-4zM8 10h2v2H8zM14 10h2v2h-2zM9 15h6v2H9zM7 17h2v2H7zM15 17h2v2h-2z" fill="currentColor" /><path d="M18 10h2v4h-2zM17 14h4v3h-4z" fill="#55BCE8" /></>}
                                                {index === 2 && <g fill="currentColor"><path d="M6 7h2v2H6zM8 9h3v2H8zM6 11h2v2H6zM16 7h2v2h-2zM13 9h3v2h-3zM16 11h2v2h-2zM8 15h8v2H8zM6 17h12v2H6z" /></g>}
                                            </svg>
                                        </div>
                                        <h3>{step.title}</h3>
                                        <p>{step.body}</p>
                                    </li>
                                ))}
                            </ol>
                        </div>

                        <div class="ukg-design-direction mt-32">
                            <p class="caption-pill">DESIGN CHALLENGE</p>
                            <h2 class="ukg-direction-heading">{isJapanese ? "日ごとの打刻記録から、勤務時間の内訳を確かめられる画面へ" : t("Improve payroll transparency by providing visibility into clock-in and clock-out records.")}</h2>

                            <section class="ukg-user-story" aria-labelledby="ukg-story-heading">
                                <div class="ukg-story-intro">
                                    <h3 id="ukg-story-heading">{isJapanese ? "ユーザーストーリーの決定" : "User story"}</h3>
                                </div>
                                <div class="ukg-story-content">
                                    <Image src={GroceryStaff} alt="" class="ukg-story-person" />
                                    <div class="ukg-story-text">
                                        <blockquote>{isJapanese ? "従業員として、出退勤の打刻履歴を確認したい。給与に反映された勤務時間が、どのように計算されたのかを自分で確かめるために。" : "As an employee, I want to review my clock-in and clock-out history so that I can verify how my payroll hours were calculated."}</blockquote>
                                        {isJapanese && <p class="ukg-story-english" lang="en">As an employee, I want to review my clock-in and clock-out history so that I can verify how my payroll hours were calculated.</p>}
                                    </div>
                                </div>
                            </section>
                            <div class="ukg-direction-layout">
                            <p class="ukg-direction-description">{isJapanese ? "給与確認画面に、出退勤時刻と日ごとの勤務時間を追加。予定されたシフトと実際の記録を照らし合わせ、勤務時間のずれや打刻漏れに気づける構成を目指しました。" : "The proposed screen adds daily worked hours and clock-in/out records, allowing employees to compare scheduled shifts with actual records."}</p>
                            <figure class="ukg-direction-figure">
                                <button type="button" class="ukg-image-trigger ukg-direction-zoom" data-image-zoom aria-haspopup="dialog" aria-controls="ukg-image-dialog" aria-label={isJapanese ? "画面案を拡大する" : "Enlarge wireframe"}>
                                    <Image src={MidFide} alt={isJapanese ? "日ごとの勤務時間と打刻記録を追加した給与確認画面のワイヤーフレーム" : "Payroll wireframe with daily hours and punch records"} class="ukg-direction-image" />
                                    <span class="ukg-image-zoom-icon"><ZoomIn class="size-5" aria-hidden="true" /></span>
                                </button>

                            </figure>
                            </div>
                        </div>
                    </section>
                    <!-- UI Design Section -->
                    <section id="UI-design" class="mt-64">
                        <h2 class="text-cs-section font-medium">
                            <span class="heading-accent-bar">{t("UI Design")}</span>
                        </h2>
