<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("astro:page-load", () => {
        // This script stays loaded across ClientRouter navigations,
        // so bail out on every page except this one.
        if (!["/ukg", "/jp/ukg"].includes(window.location.pathname.replace(/\/$/, ""))) return;

        const refresh = () =>
            requestAnimationFrame(() => ScrollTrigger.refresh());

        gsap.fromTo(
            "#case-study-sidebar",
            { x: -32, opacity: 0 },
            {
                x: 0,
                opacity: 1,
                duration: 0.8,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: "#hero",
                    start: "bottom 30%",
                    toggleActions: "play none none reverse",
                    invalidateOnRefresh: true,
                },
            },
        );

        refresh();
        setTimeout(refresh, 300);
    });
</script>

