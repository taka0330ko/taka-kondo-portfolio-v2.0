---
import Layout from "../layouts/Layout.astro";
import BreadCrumb from "../components/ui/BreadCrumb.astro";
import Card from "../components/ui/Card.astro";
import { projects } from "../data/projects";

//Images
import HeroImage from "../assets/images/projects/xeno/Hero-image.jpg";
import AppMockUp from "../assets/images/projects/xeno/App-Mockup.jpg";
import TypoColor from "../assets/images/projects/xeno/Typiography-Color.jpg";
import XenoThumbnail from "../assets/images/projects/xeno/xeno-thumbnail.jpg";
import { Image } from "astro:assets";
---

<Layout>
    <main class="px-8 pt-32 pb-24 md:pt-40 md:pb-32">
        <section class="mx-auto flex max-w-360 flex-col gap-20 md:gap-28">
            <div class="grid gap-10 md:grid-cols-12 md:items-end">
                <div class="md:col-span-8">
                    <BreadCrumb>XENO</BreadCrumb>
                    <h1 class="max-w-220">
                        XENO redefines activewear shopping with AI
                        personalization and seamless recommendations.
                    </h1>
                </div>
                <div class="md:col-span-4 md:flex md:justify-end">
                    <dl class="grid gap-4 border-l border-accent pl-6 md:min-w-64">
                        <div class="grid gap-1">
                            <dt class="text-caption uppercase tracking-wide text-body-default">
                                Industry
                            </dt>
                            <dd class="text-title font-medium text-heading-default">
                                Ecommerce
                            </dd>
                        </div>
                        <div class="grid gap-1">
                            <dt class="text-caption uppercase tracking-wide text-body-default">
                                Category
                            </dt>
                            <dd class="text-title font-medium text-heading-default">
                                Mobile App
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            <Image
                src={HeroImage}
                alt="XENO activewear ecommerce app hero image"
                class="w-full rounded-lg"
            />

            <div class="grid gap-8 md:grid-cols-2 md:items-start">
                <div class="flex flex-col gap-6">
                    <h2>Designed for smarter movement.</h2>
                    <p>
                        Discover, match, and shop activewear through a smarter,
                        more personalized experience designed to fit your
                        movement, preferences, and lifestyle.
                    </p>
                </div>
                <Image
                    src={XenoThumbnail}
                    alt="XENO project thumbnail"
                    class="w-full rounded-lg"
                />
            </div>

            <Image
                src={TypoColor}
                alt="XENO typography and color system"
                class="w-full rounded-lg"
            />

            <div class="grid gap-8 md:grid-cols-12 md:items-center">
                <div class="md:col-span-4">
                    <h2>Personalized from first tap.</h2>
                    <p class="mt-6">
                        From the first tap, XENO understands your preferences
                        and helps you discover the right activewear through
                        personalized recommendations and a seamless experience.
                    </p>
                </div>
                <Image
                    src={AppMockUp}
                    alt="XENO mobile app mockup"
                    class="w-full rounded-lg md:col-span-8"
                />
            </div>
        </section>

        <section class="pt-24 md:pt-32">
            <h2 class="text-center p-16">Other Projects</h2>
            <div
                class="grid grid-cols-1 md:grid-cols-2 grid-rows-auto gap-4 max-w-400 mx-auto"
            >
                {
                    projects
                        .filter(
                            (project) =>
                                ["/ukg", "/tastebuds", "/billow"].includes(
                                    project.href,
                                ) && project.href !== "/xeno",
                        )
                        .slice(0, 2)
                        .map((project) => {
                            return (
                                <Card
                                    href={project.href}
                                    cover={project.cover}
                                    title={project.title}
                                    description={project.description}
                                    tag={project.tag}
                                />
                            );
                        })
                }
            </div>
        </section>
    </main>
</Layout>
