---
// Page layout
import Layout from "../layouts/Layout.astro";

// Astro utilities
import Image from "astro/components/Image.astro";

// UI components
import BreadCrumb from "../components/ui/BreadCrumb.astro";
import CaseStudySidebar from "../components/ui/CaseStudySidebar.astro";
import ProjectMainVideo from "../components/ui/ProjectMainVideo.astro";
import GlassPill from "../components/ui/GlassPill.astro";

// Icons
import { ArrowUpRight } from "@lucide/astro";

// Hero media
import StoreMapVideo from "../assets/images/projects/store-navigation/videos/store-map-thumbnail.webm";
import StoreMapPoster from "../assets/images/projects/store-navigation/store-navigation-thimbnail-coming-soon.webp";

// Overview media
import StoreMapModel from "../assets/images/projects/store-navigation/store-map-model.webp";
import Walmart from "../assets/images/projects/store-navigation/walmart.webp";
import ClaudeFigma from "../assets/images/projects/store-navigation/claude-figma.webp";
import ReactNative from "../assets/images/projects/store-navigation/react-native.webp";

// Context & Opportunity media
import IconCustomer from "../assets/images/projects/store-navigation/icon-customer.svg";
import IconStaff from "../assets/images/projects/store-navigation/icon-staff.svg";
import UserFlow from "../assets/images/projects/store-navigation/userflow.webp";

// Design Constraints media
import ColorPalette from "../assets/images/projects/store-navigation/color-palette-primary-brand-colors.webp";
import FigmaTokensPanel from "../assets/images/projects/store-navigation/figma-variables-color-tokens-panel.webp";
import TokenMappingDiagram from "../assets/images/projects/store-navigation/design-tokens-semantic-mapping-diagram.webp";
import ItemFoundView from "../assets/images/projects/store-navigation/store-map-app-item-found-view.webp";

// AI Assisted Workflow media
import MapPixcel from "../assets/images/projects/store-navigation/map-pixcel.webp";
import FigmaMcp from "../assets/images/projects/store-navigation/figma-mcp.webp";
import MapOnFigma from "../assets/images/projects/store-navigation/map-on-figma.webp";
import SvgCode from "../assets/images/projects/store-navigation/svg-code.webp";

export const storeMapSections = [
    { label: "Overview", href: "#Overview" },
    { label: "Context & Opportunity", href: "#Context-opportunity" },
    { label: "Design Constraints", href: "#Design-constraints" },
    { label: "AI Assisted Workflow", href: "#AI-assisted-workflow" },
    { label: "User Testing", href: "#User-testing" },
    { label: "Reflection", href: "#Reflection" },
];
---

<Layout>
    <main class="mt-30 md:mt-40">
        <!-- Breadcrumb -->
        <div class="container pl-8">
            <BreadCrumb>Grocery Store Map Navigation</BreadCrumb>
        </div>
        <section id="hero" aria-labelledby="store-map-overview">
            <div class="grid grid-cols-12 grid-container items-start">
                <div class="col-span-8">
                    <h1 class="mt-8">
                        Why is finding a product in a supermarket still so
                        difficult?
                    </h1>
                    <p class="mt-8">
                        Rethinking grocery navigation with interactive maps and
                        intelligent routing.
                    </p>
                    <div class="mt-8 md:my-8">
                        <GlassPill
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Open Grocery Store Map Navigation prototype in a new tab"
                            href="#"
                        >
                            <ArrowUpRight
                                slot="after"
                                aria-hidden="true"
                                focusable="false"
                            />
                            Prototype
                            <span class="sr-only">(opens in a new tab)</span>
                        </GlassPill>
                    </div>
                </div>
                <dl
                    class="order-3 md:order-2 grid gap-4 border-l border-accent pl-6 md:min-w-64 md:col-span-4"
                >
                    <div class="grid gap-1">
                        <dt class="text-caption uppercase tracking-wide">
                            Tool
                        </dt>
                        <dd class="font-medium text-body text-heading-default">
                            Figma + MCP / Claude code
                        </dd>
                        <dd class="font-medium text-body text-heading-default">
                            React Native / Express API / MySQL
                        </dd>
                    </div>
                    <div class="grid gap-1">
                        <dt
                            class="text-caption uppercase tracking-wide text-body-default"
                        >
                            Role
                        </dt>
                        <dd class="text-body font-medium text-heading-default">
                            UX Research / UI Design / Frontend Development
                        </dd>
                    </div>
                    <div class="grid gap-1">
                        <dt
                            class="text-caption uppercase tracking-wide text-body-default"
                        >
                            Timeline
                        </dt>
                        <dd class="text-body font-medium text-heading-default">
                            One month, Jun - Jul, 2026
                        </dd>
                    </div>
                </dl>
                <div class="order-2 md:order-3 col-span-12">
                    <ProjectMainVideo
                        src={StoreMapVideo}
                        poster={StoreMapPoster.src}
                    />
                </div>
            </div>
        </section>
        <!-- ====================== Case Study Start ====================== -->
        <section class="mt-32">
            <div class="container flex flex-col lg:grid grid-cols-12">
                <aside
                    aria-label="Project section navigation"
                    class="col-start-1 col-span-2 p-4 sticky top-24 h-fit"
                >
                    <CaseStudySidebar
                        items={storeMapSections}
                        className="col-start-1 col-span-2"
                    />
                </aside>
                <div class="px-4 md:px-8 md:col-start-3 col-span-10">
                    <!-- Overview Section -->
                    <section id="Overview" class="mt-16">
                        <h2 class="text-cs-section font-medium">
                            <span class="heading-accent-bar">Overview</span>
                        </h2>
                        <div
                            class="h-px mt-4 min-w-0 flex-1 bg-body-default/35"
                        >
                        </div>

                        <div class="mt-12">
                            <div class="max-w-240 mx-auto">
                                <p class="caption-pill">About this project</p>
                                <h3
                                    class="mt-2 max-w-5xl text-cs-h1 font-normal leading-tight"
                                >
                                    Designing a seamless grocery shopping
                                    experience by combining product search with
                                    in-store navigation.
                                </h3>
                            </div>

                            <div class="mt-16 flex justify-center">
                                <Image
                                    src={StoreMapModel}
                                    alt="Hand holding a phone showing the store map app overlaid on a grocery aisle, with pins marking product locations on the shelves"
                                    class="w-full max-w-160 rounded-lg"
                                />
                            </div>

                            <div class="mt-28 max-w-240 mx-auto">
                                <p class="caption-pill">Main objective</p>
                                <h2
                                    class="mt-2 max-w-220 text-cs-h2 leading-snug"
                                >
                                    Less Wandering. More Shopping.
                                </h2>
                                <p class="text-cs-body mt-2">
                                    Help shoppers in large supermarkets quickly
                                    find the products they need, reducing time
                                    spent wandering through unfamiliar aisles.
                                </p>
                            </div>

                            <div class="mt-28 max-w-240 mx-auto">
                                <p class="caption-pill">Project highlight</p>
                                <h2
                                    class="mt-2 max-w-220 text-cs-h2 leading-snug"
                                >
                                    Design × AI Tools × Development
                                </h2>
                                <p class="text-cs-body mt-2">
                                    Designed, built, and validated an
                                    interactive grocery navigation experience
                                    through user-centered design, AI-assisted
                                    workflows, and React Native development.
                                </p>
                            </div>

                            <div class="mt-24 grid gap-12 md:grid-cols-3">
                                <div class="grid gap-6 md:first:pl-0">
                                    <h4 class="text-cs-h3 flex gap-4">
                                        <span class="feature-number">01</span>
                                        <span class="text-cs-h3"
                                            >Design Constraints</span
                                        >
                                    </h4>
                                    <div
                                        class="grid grid-cols-5 md:grid-cols-1"
                                    >
                                        <Image
                                            src={Walmart}
                                            alt="Walmart brand mark"
                                            class="h-34 w-auto object-contain mx-auto col-span-2"
                                        />
                                        <p
                                            class="text-cs-body col-span-3 place-content-center"
                                        >
                                            Designed an additional Walmart app
                                            feature to gain experience working
                                            within an enterprise design system.
                                        </p>
                                    </div>
                                    <!-- <a
                                        href="https://brandcenter.walmart.com/brand"
                                        >https://brandcenter.walmart.com/brand</a
                                    > -->
                                </div>
                                <div class="grid gap-6 md:pl-8">
                                    <h4 class="text-cs-h3 flex gap-4">
                                        <span class="feature-number">02</span>
                                        <span class="text-cs-h3">
                                            AI Assisted Workflow</span
                                        >
                                    </h4>
                                    <div
                                        class="grid grid-cols-5 md:grid-cols-1"
                                    >
                                        <Image
                                            src={ClaudeFigma}
                                            alt="Claude Code and Figma MCP icons"
                                            class="h-34 w-auto object-contain mx-auto col-span-2"
                                        />
                                        <p
                                            class="text-cs-body col-span-3 place-content-center"
                                        >
                                            Built an AI-assisted design-to-code
                                            workflow using Claude Code and Figma
                                            MCP.
                                        </p>
                                    </div>
                                </div>
                                <div class="grid gap-6 md:pl-8">
                                    <h4 class="text-cs-h3 flex gap-4">
                                        <span class="feature-number">03</span>
                                        <span class="text-cs-h3"
                                            >Validating Through Code</span
                                        >
                                    </h4>
                                    <div
                                        class="grid grid-cols-5 md:grid-cols-1"
                                    >
                                        <Image
                                            src={ReactNative}
                                            alt="React Native logo"
                                            class="h-34 w-auto object-contain mx-auto col-span-2"
                                        />
                                        <p
                                            class="text-cs-body col-span-3 place-content-center"
                                        >
                                            Built a React Native prototype to validate real interactions and usability.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- Context & Opportunity Section -->
                    <section id="Context-opportunity" class="mt-32">
                        <h2 class="text-cs-section font-medium">
                            <span class="heading-accent-bar"
                                >Context & Opportunity</span
                            >
                        </h2>
                        <div
                            class="h-px mt-4 min-w-0 flex-1 bg-body-default/35"
                        >
                        </div>

                        <div class="mt-16 max-w-240 mx-auto">
                            <p class="caption-pill">Background</p>
                            <h3
                                class="mt-4 max-w-4xl text-cs-h1 font-normal leading-tight"
                            >
                                A problem I witnessed every day while working at
                                a supermarket
                            </h3>
                            <p class="mt-4 text-cs-body leading-snug">
                                While working at a supermarket, I frequently saw
                                customers struggling to find products in large
                                stores with thousands of items. Even when the
                                products were available, many customers left
                                without finding them, highlighting the need for
                                a better in-store navigation experience.
                            </p>

                            <div class="mt-16 grid gap-12 md:grid-cols-2">
                                <div>
                                    <div class="flex items-center gap-3">
                                        <span
                                            aria-hidden="true"
                                            class="h-6 w-6 shrink-0 bg-heading-default mask-(--icon-customer-url) mask-no-repeat mask-contain"
                                            style={`--icon-customer-url: url('${IconCustomer.src}')`}
                                        >
                                        </span>
                                        <h4
                                            class="text-cs-body font-medium text-heading-default"
                                        >
                                            Customer side:
                                        </h4>
                                    </div>
                                    <ul class="mt-6 grid gap-5">
                                        <li class="text-cs-body">
                                            “I spend too much time walking
                                            around the store.”
                                        </li>
                                        <li class="text-cs-body">
                                            “I often have to ask staff where
                                            products are.”
                                        </li>
                                        <li class="text-cs-body">
                                            “Sometimes I leave without finding
                                            what I need.”
                                        </li>
                                        <li class="text-cs-body">
                                            “I forget what I came to buy.”
                                        </li>
                                    </ul>
                                </div>
                                <div>
                                    <div class="flex items-center gap-3">
                                        <span
                                            aria-hidden="true"
                                            class="h-6 w-6 shrink-0 bg-heading-default mask-(--icon-staff-url) mask-no-repeat mask-contain"
                                            style={`--icon-staff-url: url('${IconStaff.src}')`}
                                        >
                                        </span>
                                        <h4
                                            class="text-cs-body font-medium text-heading-default"
                                        >
                                            Store Staff side:
                                        </h4>
                                    </div>
                                    <ul class="mt-6 grid gap-5">
                                        <li class="text-cs-body">
                                            “Not every employee knows where
                                            every product is.”
                                        </li>
                                        <li class="text-cs-body">
                                            “Customers often interrupt us for
                                            directions.”
                                        </li>
                                        <li class="text-cs-body">
                                            “Category signs alone aren’t
                                            enough.”
                                        </li>
                                        <li class="text-cs-body">
                                            “Product location data would make
                                            our jobs easier.”
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="mt-28 max-w-240 mx-auto">
                            <p class="caption-pill">Design Goals</p>
                            <h2 class="mt-4 text-cs-h2 leading-snug">
                                Help shoppers find products quickly and
                                confidently
                            </h2>
                            <div class="mt-6 flex gap-4 items-start">
                                <span
                                    aria-hidden="true"
                                    class="h-8 w-8 shrink-0 mt-1 bg-heading-default mask-(--icon-customer-url) mask-no-repeat mask-contain"
                                    style={`--icon-customer-url: url('${IconCustomer.src}')`}
                                >
                                </span>
                                <p class="text-cs-body leading-snug">
                                    As a grocery shopper, I want to easily find
                                    the products I’m looking for, so that I can
                                    shop without getting lost.
                                </p>
                            </div>
                            <div class="mt-16 flex justify-center">
                                <Image
                                    src={UserFlow}
                                    alt="Hand holding a phone showing the store map app overlaid on a grocery aisle, with pins marking product locations on the shelves"
                                    class="w-full max-w-160 rounded-lg"
                                />
                            </div>
                        </div>
                    </section>
                    <!-- Design Constraints Section -->
                    <section id="Design-constraints" class="mt-32">
                        <h2 class="text-cs-section font-medium">
                            <span class="heading-accent-bar"
                                >Design Constraints</span
                            >
                        </h2>
                        <div
                            class="h-px mt-4 min-w-0 flex-1 bg-body-default/35"
                        >
                        </div>

                        <div class="mt-16 max-w-240 mx-auto">
                            <p class="caption-pill">Design Constraints</p>
                            <h3
                                class="mt-4 text-cs-h2 font-normal leading-tight"
                            >
                                Designing Within Brand Constraints
                            </h3>
                            <p class="mt-4 text-cs-body leading-snug">
                                Rather than creating a new design system from
                                scratch, I challenged myself to design within
                                the constraints of a real enterprise brand.
                                Since Walmart’s internal design system wasn’t
                                publicly available, I used its published brand
                                guidelines as the foundation for every design
                                decision.
                            </p>
                        </div>

                        <div
                            class="mt-24 max-w-240 mx-auto grid gap-10 md:grid-cols-2 md:items-center"
                        >
                            <div>
                                <p class="caption-pill">Constraint</p>
                                <h3 class="mt-4 text-cs-h2 font-normal leading-snug">
                                    Only Walmart’s brand guidelines were
                                    publicly available.
                                </h3>
                                <p class="mt-4 text-cs-body leading-snug">
                                    The internal UI components, design tokens,
                                    and implementation details were not
                                    accessible. Instead of attempting to
                                    replicate the private design system, I
                                    focused on preserving the brand’s visual
                                    language while creating a scalable
                                    foundation for new components.
                                </p>
                            </div>
                            <figure
                                class="bg-frame border-gray-100 p-4 rounded-lg"
                            >
                                <Image
                                    src={ColorPalette}
                                    alt="Walmart brand center color page showing the primary palette of True Blue, White, and Spark Yellow"
                                    class="w-full rounded-lg"
                                />
                                <figcaption
                                    class="mt-3 text-cs-caption text-body-default/70"
                                >
                                    <a
                                        href="https://brandcenter.walmart.com/brand/brand-identity/color"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="hover:underline"
                                        >https://brandcenter.walmart.com/brand/brand-identity/color</a
                                    >
                                </figcaption>
                            </figure>
                        </div>

                        <div
                            class="mt-24 max-w-240 mx-auto grid gap-10 md:grid-cols-2 md:items-center"
                        >
                            <div>
                                <p class="caption-pill">Decision</p>
                                <h3 class="mt-4 text-cs-h2 font-normal leading-snug">
                                    I translated the published brand
                                    principles into semantic design tokens.
                                </h3>
                                <p class="mt-4 text-cs-body leading-snug">
                                    Instead of applying brand colors directly
                                    to components, I introduced semantic
                                    tokens to make new UI patterns reusable
                                    and easier to maintain.
                                </p>
                            </div>
                            <div class="bg-frame border-gray-100 p-4 rounded-lg">
                                <Image
                                    src={FigmaTokensPanel}
                                    alt="Figma variables panel showing semantic color tokens for action, icon, background, and border"
                                    class="w-full rounded-lg"
                                />
                            </div>
                        </div>

                        <div class="mt-24 max-w-240 mx-auto">
                            <p class="caption-pill">Application</p>
                            <h3 class="mt-4 text-cs-h2 font-normal leading-snug">
                                The tokens powered reusable components across
                                the feature.
                            </h3>
                            <p class="mt-4 text-cs-body leading-snug">
                                Using the token system, I built reusable
                                components such as Item Pins and Item List
                                Icons that were applied consistently
                                throughout the Store Map experience. This
                                allowed new interactions to feel native to
                                Walmart’s existing visual language without
                                copying its internal design system.
                            </p>

                            <div
                                class="mt-12 grid gap-8 md:grid-cols-[1.4fr_1fr] md:items-center"
                            >
                                <Image
                                    src={TokenMappingDiagram}
                                    alt="Diagram mapping semantic background, border, icon, and action tokens to an item pin's inactive and active states"
                                    class="w-full rounded-lg"
                                />
                                <div
                                    class="bg-frame border-gray-100 p-4 rounded-lg mx-auto w-full max-w-80"
                                >
                                    <Image
                                        src={ItemFoundView}
                                        alt="Store Map app screen showing an item found view with the product highlighted at aisle 8B on the store map"
                                        class="w-full rounded-lg"
                                    />
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- AI Assisted Workflow Section -->
                    <section id="AI-assisted-workflow" class="mt-32">
                        <h2 class="text-cs-section font-medium">
                            <span class="heading-accent-bar"
                                >AI Assisted Workflow</span
                            >
                        </h2>
                        <div
                            class="h-px mt-4 min-w-0 flex-1 bg-body-default/35"
                        >
                        </div>

                        <!-- Objective -->
                        <div class="mt-16 max-w-240 mx-auto">
                            <p class="caption-pill">Objective</p>
                            <h3
                                class="mt-4 max-w-3xl text-cs-h2 font-normal leading-tight"
                            >
                                Implementing the Store Map
                            </h3>
                            <p class="mt-4 max-w-2xl text-cs-body leading-snug">
                                The goal was to help shoppers find products
                                without getting lost in the store. Using the
                                layout of the store where I work, I accurately
                                recreated its aisles and product areas.
                            </p>

                            <div
                                class="mt-12 overflow-hidden rounded-lg border border-frame-ring"
                            >
                                <Image
                                    src={MapPixcel}
                                    alt="Three stages of the store map SVG: the scanned floor plan, the floor plan traced over an 8 by 8 pixel grid, and the final clean vector map"
                                    class="w-full h-auto"
                                />
                            </div>

                            <p class="mt-8 max-w-2xl text-cs-body leading-snug">
                                To create a clean, structured SVG, I overlaid an
                                8 × 8 px grid on the original floor plan and
                                traced each section cell by cell.
                            </p>
                        </div>

                        <!-- Design to Dev -->
                        <div class="mt-28 max-w-240 mx-auto">
                            <p class="caption-pill">Design to Dev</p>
                            <div
                                class="mt-6 grid gap-8 md:grid-cols-[1fr_320px] md:items-center"
                            >
                                <div>
                                    <h3
                                        class="max-w-xl text-cs-h2 font-normal leading-tight"
                                    >
                                        Streamlining Interactive Map Development
                                        with AI
                                    </h3>
                                    <p
                                        class="mt-4 max-w-lg text-cs-body leading-snug"
                                    >
                                        To make the map interactive, each area
                                        needed to be accurately connected to its
                                        product data. I introduced an
                                        AI-assisted workflow to streamline this
                                        repetitive process.
                                    </p>
                                </div>
                                <Image
                                    src={FigmaMcp}
                                    alt="Figma and Claude icons connected through MCP"
                                    class="w-full"
                                />
                            </div>
                        </div>

                        <!-- Challenge -->
                        <div class="mt-28">
                            <div
                                class="mt-6 grid gap-8 md:grid-cols-2 md:items-center md:-mr-8"
                            >
                                <div
                                    class="max-w-240 mx-auto md:mx-0 md:max-w-lg md:pl-[max(1rem,calc((100%-60rem)/2))]"
                                >
                                    <div class="max-w-240 mx-auto">
                                        <p class="caption-pill">Challenge</p>
                                    </div>
                                    <h2 class="text-cs-h2 leading-snug">
                                        Managing Hundreds of Cells Accurately
                                    </h2>
                                    <p class="mt-4 text-cs-body leading-snug">
                                        Connecting products to their locations
                                        required a unique ID for every map
                                        element. Naming hundreds of elements
                                        manually would have been time-consuming
                                        and prone to errors or duplicates.
                                    </p>
                                </div>
                                <Image
                                    src={MapOnFigma}
                                    alt="Figma layers panel listing dozens of individually named produce section layers"
                                    class="w-full"
                                />
                            </div>
                        </div>

                        <!-- Solution -->
                        <div class="mt-28">
                            <div
                                class="mt-6 grid gap-8 md:grid-cols-2 md:items-center md:-mr-8"
                            >
                                <div
                                    class="max-w-240 mx-auto md:mx-0 md:max-w-lg md:pl-[max(1rem,calc((100%-60rem)/2))]"
                                >
                                    <div class="max-w-240 mx-auto">
                                        <p class="caption-pill">Solution</p>
                                    </div>
                                    <h2 class="text-cs-h2 leading-snug">
                                        Automating the Naming Process with Figma
                                        MCP and Claude
                                    </h2>
                                    <p class="mt-4 text-cs-body leading-snug">
                                        I created a naming convention based on
                                        product category and location, then used
                                        Claude through Figma MCP to apply it to
                                        each layer. The layer names could then
                                        be used directly as SVG IDs, creating a
                                        smoother handoff to development.
                                    </p>
                                </div>
                                <Image
                                    src={SvgCode}
                                    alt="Code editor showing SVG rectangles with produce ID attributes and fill colors"
                                    class="w-full"
                                />
                            </div>
                        </div>

                        <!-- Outcome -->
                        <div class="mt-28 max-w-240 mx-auto">
                            <p class="caption-pill">Outcome</p>
                            <h2 class="mt-4 text-cs-h2 leading-snug">
                                Reduced Development Time and Improved
                                Implementation Accuracy
                            </h2>
                            <p class="mt-4 max-w-2xl text-cs-body leading-snug">
                                The workflow reduced repetitive work and
                                improved naming accuracy. It also made the
                                transition from Figma to development more
                                efficient.
                            </p>
                        </div>
                    </section>
                </div>
            </div>
        </section>
    </main>
</Layout>
