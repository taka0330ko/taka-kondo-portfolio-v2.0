<script>
    // These images sit inside a sidebar-offset, centered .container, so a
    // static CSS calc() can't reach the true viewport edge at every screen
    // size. Instead we measure each element's live position and stretch its
    // width to close the remaining gap, which also lets it grow bigger on
    // wide monitors instead of stopping at a fixed max-width.
    function bleedToViewportEdge() {
        if (window.location.pathname.replace(/\/$/, "") !== "/store-map")
            return;

        document
            .querySelectorAll<HTMLElement>(".js-bleed-right")
            .forEach((el) => {
                // Reset first so the measurement below reflects the natural
                // CSS-flow position, not a leftover value from a previous run.
                el.style.marginLeft = "";
                el.style.width = "";
                el.style.maxWidth = "";

                const rect = el.getBoundingClientRect();
                const isStacked =
                    window.matchMedia("(max-width: 767px)").matches;
                // clientWidth (not window.innerWidth) excludes the scrollbar,
                // matching the coordinate system getBoundingClientRect() uses.
                // Using innerWidth here would overshoot by the scrollbar's
                // width and force a horizontal scrollbar of its own.
                const viewportWidth = document.documentElement.clientWidth;

                if (isStacked) {
                    // Below md the grid stacks into one column, so bleed on
                    // both sides: pull the left edge to 0, then widen to fill.
                    el.style.marginLeft = `${-rect.left}px`;
                    el.style.width = `${viewportWidth}px`;
                } else {
                    // Keep the left edge where the grid places it; only grow
                    // the width so the right edge lands exactly on-screen.
                    el.style.width = `${viewportWidth - rect.left}px`;
                }
                el.style.maxWidth = "none";
            });
    }

    document.addEventListener("astro:page-load", bleedToViewportEdge);
    window.addEventListener("resize", bleedToViewportEdge);
</script>
