---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogPage from "../../components/features/BlogPage.astro";
import { blogJa } from "../../content/ja/blog";

const entries = await getCollection(
  "blog",
  ({ data }) => data.locale === "ja" && (import.meta.env.PROD ? !data.draft : true),
);
entries.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const posts = entries.map((entry) => ({
  transitionKey: entry.id.replace(/^ja\//, "").replace(/[^a-zA-Z0-9_-]/g, "-"),
  href: `/jp/blog/${entry.id.replace(/^ja\//, "")}`,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.publishedAt.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" }),
  cover: entry.data.cover,
  coverAlt: entry.data.coverAlt,
  coverVideo: entry.data.coverVideo,
  coverVideoFallback: entry.data.coverVideoFallback,
}));
---

<Layout title={blogJa.meta.title} description={blogJa.meta.description}>
    <BlogPage content={blogJa} posts={posts} />
</Layout>
