---
import Layout from "../../layouts/Layout.astro";
import HeroVideo from "../../components/features/HeroVideo.astro";
import RippleEffectLogo from "../../components/webGL/RippleEffectLogo";
import CopyEmail from "../../components/ui/CopyEmail.astro";
import MainProjectCard from "../../components/ui/MainProjectCard.astro";
import IconHover from "../../components/ui/IconHover.astro";
import { projects } from "../../data/projects";
import { GithubIcon, LinkedinIcon } from "../../data/icons";
import { Mail } from "@lucide/astro";
import { homeJa } from "../../content/ja/home";

// ここが言語切り替えの中心です。
// JavaScriptのスプレッド構文は、後から指定された値で同名プロパティを上書きします。
const localizedProjects = projects.map((project) => ({
  ...project,
  ...homeJa.projects[project.slug],
  href: project.slug === "store-map"
    ? "/jp/store-map"
    : project.slug === "ukg"
      ? "/jp/ukg"
      : project.slug === "billow"
        ? "/jp/billow"
        : project.slug === "tastebuds"
          ? "/jp/tastebuds"
          : project.href,
}));
---

<Layout
  title={homeJa.meta.title}
  description={homeJa.meta.description}
>
  <main>
    <HeroVideo title={homeJa.meta.title} description={homeJa.meta.description} lang="ja" />

    <section id="projects" class="mx-auto max-w-350 px-4 pt-8 md:px-8 md:pt-16">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-5 md:mb-16">
        <h2 class="font-heading text-[clamp(3.5rem,10.5vw,10rem)] font-light leading-[0.95] tracking-[-0.055em] text-foreground/40" lang="en">Selected Projects</h2>
        <p class="ml-auto pb-1 text-right font-heading text-xs font-medium leading-tight tracking-[0.08em] text-foreground/40 md:text-sm" lang="en">
          DISCOVER<br />LEARN<br />REFINE
        </p>
      </div>
      <div class="grid gap-24">
        {localizedProjects.map((project) => (
          <MainProjectCard
            href={project.href}
            cover={project.cover}
            coverVideo={project.coverVideo}
            coverVideoFallback={project.coverVideoFallback}
            title={project.title}
            description={project.description}
            summaryList={project.summaryList}
            tag={project.tag}
            isReady={project.isReady}
            readMoreLabel={homeJa.projectCard.readMore}
            comingSoonLabel={homeJa.projectCard.comingSoon}
          />
        ))}
      </div>
    </section>

    <section class="my-40 flex flex-col items-center justify-center">
      <CopyEmail copiedLabel={homeJa.contact.copiedLabel} />
      <div class="icons mt-4 flex items-center gap-10">
        <IconHover
          href="https://github.com/taka0330ko"
          aria-label="GitHub profile"
          label="GitHub"
        >
          <GithubIcon />
        </IconHover>

        <IconHover
          href="https://www.linkedin.com/in/takanarikondo/"
          aria-label="LinkedIn profile"
          label="LinkedIn"
        >
          <LinkedinIcon />
        </IconHover>

        <IconHover
          href="mailto:gtakanari0330@gmail.com"
          aria-label={homeJa.contact.emailAriaLabel}
          label="Email"
        >
          <Mail />
        </IconHover>
      </div>
      <div class="mt-16 flex w-full justify-center">
        <RippleEffectLogo client:visible />
      </div>
    </section>
  </main>
</Layout>
